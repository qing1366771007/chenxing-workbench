let reciteCurrentIdx = -1;
let reciteCurrentCat = '全部';
let reciteReciting = false;
let reciteBlobUrl = null;
let reciteStarting = false;

function initRecite() {
  reciteCurrentIdx = -1;
  document.getElementById('reciteDetail').style.display = 'none';
  document.getElementById('reciteList').style.display = 'grid';
  renderReciteCatBar();
  renderReciteList();
}

function renderReciteCatBar() {
  var bar = document.getElementById('reciteCatBar');
  if (!bar) return;
  var cats = ['全部'];
  reciteData.forEach(function(item) {
    if (item.cat && cats.indexOf(item.cat) === -1) cats.push(item.cat);
  });
  var html = '';
  cats.forEach(function(cat) {
    html += '<div class="recite-cat-btn ' + (reciteCurrentCat === cat ? 'active' : '') + '" onclick="setReciteCat(\'' + cat + '\')">' + cat + '</div>';
  });
  bar.innerHTML = html;
}

function setReciteCat(cat) {
  reciteCurrentCat = cat;
  renderReciteCatBar();
  renderReciteList();
}

function renderReciteList() {
  var list = document.getElementById('reciteList');
  if (!list) return;
  var html = '';
  reciteData.forEach(function(item, idx) {
    if (reciteCurrentCat !== '全部' && item.cat !== reciteCurrentCat) return;
    html += '<div class="recite-card" onclick="showRecite(' + idx + ')">' +
      '<div class="rc-icon">' + item.icon + '</div>' +
      '<div class="rc-title">' + item.title + '</div>' +
      '<div class="rc-type">' + item.type + '</div>' +
      '</div>';
  });
  list.innerHTML = html;
}

function showRecite(idx) {
  reciteCurrentIdx = idx;
  var item = reciteData[idx];
  document.getElementById('reciteList').style.display = 'none';
  var detail = document.getElementById('reciteDetail');
  detail.style.display = 'block';
  document.getElementById('reciteTitle').textContent = item.title;
  document.getElementById('reciteAuthor').textContent = item.author + ' · ' + item.type;
  document.getElementById('reciteIntro').textContent = item.intro;
  document.getElementById('reciteMiniTitle').textContent = item.cat + ' · ' + item.type;

  // 渲染内容
  var html = '';
  item.stanzas.forEach(function(stanza, si) {
    html += '<div class="recite-stanza">';
    stanza.forEach(function(line) {
      html += '<span class="recite-line">' + line + '</span>';
    });
    html += '</div>';
  });
  document.getElementById('reciteText').innerHTML = html;

  // 重置按钮和提示
  var btn = document.getElementById('reciteReadBtn');
  var hint = document.getElementById('reciteHint');
  btn.textContent = '⏳ 正在准备朗诵…';
  btn.classList.add('reciting');
  if (hint) hint.classList.add('hidden');
  reciteReciting = false;
  reciteStarting = true;

  // 更新导航按钮状态
  reciteUpdateNav();

  // 自动朗诵：在用户点击卡片的同一手势中解锁audio元素
  var player = _getTTSPlayer();
  if (player) {
    // 先用一个空src同步play()解锁audio元素（保持用户手势链）
    try {
      player.src = '';
      var unlockP = player.play();
      if (unlockP && unlockP.catch) {
        unlockP.catch(function() {});
      }
      player.pause();
    } catch(e) {}
  }

  // 稍延迟后开始朗诵（等DOM渲染完成，且未被用户取消）
  setTimeout(function() {
    if (!reciteStarting) return; // 用户已取消
    reciteStarting = false;
    readRecite();
  }, 100);
}

function getFilteredIndices() {
  var indices = [];
  reciteData.forEach(function(item, idx) {
    if (reciteCurrentCat === '全部' || item.cat === reciteCurrentCat) {
      indices.push(idx);
    }
  });
  return indices;
}

function reciteUpdateNav() {
  var filtered = getFilteredIndices();
  var pos = filtered.indexOf(reciteCurrentIdx);
  var prevBtn = document.getElementById('recitePrevBtn');
  var nextBtn = document.getElementById('reciteNextBtn');
  var info = document.getElementById('recitePageInfo');

  prevBtn.disabled = (pos <= 0);
  nextBtn.disabled = (pos >= filtered.length - 1 || filtered.length <= 1);
  info.textContent = '第 ' + (pos + 1) + ' / ' + filtered.length + ' 篇 · ' + reciteData[reciteCurrentIdx].title;
}

function reciteGoNext() {
  var filtered = getFilteredIndices();
  var pos = filtered.indexOf(reciteCurrentIdx);
  if (pos < filtered.length - 1) {
    hideTTSPlayer();
    showRecite(filtered[pos + 1]);
  }
}

function reciteGoPrev() {
  var filtered = getFilteredIndices();
  var pos = filtered.indexOf(reciteCurrentIdx);
  if (pos > 0) {
    hideTTSPlayer();
    showRecite(filtered[pos - 1]);
  }
}

function readRecite() {
  if (reciteCurrentIdx < 0) return;
  var item = reciteData[reciteCurrentIdx];

  // 题目+作者作为第一段朗诵
  var titleText = item.title + '，作者' + item.author + '。';

  // 把全文按段落拆分成不超过100字的片段
  var chunks = [titleText];
  item.stanzas.forEach(function(stanza) {
    var seg = stanza.join('');
    if (seg.length > 100) {
      var parts = seg.split(/([。？！；])/);
      var cur = '';
      for (var i = 0; i < parts.length; i++) {
        var part = parts[i];
        if (part === '') continue;
        var segment = part;
        if (i + 1 < parts.length && /[。？！；]/.test(parts[i + 1])) {
          segment = part + parts[i + 1];
          i++;
        }
        if ((cur + segment).length > 100) {
          if (cur) chunks.push(cur);
          cur = segment;
        } else {
          cur += segment;
        }
      }
      if (cur) chunks.push(cur);
    } else {
      chunks.push(seg);
    }
  });

  if (chunks.length === 0) return;

  var player = _getTTSPlayer();
  var bar = _getTTSBar();
  var label = _getTTSLabel();
  if (!player || !bar) {
    if ('speechSynthesis' in window) {
      var u = new SpeechSynthesisUtterance(chunks.join(''));
      u.lang = 'zh-CN';
      u.rate = 0.9;
      speechSynthesis.speak(u);
    }
    return;
  }

  var btn = document.getElementById('reciteReadBtn');
  var hint = document.getElementById('reciteHint');
  // 如果正在朗诵或正在准备中，点击则停止
  if (reciteReciting) {
    reciteReciting = false;
    reciteStarting = false;
    player.onended = null;
    player.onerror = null;
    player.pause();
    player.src = '';
    if (reciteBlobUrl) { URL.revokeObjectURL(reciteBlobUrl); reciteBlobUrl = null; }
    btn.textContent = '🔊 点击听朗诵';
    btn.classList.remove('reciting');
    bar.classList.remove('show');
    if (hint) hint.classList.remove('hidden');
    return;
  }
  // 如果正在准备中（showRecite刚触发），点击则取消自动朗诵
  if (reciteStarting) {
    reciteStarting = false;
    btn.textContent = '🔊 点击听朗诵';
    btn.classList.remove('reciting');
    if (hint) hint.classList.remove('hidden');
    return;
  }

  reciteReciting = true;
  btn.textContent = '⏹ 停止朗诵';
  btn.classList.add('reciting');
  if (hint) hint.classList.add('hidden');

  // 按内容类型选择有感情的微软神经语音
  var voiceCfg;
  if (item.cat === '诗歌散文') {
    // 诗歌散文：晓晓(温柔) + 抒情诗意风格 + 慢速
    voiceCfg = { voice: 'zh-CN-XiaoxiaoNeural', style: 'lyrical', speed: 0.85 };
  } else if (item.cat === '推荐阅读') {
    // 绘本故事：晓伊(甜美) + 亲切温暖风格 + 适中
    voiceCfg = { voice: 'zh-CN-XiaoyiNeural', style: 'affectionate', speed: 0.9 };
  } else {
    // 科普百科：晓辰(知性) + 愉快风格 + 稍快
    voiceCfg = { voice: 'zh-CN-XiaochenNeural', style: 'cheerful', speed: 0.95 };
  }

  // 百度TTS URL（降速更有感情）
  function getBaiduUrl(text) {
    return 'https://fanyi.baidu.com/gettts?lan=zh' +
      '&text=' + encodeURIComponent(text) + '&spd=2&source=web';
  }
  // 有道TTS URL
  function getYoudaoUrl(text) {
    return 'https://dict.youdao.com/dictvoice?audio=' +
      encodeURIComponent(text) + '&type=2';
  }

  // 清理blob URL
  function cleanupBlob() {
    if (reciteBlobUrl) {
      try { URL.revokeObjectURL(reciteBlobUrl); } catch(e) {}
      reciteBlobUrl = null;
    }
  }

  function playChunk(idx) {
    if (!reciteReciting || idx >= chunks.length) {
      reciteReciting = false;
      btn.textContent = '🔊 点击听朗诵';
      btn.classList.remove('reciting');
      if (hint) hint.classList.remove('hidden');
      setTimeout(function() { bar.classList.remove('show'); }, 500);
      return;
    }

    var text = chunks[idx];
    if (label) label.textContent = text.length > 12 ? text.substring(0, 12) + '...' : text;
    bar.classList.add('show');
    cleanupBlob();

    // 优先用Edge TTS（有感情的微软神经语音）
    fetch('https://tts.wangwangit.com/v1/audio/speech', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        input: text,
        voice: voiceCfg.voice,
        speed: voiceCfg.speed,
        style: voiceCfg.style
      })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('TTS API error: ' + res.status);
      return res.blob();
    })
    .then(function(blob) {
      if (!reciteReciting) return;
      var blobUrl = URL.createObjectURL(blob);
      reciteBlobUrl = blobUrl;
      playUrl(idx, blobUrl, text, true, 0);
    })
    .catch(function() {
      if (!reciteReciting) return;
      // Edge TTS失败，降级到百度TTS
      playUrl(idx, getBaiduUrl(text), text, false, 1);
    });
  }

  // 用URL播放音频（blob URL或直链），失败时按链降级
  function playUrl(idx, url, text, isBlob, fallbackIdx) {
    if (!reciteReciting) {
      if (isBlob) cleanupBlob();
      return;
    }

    player.onended = null;
    player.onerror = null;
    player.src = url;
    player.load();

    var done = false;

    player.onended = function() {
      if (done) return;
      done = true;
      player.onended = null;
      player.onerror = null;
      if (isBlob) cleanupBlob();
      setTimeout(function() { playChunk(idx + 1); }, 400);
    };

    player.onerror = function() {
      if (done) return;
      done = true;
      player.onended = null;
      player.onerror = null;
      if (isBlob) cleanupBlob();
      nextFallback(idx, text, fallbackIdx);
    };

    var p = player.play();
    if (p && p.catch) {
      p.catch(function() {
        if (done) return;
        done = true;
        player.onended = null;
        player.onerror = null;
        if (isBlob) cleanupBlob();
        nextFallback(idx, text, fallbackIdx);
      });
    }
  }

  // 降级链：0=Edge TTS, 1=百度, 2=有道, 3=跳过
  function nextFallback(idx, text, fallbackIdx) {
    if (!reciteReciting) return;
    if (fallbackIdx === 1) {
      // 百度失败 -> 有道
      playUrl(idx, getYoudaoUrl(text), text, false, 2);
    } else if (fallbackIdx === 2) {
      // 有道也失败 -> 跳过这段
      setTimeout(function() { playChunk(idx + 1); }, 200);
    } else {
      // Edge TTS直接失败 -> 百度
      playUrl(idx, getBaiduUrl(text), text, false, 1);
    }
  }

  playChunk(0);
}

function reciteBack() {
  hideTTSPlayer();
  reciteReciting = false;
  reciteStarting = false;
  document.getElementById('reciteDetail').style.display = 'none';
  document.getElementById('reciteList').style.display = 'grid';
  reciteCurrentIdx = -1;
}

