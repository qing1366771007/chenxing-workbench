function newReadNumProblem() {
  document.getElementById('readNumFeedback').textContent = '';
  document.getElementById('readNumFeedback').className = 'readnum-feedback';
  // 生成随机数
  var min = Math.pow(10, readNumLevel - 1);
  var max = Math.pow(10, readNumLevel) - 1;
  if (readNumLevel === 1) min = 0;
  var num = Math.floor(Math.random() * (max - min + 1)) + min;
  readNumCurrent = { num:num, chinese:numToChinese(num) };
  // 显示数字
  document.getElementById('readNumDisplay').textContent = num;
  // 显示数位分解
  var s = num.toString();
  var row = document.getElementById('readNumPlaceRow');
  row.innerHTML = '';
  var placeNames = ['个','十','百','千','万'];
  var placeColors = ['#74b9ff','#55efc4','#fdcb6e','#fd79a8','#a29bfe'];
  // 从高位到低位显示
  for (var i = 0; i < s.length; i++) {
    var p = s.length - 1 - i; // 位数索引
    var cell = document.createElement('div');
    cell.className = 'readnum-place-cell';
    cell.style.borderColor = placeColors[p];
    cell.innerHTML =
      '<div class="readnum-place-digit">' + s[i] + '</div>' +
      '<div class="readnum-place-label" style="color:' + placeColors[p] + ';">' + placeNames[p] + '位</div>';
    row.appendChild(cell);
  }
  // 生成4个选项（1个正确 + 3个干扰）
  var opts = [readNumCurrent.chinese];
  while (opts.length < 4) {
    // 生成一个错误读法
    var wrongNum = Math.floor(Math.random() * (max - min + 1)) + min;
    var wrongChinese = numToChinese(wrongNum);
    if (opts.indexOf(wrongChinese) === -1 && wrongChinese !== readNumCurrent.chinese) {
      opts.push(wrongChinese);
    }
  }
  // 打乱选项
  for (var j = opts.length - 1; j > 0; j--) {
    var k = Math.floor(Math.random() * (j + 1));
    var tmp = opts[j]; opts[j] = opts[k]; opts[k] = tmp;
  }
  var optBox = document.getElementById('readNumOptions');
  optBox.innerHTML = '';
  opts.forEach(function(opt) {
    var btn = document.createElement('div');
    btn.className = 'readnum-opt';
    btn.textContent = opt;
    btn.onclick = function() { checkReadNumAnswer(opt, this); };
    optBox.appendChild(btn);
  });
}

