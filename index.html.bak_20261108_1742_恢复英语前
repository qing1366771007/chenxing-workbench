// —— 9. 数学思维（应用题） ——
function smartGenMathThinking(diff) {
  var maxN = Math.min(3 + diff * 2, 20);
  var templates = [
    function() {
      var a = smartRandInt(3, maxN), b = smartRandInt(1, a - 1);
      return { q: '盘子里有' + a + '个苹果，吃了' + b + '个，还剩几个？', ans: a - b, _qid: 'math_apple_sub_' + a + '_' + b };
    },
    function() {
      var a = smartRandInt(2, maxN - 2), b = smartRandInt(1, maxN - a);
      return { q: '小明有' + a + '支铅笔，妈妈又给了' + b + '支，一共几支？', ans: a + b, _qid: 'math_pencil_add_' + a + '_' + b };
    },
    function() {
      var a = smartRandInt(4, maxN), b = smartRandInt(1, a - 2);
      return { q: '树上有' + a + '只小鸟，飞走了' + b + '只，还剩几只？', ans: a - b, _qid: 'math_bird_sub_' + a + '_' + b };
    },
    function() {
      var a = smartRandInt(2, Math.floor(maxN / 2));
      return { q: '一双手有5根手指，' + a + '双手有几根手指？', ans: a * 5, _qid: 'math_finger_mul_' + a };
    },
    function() {
      var a = smartRandInt(3, maxN);
      return { q: '一个星期有7天，' + a + '天是几个星期多几天？（算总天数）', ans: a, _qid: 'math_week_day_' + a };
    },
  ];
  var tIdx = smartRandInt(0, Math.min(templates.length - 1, Math.floor(diff / 2)));
  var r = templates[tIdx]();
  // 生成选项
  var opts = [r.ans + '个'];
  var used = {}; used[r.ans] = true;
  while (opts.length < 3) {
    var delta = smartRandInt(-3, 3);
    var val = r.ans + delta;
    if (val <= 0 || used[val] || delta === 0) continue;
    used[val] = true;
    opts.push(val + '个');
  }
  opts = smartShuffle(opts);
  return { type: '数学思维', q: r.q, opts: opts, ans: opts.indexOf(r.ans + '个'), _qid: r._qid };
}

