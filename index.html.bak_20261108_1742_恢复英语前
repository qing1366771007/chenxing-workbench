var emoMode = 'list';
var emoQuizQuestions = [];
var emoQuizCurrent = 0;
var emoQuizScore = 0;

function setEmoMode(mode) {
  emoMode = mode;
  document.getElementById('emoModeList').className = 'anti-game-mode-btn' + (mode === 'list' ? ' active' : '');
  document.getElementById('emoModeQuiz').className = 'anti-game-mode-btn' + (mode === 'quiz' ? ' active' : '');
  document.getElementById('emoCatBar').style.display = mode === 'list' ? 'flex' : 'none';
  document.getElementById('emoList').style.display = mode === 'list' ? 'grid' : 'none';
  document.getElementById('emoQuizArea').style.display = mode === 'quiz' ? 'block' : 'none';
  document.getElementById('emoQuizInfo').style.display = mode === 'quiz' ? 'flex' : 'none';
  if (mode === 'quiz') {
    startEmoQuiz();
  }
}

function startEmoQuiz() {
  // 收集所有情绪词
  var allWords = [];
  var showAll = (emoCurrentCat === '全部');
  emoData.forEach(function(item) {
    if (!showAll && item.cat !== emoCurrentCat) return;
    var ws = item.words.split(/[、，]/);
    ws.forEach(function(w) {
      if (w.trim()) allWords.push(w.trim());
    });
  });

  // 生成题目：从所有词中选5个作为正确答案，每个配干扰项
  var count = Math.min(5, allWords.length);
  var shuffled = allWords.slice().sort(function() { return Math.random() - 0.5; });
  emoQuizQuestions = [];

  for (var i = 0; i < count; i++) {
    var correctWord = shuffled[i];
    // 找3个干扰项
    var distractors = [];
    var pool = allWords.filter(function(w) { return w !== correctWord; });
    pool.sort(function() { return Math.random() - 0.5; });
    distractors = pool.slice(0, 3);

    // 生成句子：用一个情绪词的例句
    var sentence = '';
    var found = false;
    for (var j = 0; j < emoData.length; j++) {
      if (emoData[j].words.indexOf(correctWord) !== -1) {
        sentence = emoData[j].example;
        found = true;
        break;
      }
    }
    if (!found) {
      sentence = '他心里充满了______的感觉。';
    }

    // 把句子里的情绪词替换成______
    var qSentence = sentence;
    if (qSentence.indexOf(correctWord) !== -1) {
      qSentence = qSentence.replace(correctWord, '______');
    } else {
      // 如果例句里没有这个词，就用通用句式
      qSentence = '她感到非常______。';
    }

    // 选项打乱
    var options = [correctWord].concat(distractors).sort(function() { return Math.random() - 0.5; });

    emoQuizQuestions.push({
      sentence: qSentence,
      correct: correctWord,
      options: options
    });
  }

  emoQuizCurrent = 0;
  emoQuizScore = 0;
  document.getElementById('emoQuizScore').textContent = '0';
  document.getElementById('emoQuizTotal').textContent = count;
  renderEmoQuiz();
}

function renderEmoQuiz() {
  var area = document.getElementById('emoQuizArea');
  if (!area) return;

  if (emoQuizCurrent >= emoQuizQuestions.length) {
    // 做完了
    area.innerHTML = '<div class="anti-game-result">' +
      '🎉 练习完成！<br>' +
      '答对了 ' + emoQuizScore + ' / ' + emoQuizQuestions.length + ' 题<br>' +
      '<button onclick="startEmoQuiz()">🔄 再来一组</button>' +
      '</div>';
    speakZh('练习完成！你答对了' + emoQuizScore + '道题。');
    return;
  }

  var q = emoQuizQuestions[emoQuizCurrent];
  var html = '';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">';
  html += '<div style="font-size:13px;color:#999;">第 ' + (emoQuizCurrent + 1) + ' 题 / 共 ' + emoQuizQuestions.length + ' 题</div>';
  html += '<button onclick="startEmoQuiz()" style="padding:5px 12px;border:none;border-radius:12px;background:#ffe5e5;color:#ff7675;font-size:12px;font-weight:600;cursor:pointer;">🔄 换一组</button>';
  html += '</div>';
  html += '<div style="background:#fff;border-radius:14px;padding:18px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,0.06);border:1px solid #ffe5e5;">';
  html += '<div style="font-size:17px;font-weight:600;color:#2d3436;line-height:1.6;margin-bottom:16px;">' + q.sentence + '</div>';
  html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">';
  q.options.forEach(function(opt, idx) {
    html += '<div class="emo-quiz-opt" onclick="checkEmoAnswer(\'' + opt.replace(/'/g, "\\'") + '\', this)" style="padding:12px;border-radius:10px;background:#fff5f5;border:2px solid #ffd5d5;font-size:15px;font-weight:600;color:#ff7675;text-align:center;cursor:pointer;transition:all .15s;">' + opt + '</div>';
  });
  html += '</div>';
  html += '<div id="emoQuizFeedback" style="margin-top:14px;font-size:14px;font-weight:600;text-align:center;min-height:20px;"></div>';
  html += '<button id="emoQuizNextBtn" style="display:none;margin-top:12px;width:100%;padding:10px;border:none;border-radius:10px;background:#ff7675;color:#fff;font-size:15px;font-weight:700;cursor:pointer;" onclick="nextEmoQuiz()">下一题 ➡️</button>';
  html += '</div>';

  area.innerHTML = html;
}

var emoQuizAnswered = false;
function checkEmoAnswer(answer, el) {
  if (emoQuizAnswered) return;
  emoQuizAnswered = true;

  var q = emoQuizQuestions[emoQuizCurrent];
  var fb = document.getElementById('emoQuizFeedback');
  var opts = document.querySelectorAll('.emo-quiz-opt');

  if (answer === q.correct) {
    emoQuizScore++;
    document.getElementById('emoQuizScore').textContent = emoQuizScore;
    el.style.background = '#55efc4';
    el.style.borderColor = '#00b894';
    el.style.color = '#00875a';
    fb.textContent = '✅ 答对了！';
    fb.style.color = '#00b894';
    speakZh('答对了！' + q.correct);
  } else {
    el.style.background = '#fab1a0';
    el.style.borderColor = '#e17055';
    el.style.color = '#d63031';
    // 标出正确答案
    for (var i = 0; i < opts.length; i++) {
