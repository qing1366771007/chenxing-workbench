function _genMathProblems(cfg) {
  var problems = [];
  var n1Min = cfg.n1Range.min, n1Max = cfg.n1Range.max;
  var n2Min = cfg.n2Range.min, n2Max = cfg.n2Range.max;
  var aMin = cfg.ansRange ? cfg.ansRange.min : null;
  var aMax = cfg.ansRange ? cfg.ansRange.max : null;
  var numCount = cfg.numCount || 2;

  for (var i = 0; i < cfg.count; i++) {
    var type;
    if (cfg.types.length === 1 && cfg.types[0] === 'mix') {
      type = Math.random() > 0.5 ? '+' : '-';
    } else if (cfg.types.length === 1) {
      type = cfg.types[0];
    } else {
      type = cfg.types[Math.floor(Math.random() * cfg.types.length)];
      if (type === 'mix') type = Math.random() > 0.5 ? '+' : '-';
    }

    var attempts = 0;
    var valid = false;

    if (numCount === 3) {
      // Three-number problems: a op1 b op2 c = ans
      var n3Min = cfg.n3Range ? cfg.n3Range.min : n2Min;
      var n3Max = cfg.n3Range ? cfg.n3Range.max : n2Max;
      var a, b, c, ans, op1, op2;
      while (attempts < 50 && !valid) {
        attempts++;
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;
        c = Math.floor(Math.random() * (n3Max - n3Min + 1)) + n3Min;
        op1 = type === '+' ? '+' : (type === '-' ? '-' : (Math.random() > 0.5 ? '+' : '-'));
        op2 = type === '+' ? '+' : (type === '-' ? '-' : (Math.random() > 0.5 ? '+' : '-'));

        var step1 = op1 === '+' ? a + b : a - b;
        if (step1 < 0) continue;
        ans = op2 === '+' ? step1 + c : step1 - c;
        if (ans < 0) continue;

        if (aMin !== null && ans < aMin) continue;
        if (aMax !== null && ans > aMax) continue;
        valid = true;
      }
      if (!valid) {
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;
        c = Math.floor(Math.random() * (n3Max - n3Min + 1)) + n3Min;
        op1 = '+'; op2 = '-';
        ans = a + b - c;
        if (ans < 0) { ans = a - b + c; op1 = '-'; op2 = '+'; }
        if (ans < 0) { ans = a + b + c; op1 = '+'; op2 = '+'; }
      }
      var blank = cfg.blanks[Math.floor(Math.random() * cfg.blanks.length)];
      problems.push({ a: a, b: b, c: c, op1: op1, op2: op2, ans: ans, blank: blank, numCount: 3 });
    } else {
      // Two-number problems (original)
      var a, b, ans;
      while (attempts < 50 && !valid) {
        attempts++;
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;

        if (type === '+') {
          ans = a + b;
        } else {
          if (a < b) { var tmp = a; a = b; b = tmp; }
          ans = a - b;
        }
        if (aMin !== null && ans < aMin) continue;
        if (aMax !== null && ans > aMax) continue;
        valid = true;
      }
      if (!valid) {
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;
        if (type === '-') { if (a < b) { var t2 = a; a = b; b = t2; } }
        ans = type === '+' ? a + b : a - b;
      }
      var blank = cfg.blanks[Math.floor(Math.random() * cfg.blanks.length)];
      problems.push({ a: a, b: b, op: type, ans: ans, blank: blank, numCount: 2 });
    }
  }
  return problems;
}
function _formatProblem(p, showAnswer) {
  // 乘法/除法题目
  if (p.isMulDiv) {
    var aStr, bStr, ansStr;
    if (showAnswer) {
      return p.a + ' ' + p.op + ' ' + p.b + ' = ' + p.ans;
    }
    if (p.blank === 'a') {
