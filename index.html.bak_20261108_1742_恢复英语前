let hzCurrentCat = '数字';
let hzCurrentChar = null;
function initHanzi() {
  const tabs = document.getElementById('hzTabs');
  tabs.innerHTML = '';
  Object.keys(hanzhiCategories).forEach(cat => {
    const t = document.createElement('div');
    t.className = 'tab-item' + (cat === hzCurrentCat ? ' active' : '');
    t.textContent = cat;
    t.onclick = () => { hzCurrentCat = cat; initHanzi(); };
    tabs.appendChild(t);
  });
  const grid = document.getElementById('hzGrid');
  grid.innerHTML = '';
  hanzhiCategories[hzCurrentCat].forEach(item => {
    const d = document.createElement('div');
    d.className = 'hz-card';
    if (hzCurrentChar && hzCurrentChar.c === item.c) d.classList.add('selected');
    d.innerHTML = `<div class="hz-char">${item.c}</div><div class="hz-pinyin">${item.p}</div>`;
    d.onclick = () => showHanzi(item);
    grid.appendChild(d);
  });
}
function showHanzi(item) {
  hzCurrentChar = item;
  document.querySelectorAll('.hz-card').forEach(c => c.classList.remove('selected'));
  initHanzi();
  const detail = document.getElementById('hzDetail');
  detail.classList.add('show');
  document.getElementById('hzDetailChar').textContent = item.c;
  document.getElementById('hzDetailPinyin').textContent = item.p;
  document.getElementById('hzDetailMeaning').textContent = item.m;
  document.getElementById('hzDetailWords').textContent = item.w;
  document.getElementById('hzDetailSentence').textContent = item.s;
  initWriteCanvas('hzWriteCanvas', item.c, '#ede8f8');
  speakZh(item.c);
  // 去掉 scrollIntoView，避免在 App 全屏模式下页面整体上移
}
function speakHzCurrent() { if (hzCurrentChar) speakZh(hzCurrentChar.c); }

