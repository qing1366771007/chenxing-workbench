// 十字数独打印HTML生成
function _buildCrossSudokuHTML() {
  var diff = _getRadio('mpCrDiff', 'easy');
  var perPage = _getRadioInt('mpCrCount', 2);
  var pages = _getRadioInt('mpCrPages', 1);
  var showAnswer = document.getElementById('mpCrShowAnswer').checked;
  var showName = document.getElementById('mpCrShowName').checked;

  var holes = (diff === 'easy') ? 3 : 5;
  var total = perPage * pages;

  // 生成题目
  var puzzles = [];
  var solutions = [];
  for (var i = 0; i < total; i++) {
    // 生成完整十字数独（复用生成逻辑）
    var nums = [1,2,3,4,5];
    var hRow = nums.slice();
    for (var s = hRow.length - 1; s > 0; s--) {
      var jj = Math.floor(Math.random() * (s + 1));
      var tt = hRow[s]; hRow[s] = hRow[jj]; hRow[jj] = tt;
    }
    var centerVal = hRow[2];
    var vRest = [];
    for (var k = 0; k < nums.length; k++) {
      if (nums[k] !== centerVal) vRest.push(nums[k]);
    }
    for (var m = vRest.length - 1; m > 0; m--) {
      var n = Math.floor(Math.random() * (m + 1));
      var tv = vRest[m]; vRest[m] = vRest[n]; vRest[n] = tv;
    }
    var vCol = [vRest[0], vRest[1], centerVal, vRest[2], vRest[3]];
    solutions.push({h: hRow.slice(), v: vCol.slice()});

    // 挖空
    var puz = {h: hRow.slice(), v: vCol.slice()};
    var positions = [
      {type:'h', idx:0}, {type:'h', idx:1}, {type:'h', idx:2},
      {type:'h', idx:3}, {type:'h', idx:4},
      {type:'v', idx:0}, {type:'v', idx:1},
      {type:'v', idx:3}, {type:'v', idx:4}
    ];
    for (var pp = positions.length - 1; pp > 0; pp--) {
      var qq = Math.floor(Math.random() * (pp + 1));
      var tp = positions[pp]; positions[pp] = positions[qq]; positions[qq] = tp;
    }
    for (var hh = 0; hh < holes && hh < positions.length; hh++) {
      var pos = positions[hh];
      if (pos.type === 'h') puz.h[pos.idx] = 0;
      else puz.v[pos.idx] = 0;
    }
    puzzles.push(puz);
  }

  // 构建HTML
  // 辅助：渲染单个十字数独
  function renderCrossItem(idx, puz, showAns) {
    var h = '';
    h += '<div class="cross-item">';
    h += '<div class="cross-label">第 ' + (idx + 1) + ' 题</div>';
    h += '<div class="cr-grid">';
    for (var r = 0; r < 5; r++) {
      h += '<div class="cr-row">';
      if (r === 2) {
        for (var c = 0; c < 5; c++) {
          var val = showAns ? solutions[idx].h[c] : puz.h[c];
          h += '<div class="cr-cell">' + (val > 0 ? val : '') + '</div>';
        }
      } else {
        h += '<div class="cr-cell empty-cell"></div>';
        h += '<div class="cr-cell empty-cell"></div>';
        var vval = showAns ? solutions[idx].v[r] : puz.v[r];
        h += '<div class="cr-cell">' + (vval > 0 ? vval : '') + '</div>';
        h += '<div class="cr-cell empty-cell"></div>';
        h += '<div class="cr-cell empty-cell"></div>';
      }
      h += '</div>';
    }
    h += '</div></div>';
    return h;
  }

  // 辅助：渲染半页
  function renderHalf(start, count, pageNum, halfNum, showAns) {
    var h = '';
    h += '<div class="half half-' + (halfNum === 1 ? 'left' : 'right') + '">';
    h += '<div class="print-title">十字数独练习 — 第 ' + pageNum + ' 页-' + halfNum + '</div>';
    h += '<div class="print-sub">规则：横向和纵向的数字 1、2、3、4、5 都不能重复</div>';
    if (showName && !showAns) {
      h += '<div class="name-row"><span>姓名：__________</span><span>日期：__________</span><span>用时：__________</span></div>';
    }
    h += '<div class="cross-grid">';
    var endIdx = Math.min(start + count, puzzles.length);
    for (var i = start; i < endIdx; i++) {
      h += renderCrossItem(i, puzzles[i], showAns);
    }
    h += '</div></div>';
    return h;
