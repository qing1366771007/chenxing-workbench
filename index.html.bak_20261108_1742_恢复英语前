var unitCurrentCat = 'all';
var unitCurrentIdx = -1;

function initUnit() {
  renderUnitCatBar();
  renderUnitList();
}

function renderUnitCatBar() {
  var cats = [
    { id: 'all', name: '全部' },
    { id: 'length', name: '长度' },
    { id: 'weight', name: '重量' },
    { id: 'time', name: '时间' },
    { id: 'area', name: '面积' },
    { id: 'volume', name: '容积' },
    { id: 'money', name: '人民币' },
    { id: 'temp', name: '温度' },
    { id: 'speed', name: '速度' }
  ];
  var html = '';
  cats.forEach(function(c) {
    var cls = c.id === unitCurrentCat ? 'unit-cat-btn active' : 'unit-cat-btn';
    html += '<button class="' + cls + '" onclick="setUnitCat(\'' + c.id + '\')">' + c.name + '</button>';
  });
  document.getElementById('unitCatBar').innerHTML = html;
}

function setUnitCat(cat) {
  unitCurrentCat = cat;
  unitCurrentIdx = -1;
  renderUnitCatBar();
  renderUnitList();
  document.getElementById('unitDetail').style.display = 'none';
  document.getElementById('unitList').style.display = 'grid';
}

function renderUnitList() {
  var list = unitCurrentCat === 'all' ? unitData : unitData.filter(function(u) { return u.cat === unitCurrentCat; });
  var html = '';
  list.forEach(function(u) {
    var realIdx = unitData.indexOf(u);
    html += '<div class="unit-card" onclick="showUnit(' + realIdx + ')" style="border-top-color:#fd79a8">';
    html += '<div class="unit-icon">' + u.icon + '</div>';
    html += '<div class="unit-name">' + u.name + '</div>';
    html += '<div class="unit-hint">点击学习</div>';
    html += '</div>';
  });
  document.getElementById('unitList').innerHTML = html;
}

function showUnit(idx) {
  if (idx < 0 || idx >= unitData.length) return;
  unitCurrentIdx = idx;
  var u = unitData[idx];
  document.getElementById('unitIcon').textContent = u.icon;
  document.getElementById('unitName').textContent = u.name;
  document.getElementById('unitDesc').textContent = u.desc;

  var tbody = '';
  u.conversions.forEach(function(c, i) {
    tbody += '<tr class="unit-row" onclick="readUnitRow(' + i + ')"><td class="from">' + c.from + '</td><td class="equals">=</td><td class="to">' + c.to + '</td></tr>';
  });
  document.getElementById('unitTableBody').innerHTML = tbody;

  var tipSection = document.getElementById('unitTipSection');
  if (u.tip) {
    tipSection.style.display = 'block';
    document.getElementById('unitTip').innerHTML = u.tip;
  } else {
    tipSection.style.display = 'none';
  }

  document.getElementById('unitExamples').textContent = u.examples;

  document.getElementById('unitList').style.display = 'none';
  document.getElementById('unitDetail').style.display = 'block';
  document.getElementById('mainArea').scrollTop = 0;
}

function unitBack() {
  unitCurrentIdx = -1;
  document.getElementById('unitDetail').style.display = 'none';
  document.getElementById('unitList').style.display = 'grid';
}

function unitPrev() {
  var list = unitCurrentCat === 'all' ? unitData : unitData.filter(function(u) { return u.cat === unitCurrentCat; });
  var currentPos = list.indexOf(unitData[unitCurrentIdx]);
  if (currentPos <= 0) currentPos = list.length;
  var prevItem = list[currentPos - 1];
  showUnit(unitData.indexOf(prevItem));
}

function unitNext() {
  var list = unitCurrentCat === 'all' ? unitData : unitData.filter(function(u) { return u.cat === unitCurrentCat; });
  var currentPos = list.indexOf(unitData[unitCurrentIdx]);
  if (currentPos >= list.length - 1) currentPos = -1;
  var nextItem = list[currentPos + 1];
  showUnit(unitData.indexOf(nextItem));
}

function readUnitRow(i) {
  if (unitCurrentIdx < 0) return;
  var u = unitData[unitCurrentIdx];
  if (!u.conversions[i]) return;
  var c = u.conversions[i];
  speakZh(c.from + '等于' + c.to);
}

function readUnit() {
  if (unitCurrentIdx < 0) return;
  var u = unitData[unitCurrentIdx];
  var text = u.name + '。' + u.desc + '。换算关系：';
  u.conversions.forEach(function(c) {
    text += c.from + '等于' + c.to + '，';
  });
  if (u.tip) text += '小知识：' + u.tip + '。';
  text += '生活中的例子：' + u.examples + '。';
  speakZh(text);
}

