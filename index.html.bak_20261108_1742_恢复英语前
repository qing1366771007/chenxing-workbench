function newMathProblem() {
  const op = Math.random() > 0.5 ? '+' : '-';
  let a, b, ans;
  if (op === '+') {
    a = Math.floor(Math.random() * (mathMax - 1)) + 1;
    b = Math.floor(Math.random() * (Math.min(mathMax - a, mathMax - 1))) + 1;
    ans = a + b;
  } else {
    a = Math.floor(Math.random() * (mathMax - 1)) + 2;
    b = Math.floor(Math.random() * (a - 1)) + 1;
    ans = a - b;
  }
  mathCurrent = { a, b, op, ans };
  mathAnswer = '';
  document.getElementById('mathProblem').textContent = `${a} ${op} ${b} =`;
  document.getElementById('mathAnswer').textContent = '';
  document.getElementById('mathFeedback').textContent = '';
  document.getElementById('mathFeedback').className = 'math-feedback';
  speakQuestion(a + (op === '+' ? '加' : '减') + b + '等于几');
}
function mathInput(val) {
  if (val === 'del') { mathAnswer = mathAnswer.slice(0, -1); }
  else if (val === 'ok') { checkMath(); return; }
  else { if (mathAnswer.length < 3) mathAnswer += val; }
  document.getElementById('mathAnswer').textContent = mathAnswer;
}
function checkMath() {
  if (!mathCurrent || mathAnswer === '') return;
  const fb = document.getElementById('mathFeedback');
  if (parseInt(mathAnswer) === mathCurrent.ans) {
    fb.textContent = '✅ 太棒了！答对了！';
    fb.className = 'math-feedback correct';
    mathCorrectCount++; mathStarCount++;
    document.getElementById('mathCorrect').textContent = mathCorrectCount;
    document.getElementById('mathStars').textContent = mathStarCount;
    addStars(1);
    onCorrect('答对了！太棒了！');
    if (mathCorrectCount % 5 === 0) { setTimeout(() => showReward('连对5题！', '获得额外3颗星星'), 300); addStars(2); }
    setTimeout(() => newMathProblem(), 1400);
  } else {
    fb.textContent = `❌ 再想想~ 答案是 ${mathCurrent.ans}`;
    fb.className = 'math-feedback wrong';
    mathWrongCount++;
    document.getElementById('mathWrong').textContent = mathWrongCount;
    onWrong();
  }
}

