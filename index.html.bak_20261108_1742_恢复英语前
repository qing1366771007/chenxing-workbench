function thinkIsGroupDone(group) {
  return thinkGetDoneGroups().indexOf(group) >= 0;
}

// 生成每组简要描述
function thinkGetGroupDesc(group) {
  var start = thinkGetGroupStart(group);
  var end = thinkGetGroupEnd(group);
  var types = {};
  for (var i = start; i < end; i++) {
    var t = thinkExercises[i].type;
    types[t] = (types[t] || 0) + 1;
  }
  var parts = [];
  for (var t in types) {
    parts.push(t + (types[t] > 1 ? types[t] : ''));
  }
  return parts.join('·');
}

// 渲染组选择栏
function renderThinkGroupBar() {
  var bar = document.getElementById('thinkGroupBar');
  if (!bar) return;
  var currentGroup = thinkGetCurrentGroup();
  var html = '';
  for (var g = 0; g < THINK_TOTAL_GROUPS; g++) {
    var cls = 'think-group-btn';
    if (g === currentGroup) cls += ' current';
    if (thinkIsGroupDone(g)) cls += ' done';
    var desc = thinkGetGroupDesc(g);
    html += '<div class="' + cls + '" onclick="selectThinkGroup(' + g + ')">' +
      '<span class="tg-num">第' + (g + 1) + '组</span>' +
      '<span class="tg-desc">' + desc + '</span>' +
      '</div>';
  }
  bar.innerHTML = html;
}

// 选择某一组
function selectThinkGroup(group) {
  thinkIndex = thinkGetGroupStart(group);
  thinkSaveIndex();
  // 确保卡片显示、完成画面隐藏
  document.getElementById('thinkCard').style.display = '';
  document.getElementById('thinkGroupComplete').style.display = 'none';
  renderThinkGroupBar();
  renderThink();
}

function initThink() {
  // 读取模式设置
  var savedMode = localStorage.getItem('cx_thinkSmartMode');
  if (savedMode !== null) thinkSmartMode = savedMode === '1';

  if (thinkSmartMode) {
    // 智能模式初始化
    smartLoadState();
    thinkCurrentType = SMART_TYPES[0];
    thinkCurrentQ = smartGenQuestion(thinkCurrentType, thinkDifficulty);
    thinkQStreak = 0;
    thinkSessionCorrect = 0;
    thinkSessionTotal = 0;
    // 更新模式按钮状态
    document.getElementById('thinkModeSmart').classList.add('active');
    document.getElementById('thinkModeGroup').classList.remove('active');
    document.getElementById('thinkGroupBar').style.display = 'none';
    document.getElementById('thinkSmartInfo').style.display = 'flex';
  } else {
    // 分组模式
    if (thinkIndex >= thinkExercises.length) thinkIndex = 0;
    document.getElementById('thinkModeSmart').classList.remove('active');
    document.getElementById('thinkModeGroup').classList.add('active');
    document.getElementById('thinkGroupBar').style.display = '';
    document.getElementById('thinkSmartInfo').style.display = 'none';
    renderThinkGroupBar();
  }
  renderThink();
}
