    h += '<div class="half half-' + (halfNum === 1 ? 'left' : 'right') + '">';
    h += '<div class="print-header">';
    h += '<h1>' + (showAns ? '答案' : (cfg.isMulDiv ? typeLabel + '练习' : '数学练习题')) + (totalPages > 1 ? ' 第' + pageNum + '页' : '') + '</h1>';
    h += '<div class="sub">' + subLabel + '</div>';
