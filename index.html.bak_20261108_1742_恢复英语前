function exportLocalData() {
  var data = {};
  for (var i = 0; i < localStorage.length; i++) {
    var key = localStorage.key(i);
    if (key && key.startsWith('cx_')) {
      data[key] = localStorage.getItem(key);
    }
  }
  var str = JSON.stringify(data);
  document.getElementById('migrateDataText').value = str;
  
  // 尝试复制到剪贴板
  try {
    var textarea = document.createElement('textarea');
    textarea.value = str;
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    alert('✅ 数据已导出并复制到剪贴板！\n共 ' + Object.keys(data).length + ' 项数据\n\n去新设备粘贴导入即可~');
  } catch (e) {
    alert('请手动复制下面文本框里的全部内容~');
  }
}

function importLocalData() {
  var str = document.getElementById('migrateDataText').value.trim();
  if (!str) {
    alert('请先粘贴要导入的数据~');
    return;
  }
  
  try {
    var data = JSON.parse(str);
    var count = 0;
    Object.keys(data).forEach(function(key) {
      if (key.startsWith('cx_')) {
        localStorage.setItem(key, data[key]);
        count++;
      }
    });
    
    // 刷新星星和页面
    totalStars = parseInt(localStorage.getItem('cx_stars') || '0');
    updateTotalStars();
    if (typeof initHome === 'function') initHome();
    
    alert('✅ 导入成功！\n共导入 ' + count + ' 项数据\n\n刷新页面即可看到效果~');
  } catch (e) {
    alert('❌ 导入失败：数据格式不对，请确认复制完整了~');
  }
}

