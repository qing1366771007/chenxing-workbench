  var name = document.getElementById('newHabitName').value.trim();
  if (!name) {
    alert('请输入习惯名字');
    return;
  }
  var list = getHabitList();
  var newHabit = {
    id: 'h_' + Date.now(),
    name: name,
    icon: _selectedIcon
  };
  list.push(newHabit);
  saveHabitList(list);
