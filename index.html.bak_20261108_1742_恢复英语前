    fb.className = 'quiz-feedback no';
    onWrong();
    setTimeout(function() { speakEnWithZh(engQuizCurrent.en, engQuizCurrent.zh); }, 600);
  }
  document.getElementById('engQuizNextBtn').style.display = 'block';
}

