function nextThink() {
  // 智能模式：生成同题型的新题目（答错或只对了1次时，点击"下一题"换一道同类新题）
  if (thinkSmartMode) {
    thinkCurrentQ = smartGenQuestion(thinkCurrentType, thinkDifficulty);
    thinkQStreak = 0; // 主动换题则重置连胜
    renderThink();
    return;
  }

  // 分组模式（原有逻辑）
  var prevGroup = thinkGetCurrentGroup();
  thinkIndex++;
  thinkSaveIndex();
  var groupEnd = thinkGetGroupEnd(prevGroup);

  // 检查是否完成当前组
  if (thinkIndex >= groupEnd) {
    // 检查是否完成所有组
    if (thinkIndex >= thinkExercises.length) {
      // 全部完成
      showThinkGroupComplete(true, prevGroup);
    } else {
      // 完成当前组，显示下一组按钮
      showThinkGroupComplete(false, prevGroup);
    }
    return;
  }
  renderThink();
}

function showThinkGroupComplete(allDone, doneGroup) {
  // 记录已完成的组
  thinkMarkGroupDone(doneGroup);
  renderThinkGroupBar();

  var card = document.getElementById('thinkCard');
  var complete = document.getElementById('thinkGroupComplete');
  var title = document.getElementById('thinkGroupCompleteTitle');
  var sub = document.getElementById('thinkGroupCompleteSub');
  var nextBtn = document.getElementById('thinkGroupNextBtn');

  card.style.display = 'none';
  complete.style.display = 'block';

  if (allDone) {
