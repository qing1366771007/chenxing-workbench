var surnameReading = false;
var surnameIdx = 0;
var surnameTimer = null;

function initSurnames() {
  renderSurnames();
}

function renderSurnames() {
  var list = document.getElementById('surnameList');
  if (!list) return;
  var html = '';
  surnameData.forEach(function(item, idx) {
    html += '<div class="surname-row" id="surnameRow' + idx + '" onclick="readOneSurname(' + idx + ')">' +
      '<span class="surname-num">' + item.num + '</span>' +
      '<div class="surname-chars">' +
        '<div>' + item.chars + '</div>' +
        '<div class="surname-pinyin">' + item.pinyin + '</div>' +
      '</div>' +
      '<span class="surname-icon">🔊</span>' +
      '</div>';
  });
  list.innerHTML = html;
}

function readOneSurname(idx) {
  if (idx < 0 || idx >= surnameData.length) return;
  var item = surnameData[idx];
  // 清除之前的高亮
  document.querySelectorAll('.surname-row').forEach(function(r) { r.classList.remove('reading'); });
  var row = document.getElementById('surnameRow' + idx);
  if (row) row.classList.add('reading');
  speakZh(item.chars);
}

function toggleSurnameRead() {
  if (surnameReading) {
    stopSurnameRead();
    return;
  }
  surnameReading = true;
  surnameIdx = 0;
  var btn = document.getElementById('surnamePlayBtn');
  if (btn) { btn.classList.add('active'); btn.textContent = '⏸ 暂停跟读'; }
  readSurnamesLoop();
}

function readSurnamesLoop() {
  if (!surnameReading || surnameIdx >= surnameData.length) {
    stopSurnameRead();
    return;
  }
  var item = surnameData[surnameIdx];
  document.querySelectorAll('.surname-row').forEach(function(r) { r.classList.remove('reading'); });
  var row = document.getElementById('surnameRow' + surnameIdx);
  if (row) {
    row.classList.add('reading');
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // 先尝试百度TTS
  var player = _getTTSPlayer();
  var bar = _getTTSBar();
  var label = _getTTSLabel();
  var text = item.chars;
  var url = 'https://fanyi.baidu.com/gettts?lan=zh&text=' + encodeURIComponent(text) + '&spd=3&source=web';

  if (player && bar) {
    player.onended = null;
    player.onerror = null;
    if (label) label.textContent = text.length > 12 ? text.substring(0, 12) + '...' : text;
    bar.classList.add('show');
    player.src = url;
    player.load();
    player.onended = function() {
      player.onended = null;
      bar.classList.remove('show');
      surnameIdx++;
      surnameTimer = setTimeout(readSurnamesLoop, 600);
    };
    player.onerror = function() {
      player.onerror = null;
      bar.classList.remove('show');
      // 回退到 Web Speech API
      _speakSynthesis(text, 'zh-CN');
      surnameIdx++;
      surnameTimer = setTimeout(readSurnamesLoop, 2500);
    };
    var p = player.play();
    if (p && p.catch) {
      p.catch(function() {
        bar.classList.remove('show');
        _speakSynthesis(text, 'zh-CN');
        surnameIdx++;
        surnameTimer = setTimeout(readSurnamesLoop, 2500);
      });
    }
  } else {
    // 无播放器，回退
    _speakSynthesis(text, 'zh-CN');
    surnameIdx++;
    surnameTimer = setTimeout(readSurnamesLoop, 2500);
  }
}

function stopSurnameRead() {
  surnameReading = false;
  if (surnameTimer) { clearTimeout(surnameTimer); surnameTimer = null; }
  hideTTSPlayer();
  document.querySelectorAll('.surname-row').forEach(function(r) { r.classList.remove('reading'); });
  var btn = document.getElementById('surnamePlayBtn');
  if (btn) { btn.classList.remove('active'); btn.textContent = '🔊 连续跟读'; }
}

