let idiomCurrentIdx = -1;
let idiomCurrentCat = '全部';

function initIdiom() {
  idiomCurrentIdx = -1;
  document.getElementById('idiomDetail').style.display = 'none';
  document.getElementById('idiomList').style.display = 'grid';
  renderIdiomCatBar();
  renderIdiomList();
}

function renderIdiomCatBar() {
  var bar = document.getElementById('idiomCatBar');
  if (!bar) return;
  var cats = ['全部'];
  idiomData.forEach(function(item) {
    if (item.cat && cats.indexOf(item.cat) === -1) cats.push(item.cat);
  });
  var html = '';
  cats.forEach(function(cat) {
    html += '<div class="idiom-cat-btn ' + (idiomCurrentCat === cat ? 'active' : '') + '" onclick="setIdiomCat(\'' + cat + '\')">' + cat + '</div>';
  });
  bar.innerHTML = html;
}

function setIdiomCat(cat) {
  idiomCurrentCat = cat;
  renderIdiomCatBar();
  renderIdiomList();
}

function renderIdiomList() {
  var list = document.getElementById('idiomList');
  if (!list) return;
  var html = '';
  idiomData.forEach(function(item, idx) {
    if (idiomCurrentCat !== '全部' && item.cat !== idiomCurrentCat) return;
    html += '<div class="idiom-card" onclick="speakIdiom(' + idx + ')">' +
      '<div class="idiom-name">' + item.w + '</div>' +
