var antiMode = 'list';
var antiGameDiff = 6;
var antiGamePairs = [];
var antiGameLeftWords = [];
var antiGameRightWords = [];
var antiGameSelectedLeft = null;
var antiGameSelectedRight = null;
var antiGameScore = 0;
var antiGameMatched = 0;
var antiGameLocked = false;

function setAntiMode(mode) {
  antiMode = mode;
  document.getElementById('antiModeList').className = 'anti-game-mode-btn' + (mode === 'list' ? ' active' : '');
  document.getElementById('antiModeGame').className = 'anti-game-mode-btn' + (mode === 'game' ? ' active' : '');
  document.getElementById('antiCatBar').style.display = mode === 'list' ? 'flex' : 'none';
  document.getElementById('antiGameDiffBar').style.display = mode === 'game' ? 'flex' : 'none';
  document.getElementById('antiList').style.display = mode === 'list' ? 'grid' : 'none';
  document.getElementById('antiGameBoard').style.display = mode === 'game' ? 'block' : 'none';
  document.getElementById('antiGameResult').style.display = 'none';
  document.getElementById('antiGameInfo').style.display = mode === 'game' ? 'flex' : 'none';
  if (mode === 'game') {
    startAntiGame();
  }
}

function setAntiGameDiff(n, btn) {
  antiGameDiff = n;
  var btns = document.querySelectorAll('.anti-game-diff-btn');
  for (var i = 0; i < btns.length; i++) btns[i].classList.remove('active');
  btn.classList.add('active');
  startAntiGame();
}

function startAntiGame() {
  // 收集当前分类下的所有配对
  var allPairs = [];
  var showAll = (antiCurrentCat === '全部');
  antiData.forEach(function(item) {
    if (!showAll && item.cat !== antiCurrentCat) return;
    item.pairs.forEach(function(pair) {
      var parts = pair.split('—');
      if (parts.length === 2 && parts[0] && parts[1]) {
        allPairs.push({ left: parts[0], right: parts[1] });
      }
    });
  });

  // 随机选取n对
  var count = Math.min(antiGameDiff, allPairs.length);
  var shuffled = allPairs.slice().sort(function() { return Math.random() - 0.5; });
  antiGamePairs = shuffled.slice(0, count);

  // 左右分别打乱
  antiGameLeftWords = antiGamePairs.map(function(p) { return p.left; }).sort(function() { return Math.random() - 0.5; });
  antiGameRightWords = antiGamePairs.map(function(p) { return p.right; }).sort(function() { return Math.random() - 0.5; });

  antiGameSelectedLeft = null;
  antiGameSelectedRight = null;
  antiGameScore = 0;
  antiGameMatched = 0;
  antiGameLocked = false;

  document.getElementById('antiGameScore').textContent = '0';
  document.getElementById('antiGameTotal').textContent = count;
  document.getElementById('antiGameResult').style.display = 'none';

  renderAntiGameBoard();
}

function renderAntiGameBoard() {
  var board = document.getElementById('antiGameBoard');
  if (!board) return;

  var leftHtml = '';
  var rightHtml = '';

  antiGameLeftWords.forEach(function(word, idx) {
    var matched = isWordMatched(word, 'left');
    leftHtml += '<div class="anti-game-tile left' + (matched ? ' matched' : '') +
      '" data-word="' + word + '" data-side="left" data-idx="' + idx +
      '" onclick="selectAntiTile(this)">' + word + '</div>';
  });

  antiGameRightWords.forEach(function(word, idx) {
    var matched = isWordMatched(word, 'right');
    rightHtml += '<div class="anti-game-tile right' + (matched ? ' matched' : '') +
      '" data-word="' + word + '" data-side="right" data-idx="' + idx +
      '" onclick="selectAntiTile(this)">' + word + '</div>';
  });

  board.innerHTML = '<div class="anti-game-board">' +
    '<div class="anti-game-col">' + leftHtml + '</div>' +
    '<div class="anti-game-divider">↔</div>' +
    '<div class="anti-game-col">' + rightHtml + '</div>' +
    '</div>';
}

function isWordMatched(word, side) {
  for (var i = 0; i < antiGamePairs.length; i++) {
    var p = antiGamePairs[i];
    if (p.left === word || p.right === word) {
      return p.matched === true;
    }
  }
  return false;
}

function selectAntiTile(el) {
  if (antiGameLocked) return;
  var word = el.getAttribute('data-word');
  var side = el.getAttribute('data-side');

  // 已匹配的不处理
  if (el.classList.contains('matched')) return;

  if (side === 'left') {
    // 取消之前左边选中的
    var prevLeft = document.querySelector('.anti-game-tile.left.selected');
    if (prevLeft) prevLeft.classList.remove('selected');
    if (antiGameSelectedLeft === word) {
      antiGameSelectedLeft = null;
      return;
    }
    el.classList.add('selected');
    antiGameSelectedLeft = word;
  } else {
    var prevRight = document.querySelector('.anti-game-tile.right.selected');
    if (prevRight) prevRight.classList.remove('selected');
    if (antiGameSelectedRight === word) {
      antiGameSelectedRight = null;
      return;
    }
    el.classList.add('selected');
    antiGameSelectedRight = word;
  }

  // 两边都选了，判断配对
  if (antiGameSelectedLeft && antiGameSelectedRight) {
    checkAntiMatch();
  }
}

function checkAntiMatch() {
  antiGameLocked = true;
  var left = antiGameSelectedLeft;
  var right = antiGameSelectedRight;

  var isMatch = false;
  var matchedPair = null;
  for (var i = 0; i < antiGamePairs.length; i++) {
    var p = antiGamePairs[i];
    if (p.left === left && p.right === right) {
      isMatch = true;
      matchedPair = p;
      break;
    }
  }

  if (isMatch) {
    // 配对成功
    matchedPair.matched = true;
    antiGameMatched++;
    antiGameScore++;
    document.getElementById('antiGameScore').textContent = antiGameScore;
    speakZh('答对了！' + left + '的反义词是' + right + '。');

    setTimeout(function() {
      antiGameSelectedLeft = null;
      antiGameSelectedRight = null;
      antiGameLocked = false;
      renderAntiGameBoard();

      // 检查是否全部完成
      if (antiGameMatched >= antiGamePairs.length) {
        showAntiGameResult();
      }
    }, 600);
  } else {
    // 配对失败
    var leftEl = document.querySelector('.anti-game-tile.left.selected');
    var rightEl = document.querySelector('.anti-game-tile.right.selected');
    if (leftEl) leftEl.classList.add('wrong');
    if (rightEl) rightEl.classList.add('wrong');
    speakZh('不对哦，再想想。');

    setTimeout(function() {
      if (leftEl) { leftEl.classList.remove('wrong'); leftEl.classList.remove('selected'); }
      if (rightEl) { rightEl.classList.remove('wrong'); rightEl.classList.remove('selected'); }
      antiGameSelectedLeft = null;
      antiGameSelectedRight = null;
      antiGameLocked = false;
    }, 800);
  }
}

function showAntiGameResult() {
  var result = document.getElementById('antiGameResult');
  var total = antiGamePairs.length;
  result.innerHTML = '<div class="anti-game-result">' +
    '🎉 太棒啦！全部配对成功！<br>' +
    '共 ' + total + ' 对反义词，全部答对！<br>' +
    '<button onclick="startAntiGame()">🔄 再来一局</button>' +
    '</div>';
  result.style.display = 'block';
  speakZh('太棒了！全部配对成功！');
}

