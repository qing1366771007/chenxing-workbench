let pyQuizRound = 0;
let pyQuizRoundSize = 10;
let pyQuizCurrent = null;
let pyQuizOptions = [];
let pyQuizAnswered = false;
let pyQuizShuffled = [];

function initPyQuiz() {
  pyQuizScore = 0;
  pyQuizRound = -1;
  pyQuizShuffled = [...pyQuizPool].sort(() => Math.random() - 0.5);
  renderPyQuizMode();
  nextPyQuiz();
}

function setPyQuizMode(mode) {
  pyQuizMode = mode;
  pyQuizScore = 0;
  pyQuizRound = -1;
  pyQuizShuffled = [...pyQuizPool].sort(() => Math.random() - 0.5);
  renderPyQuizMode();
  nextPyQuiz();
}

