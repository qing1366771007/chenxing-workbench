function renderThinkOpts(content, ex) {
  if (ex.mode === 'click') {
    const row = document.createElement('div');
    row.className = 'think-items-row';
    ex.items.forEach((item, i) => {
      const btn = document.createElement('div');
      btn.className = 'think-item-btn';
      btn.textContent = item;
      btn.onclick = () => checkThinkClick(i, ex.ans);
      row.appendChild(btn);
    });
    content.appendChild(row);
  } else if (ex.mode === 'compare') {
    const row = document.createElement('div');
    row.className = 'think-options';
    row.style.gridTemplateColumns = '1fr 1fr';
    ex.opts.forEach((opt, i) => {
      const btn = document.createElement('div');
      btn.className = 'think-opt';
      btn.textContent = opt;
      btn.onclick = () => checkThinkOpt(i, ex.ans);
      row.appendChild(btn);
    });
    content.appendChild(row);
  } else {
    const optsDiv = document.createElement('div');
    optsDiv.className = 'think-options';
    ex.opts.forEach((opt, i) => {
      const btn = document.createElement('div');
      btn.className = 'think-opt';
      btn.textContent = opt;
      btn.onclick = () => checkThinkOpt(i, ex.ans);
      optsDiv.appendChild(btn);
    });
    content.appendChild(optsDiv);
  }
}
function checkThinkOpt(idx, ans) {
  if (thinkAnswered) return;
  thinkAnswered = true;
  const btns = document.querySelectorAll('#thinkContent .think-opt');
  btns.forEach(function(b, i) { if (i === ans) b.classList.add('correct'); else if (i === idx && idx !== ans) b.classList.add('wrong'); });
  const fb = document.getElementById('thinkFeedback');
  var isCorrect = idx === ans;

  if (thinkSmartMode) {
    // 智能模式：更新答题追踪
    var result = smartCheckAnswer(isCorrect);
    if (isCorrect) {
      var msg = '答对了！';
      if (result === 'mastered') msg = '🎉 太棒了！已掌握，下一题！';
      else if (result === 'levelup') msg = '🚀 太厉害啦！难度提升！';
      else msg = '🎉 答对了！再对一次就掌握！';
      fb.textContent = msg;
      fb.className = 'think-feedback ok';
      addStars(1);
      onCorrect(msg);
    } else {
      fb.textContent = '💪 没关系，再试试！连续答对2次才换下一题哦';
      fb.className = 'think-feedback no';
      onWrong();
    }
    // 自动跳下一题的情况：掌握了就自动跳
    if (result === 'mastered' || result === 'levelup') {
      setTimeout(function() {
        smartNextQuestion();
        renderThink();
      }, 1200);
    } else {
      document.getElementById('thinkNext').style.display = 'block';
    }
    return;
  }

  // 分组模式（原有逻辑）
  if (isCorrect) { fb.textContent = '🎉 答对了！真聪明！'; fb.className = 'think-feedback ok'; addStars(1); onCorrect('答对了！真聪明！'); }
  else { fb.textContent = '💪 没关系，再试试！'; fb.className = 'think-feedback no'; onWrong(); }
  document.getElementById('thinkNext').style.display = 'block';
}
