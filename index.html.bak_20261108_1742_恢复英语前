// 英语听力测试：听读音，点正确的单词
// ============================================================
let _engTestPool = [];   // 当前分类单词池
let _engTestCurrent = null;  // 当前题目的正确单词
let _engTestOptions = [];    // 当前4个选项
let _engTestAnswered = false; // 是否已作答
let _engTestCorrect = 0;
let _engTestWrong = 0;
let _engTestStars = parseInt(localStorage.getItem('cx_engTestStars') || '0');
let _engTestTimeoutId = null; // 自动下一题的定时器

function _buildEngTestPool() {
  // 只取当前分类的单词
  var pool = [];
  if (englishData[engCurrentCat]) {
    englishData[engCurrentCat].forEach(function(item) {
      pool.push(item);
    });
  }
  return pool;
}

function _engTestShuffle(arr) {
  for (var i = arr.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
  }
  return arr;
}

function _engTestUpdateScore() {
  document.getElementById('engTestCorrect').textContent = _engTestCorrect;
  document.getElementById('engTestWrong').textContent = _engTestWrong;
  document.getElementById('engTestStars').textContent = _engTestStars;
}

function engTestPlayAudio() {
  if (!_engTestCurrent) return;
  var btn = document.getElementById('engTestPlayBtn');
  var player = _getTTSPlayer();
  var bar = _getTTSBar();
  var label = _getTTSLabel();
  if (!player || !bar) { speakEn(_engTestCurrent.en); return; }

  // 清除之前的监听
  player.onended = null;
  player.onerror = null;

  // 走服务器代理，绕过百度防盗链
  var url = '/api/tts?lang=en&text=' + encodeURIComponent(_engTestCurrent.en) + '&spd=3';

  if (label) label.textContent = '🎧 ' + (_engTestCurrent.en.length > 12 ? _engTestCurrent.en.substring(0, 12) + '...' : _engTestCurrent.en);
  bar.classList.add('show');
  btn.classList.add('playing');
  btn.textContent = '🔊 播放中...';

  player.src = url;
  player.load();
  player.play().catch(function() {});

  player.onended = function() {
    btn.classList.remove('playing');
    btn.textContent = '🔊 再听一遍';
    // 延迟隐藏TTS播放条
    setTimeout(function() { bar.classList.remove('show'); }, 800);
  };
  player.onerror = function() {
    btn.classList.remove('playing');
    btn.textContent = '🔊 再听一遍';
    // 备用：Web Speech API
    if ('speechSynthesis' in window) {
      var u = new SpeechSynthesisUtterance(_engTestCurrent.en);
      u.lang = 'en-US';
      u.rate = 0.8;
      speechSynthesis.speak(u);
    }
  };
}

function engTestNext() {
  // 清除之前的自动下一题定时器
  if (_engTestTimeoutId) { clearTimeout(_engTestTimeoutId); _engTestTimeoutId = null; }

  if (_engTestPool.length === 0) _engTestPool = _buildEngTestPool();
  if (_engTestPool.length < 2) return;

  // 随机选正确答案
  var correctIdx = Math.floor(Math.random() * _engTestPool.length);
  _engTestCurrent = _engTestPool[correctIdx];

  // 选干扰项（与正确答案不同，最多取3个）
  var distractors = _engTestPool.filter(function(w) {
    return w.en !== _engTestCurrent.en;
  });
  _engTestShuffle(distractors);
  var numOptions = Math.min(4, distractors.length + 1);
  var picked = distractors.slice(0, numOptions - 1);
  picked.push(_engTestCurrent);
  _engTestShuffle(picked);
  _engTestOptions = picked;

  _engTestAnswered = false;

  // 渲染选项
  var container = document.getElementById('engTestOptions');
  container.innerHTML = '';
  _engTestOptions.forEach(function(opt, i) {
    var div = document.createElement('div');
    div.className = 'eng-test-option';
    div.textContent = opt.en;
    div.onclick = function() { engTestAnswer(i); };
    container.appendChild(div);
  });

  // 重置UI
  document.getElementById('engTestPrompt').textContent = '🔊 仔细听读音，选出正确的单词';
  document.getElementById('engTestFeedback').textContent = '';
  document.getElementById('engTestFeedback').className = 'eng-test-feedback';
  document.getElementById('engTestNextBtn').style.display = 'none';
  var playBtn = document.getElementById('engTestPlayBtn');
  playBtn.textContent = '🔊 听读音';
  playBtn.classList.remove('playing');

  // 自动播放读音
  setTimeout(function() { engTestPlayAudio(); }, 300);
}

function engTestAnswer(idx) {
  if (_engTestAnswered) return;
  _engTestAnswered = true;

  var options = document.querySelectorAll('.eng-test-option');
  var selected = _engTestOptions[idx];
  var isCorrect = (selected.en === _engTestCurrent.en);

  // 标记所有选项
  options.forEach(function(opt, i) {
    opt.classList.add('disabled');
    if (_engTestOptions[i].en === _engTestCurrent.en) {
      opt.classList.add('correct');
    }
  });

  // 标记选中的错误项
  if (!isCorrect) {
    options[idx].classList.add('wrong');
  }

  // 更新分数
  var feedback = document.getElementById('engTestFeedback');
  if (isCorrect) {
    _engTestCorrect++;
    _engTestStars++;
    localStorage.setItem('cx_engTestStars', String(_engTestStars));
    feedback.textContent = '✅ 正确！' + _engTestCurrent.en + ' = ' + _engTestCurrent.zh;
    feedback.className = 'eng-test-feedback correct';
  } else {
    _engTestWrong++;
    feedback.textContent = '❌ 答错了，正确答案是 ' + _engTestCurrent.en + '（' + _engTestCurrent.zh + '）';
    feedback.className = 'eng-test-feedback wrong';
  }
  _engTestUpdateScore();

  // 显示下一题按钮
  document.getElementById('engTestNextBtn').style.display = 'inline-block';

  // 2.5秒后自动出下一题
  _engTestTimeoutId = setTimeout(function() {
    _engTestTimeoutId = null;
    if (_engTestAnswered) engTestNext();
  }, 2500);
}

// 初始化听力测试
function initEngTest() {
  _engTestPool = _buildEngTestPool();
  // 更新分类名称显示
  var catNameEl = document.getElementById('engTestCatName');
  if (catNameEl) catNameEl.textContent = engCurrentCat;
  _engTestUpdateScore();
  engTestNext();
}

