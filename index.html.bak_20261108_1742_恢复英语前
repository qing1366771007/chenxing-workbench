      } else if (rblank === 'a') {
        problems.push({ a: rf.ans, b: rf.b, ans: rf.a, op: '÷', blank: 'b', isMulDiv: true });
      } else {
        problems.push({ a: rf.ans, b: rf.a, ans: rf.b, op: '÷', blank: 'a', isMulDiv: true });
      }
