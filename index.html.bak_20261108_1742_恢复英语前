  { name:'百位', icon:'💯', color:'#fdcb6e', desc:'从右数第三位', example:'235 → 2个百' },
  { name:'千位', icon:'🔢', color:'#fd79a8', desc:'从右数第四位', example:'4235 → 4个千' },
  { name:'万位', icon:'⭐', color:'#a29bfe', desc:'从右数第五位', example:'64235 → 6个万' },
];

// 中文数字读法
var cnDigits = ['零','一','二','三','四','五','六','七','八','九'];
var cnPlaces = ['', '十', '百', '千', '万'];

function numToChinese(num) {
  if (num === 0) return '零';
  var s = num.toString();
  var len = s.length;
  var result = '';
  var lastZero = false;
  for (var i = 0; i < len; i++) {
    var d = parseInt(s[i]);
    var p = len - 1 - i; // 位数（0=个位，1=十位...）
    if (d === 0) {
      lastZero = true;
    } else {
      if (lastZero && result !== '') result += '零';
      result += cnDigits[d] + cnPlaces[p];
      lastZero = false;
    }
  }
  // 特殊处理：10~19的"一十"读作"十"
  if (len === 2 && s[0] === '1') {
    result = result.replace(/^一十/, '十');
  }
  return result;
}

