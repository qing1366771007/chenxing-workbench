var dynCurrentIdx = -1;

function renderDynastyTimeline() {
  var wrap = document.getElementById('dynTimeline');
  if (!wrap) return;
  var h = '';
  dynData.forEach(function(d, i) {
    h += '<div class="dyn-item" onclick="showDyn(' + i + ')">';
    h += '<div class="dyn-color-bar" style="background:' + d.color + ';"></div>';
    h += '<div class="dyn-content">';
    h += '<div class="dyn-icon">' + d.icon + '</div>';
    h += '<div class="dyn-info">';
    h += '<div class="dyn-name">' + d.name + '</div>';
    h += '<div class="dyn-years">' + d.years + '（' + d.dur + '）</div>';
    h += '<div class="dyn-desc">' + d.desc + '</div>';
    h += '</div>';
    h += '<div class="dyn-arrow">▶</div>';
    h += '</div>';
    h += '</div>';
  });
  wrap.innerHTML = h;
}

function showDyn(idx) {
  if (idx < 0 || idx >= dynData.length) return;
  dynCurrentIdx = idx;
  var d = dynData[idx];
  var card = document.getElementById('dynDetailCard');
  var h = '';
  h += '<div class="bio-detail-header">';
  h += '<div class="bio-detail-icon">' + d.icon + '</div>';
  h += '<div class="bio-detail-name" style="color:' + d.color + ';">' + d.name + '</div>';
  h += '<div class="bio-detail-title">' + d.years + '（延续' + d.dur + '）</div>';
  h += '</div>';
  h += '<div class="dyn-section">';
  h += '<div class="dyn-section-label">🏛️ 朝代概况</div>';
  h += '<div class="dyn-section-text">' + d.desc + '</div>';
  h += '</div>';
  h += '<div class="dyn-section">';
  h += '<div class="dyn-section-label">📖 朝代故事</div>';
  h += '<div class="dyn-section-text">' + d.story + '</div>';
  h += '</div>';
  h += '<div class="dyn-section">';
  h += '<div class="dyn-section-label">👑 重要人物</div>';
  h += '<div class="dyn-section-text">' + d.kings + '</div>';
  h += '</div>';
  h += '<div class="dyn-section">';
  h += '<div class="dyn-section-label">💡 趣味知识</div>';
  h += '<div class="dyn-fact-box">' + d.fact + '</div>';
  h += '</div>';
  h += '<div class="dyn-section">';
  h += '<div class="dyn-section-label">📍 首都</div>';
  h += '<div class="dyn-section-text">' + d.capital + '</div>';
  h += '</div>';
  h += '<button class="dyn-read-btn" onclick="readDyn()">🔊 听朝代故事</button>';
  h += '<div class="bio-nav-bar">';
  h += '<button class="bio-nav-btn" onclick="dynPrev()">◀ 上一个朝代</button>';
  h += '<button class="bio-nav-btn" onclick="dynNext()">下一个朝代 ▶</button>';
  h += '</div>';
  card.innerHTML = h;
  document.getElementById('dynTimeline').style.display = 'none';
  document.getElementById('dynDetail').style.display = 'block';
  document.getElementById('mainArea').scrollTop = 0;
}

function dynBack() {
  dynCurrentIdx = -1;
  document.getElementById('dynDetail').style.display = 'none';
  document.getElementById('dynTimeline').style.display = 'flex';
}

function readDyn() {
  if (dynCurrentIdx < 0) return;
  var d = dynData[dynCurrentIdx];
  var text = d.name + '。' + d.years + '。' +
    '朝代概况。' + d.desc +
    '朝代故事。' + d.story +
    '趣味知识。' + d.fact;
  speakZh(text);
}

function dynPrev() {
  if (dynCurrentIdx <= 0) dynCurrentIdx = dynData.length;
  showDyn(dynCurrentIdx - 1);
}

function dynNext() {
  if (dynCurrentIdx >= dynData.length - 1) dynCurrentIdx = -1;
  showDyn(dynCurrentIdx + 1);
}


