.hz-card.selected { box-shadow:0 0 0 3px var(--star-purple); }
.hz-card .hz-char { font-size:36px; }
.hz-card .hz-pinyin { font-size:11px; color:var(--text-light); margin-top:2px; }
.hz-detail-section { margin-top:14px; display:none; }
.hz-detail-section.show { display:block; }
.hz-detail-char { text-align:center; font-size:64px; color:var(--star-purple); font-weight:700; }
.hz-detail-info { background:#fff; border-radius:var(--radius-md); padding:14px; margin-top:10px; box-shadow:var(--shadow-card); }
.hz-detail-row { display:flex; align-items:baseline; gap:6px; margin-bottom:6px; font-size:14px; }
.hz-detail-row .label { color:var(--text-light); min-width:56px; flex-shrink:0; }
.hz-detail-row .value { color:var(--text-dark); }

/* ========== 思维模块 ========== */
#module-think .module-header { background:rgba(0,206,201,0.9); color:#fff; }
.think-card {
  background:#fff; border-radius:var(--radius-md); padding:18px 14px;
  box-shadow:var(--shadow-card);
}
.think-type { font-size:13px; color:var(--star-teal); font-weight:600; margin-bottom:4px; }
.think-question { font-size:17px; color:var(--text-dark); margin-bottom:14px; }
.think-seq { text-align:center; font-size:30px; margin:14px 0; display:flex; justify-content:center; gap:2px; flex-wrap:wrap; }
.think-seq .q-mark { color:var(--star-pink); }
/* 数独网格 */
.think-sudoku { display:inline-block; margin:10px auto; border:3px solid #2d3436; border-radius:6px; background:#fff; }
.think-sudoku-row { display:flex; }
.think-sudoku-cell {
  width:44px; height:44px; display:flex; align-items:center; justify-content:center;
  font-size:22px; font-weight:600; color:#2d3436; border:1px solid #dfe6e9;
  box-sizing:border-box;
}
.think-sudoku-cell.filled { background:#f8f9fa; color:#2d3436; }
.think-sudoku-cell.empty { color:transparent; }
.think-sudoku-cell.qcell { background:#ffeaa7; color:#e17055; font-size:26px; }
/* 2x2 宫格粗线 */
.think-sudoku-row:nth-child(2) .think-sudoku-cell { border-bottom:2.5px solid #2d3436; }
.think-sudoku-row:nth-child(1) .think-sudoku-cell { border-top:2.5px solid #2d3436; }
.think-sudoku-row:nth-child(4) .think-sudoku-cell { border-bottom:2.5px solid #2d3436; }
.think-sudoku-cell:nth-child(2) { border-right:2.5px solid #2d3436; }
.think-sudoku-cell:nth-child(4) { border-right:2.5px solid #2d3436; }
.think-sudoku-cell:nth-child(1) { border-left:2.5px solid #2d3436; }
.think-sudoku-center { text-align:center; }
/* 十字数独 */
.think-cross-wrap { text-align:center; margin:10px 0; }
.think-cross { display:inline-block; position:relative; }
.think-cross-row { display:flex; justify-content:center; }
.think-cross-cell {
  width:46px; height:46px; display:flex; align-items:center; justify-content:center;
  font-size:24px; font-weight:700; color:#2d3436;
  border:2px solid #2d3436; box-sizing:border-box;
  background:#fff; margin:-1px 0 0 -1px;
}
.think-cross-cell.filled { background:#f8f9fa; color:#2d3436; }
.think-cross-cell.empty { background:#fff; color:transparent; }
.think-cross-cell.qcell { background:#ffeaa7; color:#e17055; font-size:28px; }
.think-cross-cell.empty-space { border:none; background:transparent; margin:-1px 0 0 -1px; }
.think-options { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:12px; }
.think-opt {
  padding:14px 6px; border-radius:var(--radius-sm); background:#f0fffe;
  text-align:center; font-size:22px; transition:all .2s; border:3px solid transparent; cursor:pointer;
}
.think-opt:active { transform:scale(.92); }
.think-opt.correct { background:var(--star-green); color:#fff; border-color:var(--star-green); }
.think-opt.wrong { background:#ff7675; color:#fff; border-color:#ff7675; }
.think-items-row { display:flex; justify-content:center; gap:10px; margin:14px 0; flex-wrap:wrap; }
.think-item-btn {
  width:62px; height:62px; border-radius:var(--radius-sm); background:#f0fffe;
  display:flex; align-items:center; justify-content:center; font-size:32px;
  transition:all .2s; border:3px solid transparent; cursor:pointer;
}
.think-item-btn:active { transform:scale(.92); }
.think-item-btn.correct { background:var(--star-green); border-color:var(--star-green); }
.think-item-btn.wrong { background:#ff7675; border-color:#ff7675; }
.think-feedback { text-align:center; font-size:20px; min-height:32px; margin-top:10px; }
.think-feedback.ok { color:var(--star-green); }
.think-feedback.no { color:var(--star-pink); }
.think-next {
  margin-top:12px; width:100%; padding:12px; border-radius:30px;
  background:var(--star-teal); color:#fff; font-size:16px; box-shadow:var(--shadow-btn);
}
.think-progress { display:flex; gap:5px; justify-content:center; margin-bottom:12px; flex-wrap:wrap; }
.think-dot { width:9px; height:9px; border-radius:50%; background:rgba(0,0,0,.1); }
.think-dot.done { background:var(--star-gold); }
.think-dot.current { background:var(--star-teal); transform:scale(1.3); }
.think-group-bar {
  display:flex; gap:6px; margin-bottom:12px; flex-wrap:wrap; justify-content:center;
}
.think-group-btn {
  flex:1 1 0; min-width:56px; padding:10px 6px; border-radius:var(--radius-sm);
  border:2px solid transparent; background:#f0fffe; cursor:pointer;
  text-align:center; transition:all .2s; font-size:13px; font-weight:600;
  display:flex; flex-direction:column; align-items:center; gap:2px;
}
.think-group-btn .tg-num { font-size:15px; font-weight:700; color:var(--star-teal); }
.think-group-btn .tg-desc { font-size:10px; color:var(--text-light); }
.think-group-btn:active { transform:scale(.92); }
.think-group-btn.current { background:var(--star-teal); border-color:var(--star-teal); }
.think-group-btn.current .tg-num { color:#fff; }
.think-group-btn.current .tg-desc { color:rgba(255,255,255,.85); }
.think-group-btn.done { background:rgba(255,215,0,.15); border-color:var(--star-gold); }
.think-group-btn.done .tg-num { color:var(--star-gold); }
.think-group-btn.done .tg-desc::after { content: ' ✓'; }
.think-group-badge {
  display:inline-block; padding:4px 14px; border-radius:20px;
  background:var(--star-teal); color:#fff; font-size:13px; font-weight:600;
  margin-bottom:8px;
}
.think-group-complete {
  text-align:center; padding:30px 16px;
}
.think-group-complete-icon { font-size:48px; margin-bottom:10px; animation:pop .5s; }
.think-group-complete-title { font-size:22px; font-weight:700; color:var(--star-teal); margin-bottom:6px; }
.think-group-complete-sub { font-size:15px; color:var(--text-light); margin-bottom:18px; }
.think-group-next-btn {
  padding:14px 40px; border-radius:30px; border:none; cursor:pointer;
  background:var(--star-teal); color:#fff; font-size:18px; box-shadow:var(--shadow-btn);
  animation:recitePulse 2s infinite;
}
.think-group-next-btn:active { transform:scale(.95); }

/* —— 智能模式：模式切换栏 —— */
.think-mode-bar {
  display:flex; gap:8px; margin-bottom:12px; justify-content:center;
}
.think-mode-btn {
  flex:1; max-width:140px; padding:10px 16px; border-radius:20px;
  background:#fff; font-size:14px; color:var(--text-light);
  border:2px solid transparent; box-shadow:var(--shadow-card);
  cursor:pointer; transition:all .2s; text-align:center; font-weight:600;
}
.think-mode-btn:active { transform:scale(.95); }
.think-mode-btn.active {
  background:var(--star-teal); color:#fff; border-color:var(--star-teal);
}

/* —— 智能模式：难度和进度信息栏 —— */
.think-smart-info {
  display:flex; justify-content:space-between; align-items:center;
  padding:10px 14px; margin-bottom:12px;
  background:#fff; border-radius:var(--radius-md);
  box-shadow:var(--shadow-card);
}
.think-difficulty {
  display:flex; align-items:center; gap:6px;
}
.think-diff-label {
  font-size:13px; color:var(--text-light); font-weight:600;
}
.think-diff-stars {
  font-size:16px; letter-spacing:-1px;
}
.think-diff-level {
  font-size:12px; color:var(--star-gold); font-weight:700;
  background:rgba(255,215,0,.15); padding:2px 8px; border-radius:10px;
}
.think-mastered {
  display:flex; align-items:center; gap:4px;
}
.think-mastered-icon { font-size:16px; }
.think-mastered-count {
  font-size:16px; font-weight:700; color:var(--star-teal);
}
.think-mastered-text {
  font-size:12px; color:var(--text-light);
}

/* ========== 听音选字模块 ========== */
#module-quiz .module-header { background:rgba(255,165,2,0.9); color:#fff; }
.quiz-mode-bar {
  display:flex; gap:6px; margin-bottom:8px; flex-wrap:wrap;
}
.quiz-mode-btn {
  padding:6px 12px; border-radius:16px; background:#fff;
  font-size:13px; color:var(--text-light); border:2px solid transparent;
  box-shadow:var(--shadow-card); cursor:pointer; transition:all .2s;
}
.quiz-mode-btn.active {
  background:var(--star-orange); color:#fff; border-color:var(--star-orange);
}
.quiz-card {
  background:#fff; border-radius:var(--radius-lg); padding:14px 16px;
  box-shadow:var(--shadow-card); text-align:center;
}
.quiz-prompt {
  font-size:15px; color:var(--text-dark); margin-bottom:4px;
}
.quiz-hint {
  font-size:28px; color:var(--star-orange); font-weight:700; margin:4px 0 8px;
  min-height:36px; display:flex; align-items:center; justify-content:center;
}
.quiz-play-btn {
  width:56px; height:56px; border-radius:50%; background:var(--star-orange);
  color:#fff; font-size:26px; margin:0 auto 10px; display:flex;
  align-items:center; justify-content:center; box-shadow:0 4px 16px rgba(255,165,2,.4);
  cursor:pointer; transition:transform .2s; animation:soundPulse 1.5s ease infinite;
}
@keyframes soundPulse {
  0%,100% { transform:scale(1); box-shadow:0 4px 16px rgba(255,165,2,.4); }
  50% { transform:scale(1.08); box-shadow:0 6px 24px rgba(255,165,2,.6); }
}
.quiz-play-btn:active { transform:scale(.9); }
.quiz-options {
  display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:8px;
  max-width:260px; margin-left:auto; margin-right:auto;
}
.quiz-opt {
  aspect-ratio:1; border-radius:var(--radius-md); background:#fff8ef;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-size:50px; border:3px solid transparent; cursor:pointer; transition:all .2s;
}
.quiz-opt:active { transform:scale(.92); }
.quiz-opt.correct { background:var(--star-green); color:#fff; border-color:var(--star-green); }
.quiz-opt.wrong { background:#ff7675; color:#fff; border-color:#ff7675; }
.quiz-opt .opt-pinyin { font-size:12px; color:var(--text-light); margin-top:2px; }
.quiz-opt.correct .opt-pinyin, .quiz-opt.wrong .opt-pinyin { color:rgba(255,255,255,.8); }
.quiz-feedback { text-align:center; font-size:16px; min-height:24px; margin-top:8px; }
.quiz-feedback.ok { color:var(--star-green); }
.quiz-feedback.no { color:var(--star-pink); }
.quiz-next-btn {
  margin-top:8px; width:100%; padding:10px; border-radius:24px;
  background:var(--star-orange); color:#fff; font-size:15px; box-shadow:var(--shadow-btn);
}
.quiz-score-bar {
  display:flex; justify-content:space-between; align-items:center;
  margin-bottom:8px; font-size:13px; color:var(--text-light);
}
.quiz-score-bar .score-num { color:var(--star-orange); font-weight:700; font-size:16px; }

/* 选字游戏分组进度条 */
.quiz-group-bar {
  display:flex; gap:4px; margin-bottom:8px; flex-wrap:wrap;
  justify-content:center;
}
.quiz-group-dot {
  width:26px; height:26px; line-height:24px; text-align:center;
  border-radius:50%; background:#fff; color:var(--text-light);
  font-size:12px; font-weight:700; cursor:pointer;
  border:2px solid #e0e0e0; transition:all .2s;
}
.quiz-group-dot.active {
  background:var(--star-orange); color:#fff; border-color:var(--star-orange);
}
.quiz-group-dot:active { transform:scale(0.9); }
.quiz-result {
  text-align:center; padding:30px 20px;
}
.quiz-result .big-emoji { font-size:64px; margin-bottom:12px; }
.quiz-result .result-title { font-size:24px; font-weight:700; color:var(--text-dark); }
.quiz-result .result-score { font-size:18px; color:var(--star-orange); margin:10px 0; }
.quiz-result .restart-btn {
  margin-top:16px; padding:13px 36px; border-radius:30px;
  background:var(--star-orange); color:#fff; font-size:16px; box-shadow:var(--shadow-btn);
}

/* ========== 乘法口诀表 ========== */
.mul-mode-bar { display:flex; gap:8px; margin-bottom:14px; }
.mul-mode-btn {
  flex:1; padding:10px; border-radius:20px; background:#fff;
  font-size:14px; color:var(--text-light); border:2px solid transparent;
  box-shadow:var(--shadow-card); cursor:pointer; transition:all .2s; text-align:center;
}
.mul-mode-btn.active { background:var(--star-blue); color:#fff; box-shadow:var(--shadow-btn); }
.mul-table { width:100%; border-collapse:collapse; margin-top:8px; }
.mul-table td {
  text-align:center; padding:10px 4px; font-size:14px;
  border:1px solid #e8e8e8; background:#fff;
}
.mul-table td.current { background:var(--star-orange); color:#fff; font-weight:700; transform:scale(1.05); }
.mul-table td.done { background:rgba(46,204,113,0.15); }
.mul-recite-box {
  text-align:center; padding:24px 16px; background:#fff; border-radius:16px;
  box-shadow:var(--shadow-card); margin-bottom:14px;
}
.mul-recite-formula { font-size:32px; font-weight:700; color:var(--text-dark); margin:10px 0; }
.mul-recite-formula .highlight { color:var(--star-orange); }
.mul-controls { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; }
.mul-ctrl-btn {
  padding:12px 28px; border-radius:30px; font-size:16px; color:#fff;
  box-shadow:var(--shadow-btn); cursor:pointer; transition:all .2s; border:none;
}
.mul-ctrl-btn:active { transform:scale(0.95); }
.mul-ctrl-btn.start { background:var(--star-green); }
.mul-ctrl-btn.stop { background:#e74c3c; }
.mul-ctrl-btn.test { background:var(--star-orange); }
.mul-ctrl-btn.disabled { opacity:0.5; pointer-events:none; }
.mul-test-box {
  text-align:center; padding:12px 14px; background:#fff; border-radius:16px;
  box-shadow:var(--shadow-card);
}
.mul-test-box .quiz-score-bar { margin-bottom:8px; font-size:13px; }
.mul-test-box .quiz-score-bar .score-num { font-size:16px; }
.mul-test-box .quiz-feedback { font-size:16px; min-height:24px; margin-top:8px; }
.mul-test-box .quiz-next-btn { margin-top:8px; padding:10px; font-size:15px; }
.mul-test-question { font-size:26px; font-weight:700; margin:4px 0 8px; color:var(--text-dark); }
.mul-test-options { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:8px; }
.mul-test-opt {
  padding:12px; border-radius:12px; background:#f8f8f8; font-size:18px; font-weight:600;
  cursor:pointer; transition:all .2s; border:2px solid transparent;
}
.mul-test-opt:active { transform:scale(0.95); }
.mul-test-opt.correct { background:var(--star-green); color:#fff; border-color:var(--star-green); }
.mul-test-opt.wrong { background:#ff7675; color:#fff; border-color:#ff7675; }

/* 测验模式子模式切换 */
.mul-test-mode-bar {
  display:flex; gap:8px; margin-bottom:8px;
}
.mul-test-mode-btn {
  flex:1; padding:8px; text-align:center; border-radius:10px;
  background:#f0f0f0; color:var(--text-dark); font-size:13px; font-weight:600;
  cursor:pointer; transition:all .2s;
}
.mul-test-mode-btn.active {
  background:var(--star-blue); color:#fff;
}
.mul-test-mode-btn:active { transform:scale(0.96); }

/* 填空模式 */
.mul-fill-answer-box {
  margin:8px 0;
}
.mul-fill-display {
  display:inline-block; min-width:70px; min-height:40px; line-height:40px;
  font-size:28px; font-weight:700; color:var(--star-blue);
  border:3px solid var(--star-blue); border-radius:10px;
  padding:2px 16px; background:#f0f8ff;
}
.mul-fill-display.correct-anim {
  background:var(--star-green); color:#fff; border-color:var(--star-green);
  animation: popIn 0.4s ease;
}
.mul-fill-display.wrong-anim {
  background:#ff7675; color:#fff; border-color:#ff7675;
  animation: shake 0.4s ease;
}
.mul-fill-keypad {
  display:grid; grid-template-columns:repeat(3,1fr); gap:6px;
  margin-top:8px;
}
.mul-key {
  padding:10px; font-size:20px; font-weight:700;
  background:#f5f5f5; border-radius:10px; cursor:pointer;
  transition:all .15s; color:var(--text-dark);
}
.mul-key:active { transform:scale(0.92); background:#e0e0e0; }
.mul-key-del { background:#ffeaea; color:#e74c3c; }
.mul-key-del:active { background:#ffd0d0; }
.mul-key-ok { background:var(--star-green); color:#fff; }
.mul-key-ok:active { background:#27ae60; }

@keyframes popIn {
  0% { transform:scale(1); }
  50% { transform:scale(1.15); }
  100% { transform:scale(1); }
}
@keyframes shake {
  0%, 100% { transform:translateX(0); }
  25% { transform:translateX(-8px); }
  75% { transform:translateX(8px); }
}

/* ========== 古诗模块 ========== */
#module-poem .module-header { background:rgba(255,211,42,0.9); color:#1a1a2e; }
#poemList.poem-list {
  display:grid !important;
  grid-template-columns:repeat(3,1fr) !important;
  gap:8px !important;
}
.poem-list-item {
  background:#fff; border-radius:var(--radius-sm); padding:12px 6px;
  box-shadow:var(--shadow-card); cursor:pointer; transition:transform .15s;
  text-align:center; display:flex; flex-direction:column; align-items:center;
  justify-content:center; min-height:80px; position:relative;
  border:2px solid transparent;
}
.poem-list-item:active { transform:scale(.97); }
.poem-list-item .title { font-size:15px; font-weight:600; color:var(--text-dark); line-height:1.3; }
.poem-list-item .author { font-size:11px; color:var(--text-light); margin-top:3px; }
.poem-list-item .arrow { font-size:18px; color:var(--star-orange); margin-top:6px; }
.poem-list-item .poem-icon { font-size:22px; margin-bottom:3px; }
.poem-detail-card {
  background:#fff; border-radius:var(--radius-md); padding:24px 16px;
