var storyShowPinyin = false;
function _textWithPinyin(text) {
  if (!storyShowPinyin) return text;
  var html = '';
  for (var i = 0; i < text.length; i++) {
    var ch = text[i];
    var py = _toPinyin(ch);
    if (py) {
      html += '<ruby>' + ch + '<rt>' + py + '</rt></ruby>';
    } else if (/[\u4e00-\u9fff]/.test(ch)) {
