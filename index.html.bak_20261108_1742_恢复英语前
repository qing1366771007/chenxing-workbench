      '<div style="font-size:11px; color:#888; margin-top:3px;">' + p.author + '</div>';
    item.onclick = () => showPoem(i);
    list.appendChild(item);
  });
}
function showPoem(idx) {
  currentPoem = poemsData[idx];
  var list = document.getElementById('poemList');
  list.style.setProperty('display', 'none', 'important');
  list.style.visibility = '';
  list.style.position = '';
  list.style.left = '';
  document.getElementById('poemDetail').style.display = 'block';
  document.getElementById('poemTitle').textContent = currentPoem.title;
  document.getElementById('poemAuthor').textContent = currentPoem.author;
  const content = document.getElementById('poemContent');
  content.innerHTML = '';
  currentPoem.lines.forEach((line, li) => {
    const lineDiv = document.createElement('div');
    lineDiv.className = 'poem-line';
    for (let ci = 0; ci < line.length; ci++) {
      const block = document.createElement('span');
      block.className = 'poem-char-block';
      const py = currentPoem.pinyin[li] && currentPoem.pinyin[li][ci] ? currentPoem.pinyin[li][ci] : '';
      block.innerHTML = `<span class="poem-char-pinyin">${py}</span><span class="poem-char-text">${line[ci]}</span>`;
      lineDiv.appendChild(block);
    }
    content.appendChild(lineDiv);
  });
  document.getElementById('poemMeaning').textContent = '💡 ' + currentPoem.meaning;
}
function poemBack() {
  document.getElementById('poemDetail').style.display = 'none';
  var list = document.getElementById('poemList');
  list.style.setProperty('display', 'grid', 'important');
  list.style.gridTemplateColumns = 'repeat(3, 1fr)';
  list.style.gap = '8px';
}
function readPoem() {
  if (!currentPoem) return;
  let text = currentPoem.lines.join('，');
  speakZh(text);
}

