function getOrigamiSvg(key) {
  var paperColor = '#FF6B6B';
  var paperLight = '#FFE0E0';
  var foldLine = '#e74c3c';
  var arrowColor = '#3498db';
  var w = 200, h = 180;
  var cx = w / 2, cy = h / 2;

  var svgStart = '<svg viewBox="0 0 ' + w + ' ' + h + '" xmlns="http://www.w3.org/2000/svg">';
  var svgEnd = '</svg>';

  // 通用：正方形
  function square(size, color) {
    var s = size || 120;
    var c = color || paperColor;
    var x = cx - s/2, y = cy - s/2;
    return '<rect x="' + x + '" y="' + y + '" width="' + s + '" height="' + s + '" fill="' + c + '" stroke="#333" stroke-width="1.5"/>';
  }

  // 折痕虚线
  function vFold(x, y1, y2) {
    return '<line x1="' + x + '" y1="' + y1 + '" x2="' + x + '" y2="' + y2 + '" stroke="' + foldLine + '" stroke-width="1.5" stroke-dasharray="4,3"/>';
  }
  function hFold(y, x1, x2) {
    return '<line x1="' + x1 + '" y1="' + y + '" x2="' + x2 + '" y2="' + y + '" stroke="' + foldLine + '" stroke-width="1.5" stroke-dasharray="4,3"/>';
  }

  // 箭头
  function arrow(x1, y1, x2, y2) {
    var midx = (x1+x2)/2, midy = (y1+y2)/2;
    return '<line x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '" stroke="' + arrowColor + '" stroke-width="2" fill="none" marker-end="url(#arrowhead)"/>';
  }

  var defs = '<defs><marker id="arrowhead" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><polygon points="0 0, 8 4, 0 8" fill="' + arrowColor + '"/></marker></defs>';

  // ===== 纸飞机 =====
  if (key === 'square_plane_1') {
    return svgStart + defs + square(120) + svgEnd;
  }
  if (key === 'square_plane_2') {
    return svgStart + defs +
      '<polygon points="' + cx + ',' + (cy-60) + ' ' + (cx-60) + ',' + (cy+60) + ' ' + (cx+60) + ',' + (cy+60) + '" fill="' + paperColor + '" stroke="#333" stroke-width="1.5"/>' +
      vFold(cx, cy-60, cy+60) +
      svgEnd;
  }
  if (key === 'square_plane_3') {
    return svgStart + defs +
      '<polygon points="' + cx + ',' + (cy-60) + ' ' + (cx-60) + ',' + (cy+60) + ' ' + (cx+60) + ',' + (cy+60) + '" fill="' + paperColor + '" stroke="#333" stroke-width="1.5"/>' +
      '<polygon points="' + cx + ',' + (cy-60) + ' ' + cx + ',' + cy + ' ' + (cx-45) + ',' + (cy+60) + '" fill="' + paperLight + '" stroke="#333" stroke-width="1"/>' +
      '<polygon points="' + cx + ',' + (cy-60) + ' ' + cx + ',' + cy + ' ' + (cx+45) + ',' + (cy+60) + '" fill="' + paperLight + '" stroke="#333" stroke-width="1"/>' +
      arrow(cx-55, cy+10, cx-20, cy-10) +
      arrow(cx+55, cy+10, cx+20, cy-10) +
      svgEnd;
  }
  if (key === 'square_plane_4') {
    return svgStart + defs +
      '<polygon points="' + cx + ',' + (cy+60) + ' ' + (cx-50) + ',' + (cy-10) + ' ' + (cx+50) + ',' + (cy-10) + '" fill="' + paperColor + '" stroke="#333" stroke-width="1.5"/>' +
      arrow(cx, cy-50, cx, cy+10) +
      svgEnd;
  }
  if (key === 'square_plane_5') {
    return svgStart + defs +
      '<polygon points="' + (cx-55) + ',' + (cy+50) + ' ' + cx + ',' + (cy-60) + ' ' + (cx+55) + ',' + (cy+50) + '" fill="' + paperColor + '" stroke="#333" stroke-width="1.5"/>' +
      '<polygon points="' + (cx-20) + ',' + (cy+50) + ' ' + cx + ',' + (cy-60) + ' ' + (cx+20) + ',' + (cy+50) + '" fill="' + paperLight + '" stroke="#333" stroke-width="1"/>' +
      arrow(cx-40, cy+30, cx-15, cy+30) +
      arrow(cx+40, cy+30, cx+15, cy+30) +
      svgEnd;
  }
  if (key === 'square_plane_6') {
    return svgStart + defs +
      '<polygon points="' + (cx-70) + ',' + (cy+20) + ' ' + cx + ',' + (cy-50) + ' ' + (cx+70) + ',' + (cy+20) + ' ' + cx + ',' + (cy+10) + '" fill="' + paperColor + '" stroke="#333" stroke-width="1.5"/>' +
