    var t = thinkExercises[i].type;
    types[t] = (types[t] || 0) + 1;
  }
  var parts = [];
  for (var t in types) {
    parts.push(t + (types[t] > 1 ? types[t] : ''));
  }
  return parts.join('·');
}

