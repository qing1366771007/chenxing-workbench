const writeCanvases = {};
function initWriteCanvas(canvasId, guideText, guideColor) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  if (rect.width === 0) return;
  canvas.width = rect.width * dpr;
  canvas.height = 180 * dpr;
  canvas.style.height = '180px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  drawWriteGuide(ctx, rect.width, 180, guideText, guideColor);

  let drawing = false, lx = 0, ly = 0;
  function pos(e) {
    const r = canvas.getBoundingClientRect();
    if (e.touches && e.touches[0]) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }
  function start(e) { e.preventDefault(); drawing = true; const p = pos(e); lx = p.x; ly = p.y; }
  function move(e) {
    if (!drawing) return; e.preventDefault();
    const p = pos(e);
    ctx.strokeStyle = '#6C5CE7'; ctx.lineWidth = 4;
    ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p.x, p.y); ctx.stroke();
    lx = p.x; ly = p.y;
  }
  function end(e) { e.preventDefault(); drawing = false; }
  canvas.onmousedown = start; canvas.onmousemove = move; canvas.onmouseup = end; canvas.onmouseleave = end;
  canvas.addEventListener('touchstart', start, { passive: false });
  canvas.addEventListener('touchmove', move, { passive: false });
  canvas.addEventListener('touchend', end, { passive: false });
  writeCanvases[canvasId] = { canvas, ctx, guideText, guideColor };
}
function drawWriteGuide(ctx, w, h, text, color) {
  ctx.clearRect(0, 0, w * 2, h * 2);
  if (text) {
    ctx.font = '100px sans-serif';
    ctx.fillStyle = color || '#e8e8e8';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(text, w / 2, h / 2);
  }
  ctx.strokeStyle = '#f0f0f0'; ctx.lineWidth = 1; ctx.setLineDash([5, 5]);
  ctx.beginPath();
  ctx.moveTo(w / 2, 0); ctx.lineTo(w / 2, h);
  ctx.moveTo(0, h / 2); ctx.lineTo(w, h / 2);
  ctx.stroke();
  ctx.setLineDash([]);
}
function clearWrite(canvasId) {
  const wc = writeCanvases[canvasId];
  if (!wc) return;
  drawWriteGuide(wc.ctx, wc.canvas.getBoundingClientRect().width, 180, wc.guideText, wc.guideColor);
}

