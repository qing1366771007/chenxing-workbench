const EMOJI_SHAPES = ['🔴','🟡','🟢','🔵','🟣','🟠','⬛','⬜','🔺','⭕'];
const EMOJI_NATURE = ['🌞','🌙','⭐','🌈','🌳','🌸','🌼','🌊','☁️','❄️'];
const EMOJI_TRANSPORT = ['🚗','🚕','🚌','🚙','🚓','🚑','🚒','✈️','🚢','🚲'];
