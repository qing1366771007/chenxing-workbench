function renderDynastyTimeline() {
  var wrap = document.getElementById('dynTimeline');
  if (!wrap) return;
  var h = '';
  dynData.forEach(function(d, i) {
    h += '<div class="dyn-item" onclick="showDyn(' + i + ')">';
