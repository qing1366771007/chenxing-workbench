      '<span>第 <span class="score-num" id="pyQuizRoundNum">1</span> / ' + pyQuizRoundSize + ' 题</span>' +
      '<span>⭐ 得分：<span class="score-num" id="pyQuizScoreNum">0</span></span>' +
    '</div>' +
    '<div id="pyQuizCard"></div>';
}

function nextPyQuiz() {
  pyQuizRound++;
  if (pyQuizRound >= pyQuizRoundSize) {
    showPyQuizResult();
    return;
  }
  document.getElementById('pyQuizRoundNum').textContent = pyQuizRound + 1;
  document.getElementById('pyQuizScoreNum').textContent = pyQuizScore;
  pyQuizAnswered = false;

  pyQuizCurrent = pyQuizShuffled[pyQuizRound % pyQuizShuffled.length];

  if (pyQuizMode === 'char2read') {
    renderChar2Read();
  } else {
    // 生成4个选项
    var wrongs = pyQuizPool.filter(function(item) {
      return item.p !== pyQuizCurrent.p && item.c !== pyQuizCurrent.c;
    });
    wrongs.sort(function() { return Math.random() - 0.5; });
    pyQuizOptions = [pyQuizCurrent, wrongs[0], wrongs[1], wrongs[2]];
    pyQuizOptions.sort(function() { return Math.random() - 0.5; });

    if (pyQuizMode === 'pinyin2char') {
      renderPinyin2Char();
    } else {
      renderSound2Pinyin();
    }
  }
}

