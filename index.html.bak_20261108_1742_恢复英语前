function getHabitList() {
  try {
    var saved = JSON.parse(localStorage.getItem('cx_habits') || '[]');
    if (saved && saved.length > 0) return saved;
  } catch(e) {}
  return JSON.parse(JSON.stringify(_defaultHabitList));
}

function saveHabitList(list) {
  localStorage.setItem('cx_habits', JSON.stringify(list));
}

function getTodayStr() {
  var d = new Date();
  return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
}

function getCheckinData() {
  try {
    return JSON.parse(localStorage.getItem('cx_checkin') || '{}');
  } catch(e) {
    return {};
  }
}

function saveCheckinData(data) {
  localStorage.setItem('cx_checkin', JSON.stringify(data));
}

function initCheckin() {
  var today = getTodayStr();
  var data = getCheckinData();
  if (!data[today]) data[today] = { habits: {}, hongen: data.hongen || 0 };

  var habitList = getHabitList();
  var list = document.getElementById('habitList2');
  if (!list) return;
  list.innerHTML = '';

  if (_habitEditMode) {
    habitList.forEach(function(h) {
      var card = document.createElement('div');
      card.className = 'content-card';
      card.style.cssText = 'padding:16px 12px;text-align:center;position:relative;';
      var delBtn = document.createElement('div');
      delBtn.style.cssText = 'position:absolute;top:4px;right:4px;width:24px;height:24px;background:#ff4757;color:#fff;border-radius:50%;line-height:24px;font-size:14px;cursor:pointer;';
      delBtn.textContent = '×';
      delBtn.onclick = function(e) {
        e.stopPropagation();
        if (confirm('删除「' + h.name + '」这个习惯吗？')) {
          deleteHabit(h.id);
        }
      };
      card.appendChild(delBtn);
      var iconDiv = document.createElement('div');
      iconDiv.style.cssText = 'font-size:32px;margin-bottom:6px;';
      iconDiv.textContent = h.icon;
      card.appendChild(iconDiv);
      var nameDiv = document.createElement('div');
      nameDiv.style.cssText = 'font-size:15px;font-weight:700;';
      nameDiv.textContent = h.name;
      card.appendChild(nameDiv);
      list.appendChild(card);
    });
    var addCard = document.createElement('div');
    addCard.className = 'content-card';
    addCard.style.cssText = 'padding:16px 12px;text-align:center;cursor:pointer;border:2px dashed #ddd;background:#fafafa;';
    addCard.innerHTML = '<div style="font-size:32px;margin-bottom:6px;">➕</div><div style="font-size:15px;font-weight:700;color:#999;">添加习惯</div>';
    addCard.onclick = function() { openAddHabitPopup2(); };
    list.appendChild(addCard);
  } else {
    habitList.forEach(function(h) {
      var done = data[today].habits[h.id];
      var card = document.createElement('div');
      card.className = 'content-card';
      card.style.cssText = 'padding:16px 12px;text-align:center;cursor:pointer;transition:all .2s;' + 
        (done ? 'background:linear-gradient(135deg,#55efc4,#00b894);color:#fff;' : '');
      card.innerHTML = '<div style="font-size:32px;margin-bottom:6px;">' + h.icon + '</div>' +
        '<div style="font-size:15px;font-weight:700;">' + h.name + '</div>' +
        '<div style="font-size:12px;margin-top:4px;">' + (done ? '✅ 已完成' : '点我打卡') + '</div>';
      card.onclick = function() { toggleHabit(h.id); };
      list.appendChild(card);
    });
  }

  var hc = document.getElementById('hongenCount2');
  if (hc) hc.textContent = data.hongen || 0;

  var streak = calcStreak(data);
  var sd = document.getElementById('streakDays2');
  if (sd) sd.textContent = streak;
}

function toggleHabitEdit() {
  _habitEditMode = !_habitEditMode;
  initCheckin();
}

function deleteHabit(id) {
  var list = getHabitList();
  list = list.filter(function(h) { return h.id !== id; });
  saveHabitList(list);
  initCheckin();
}

function openAddHabitPopup2() {
  _selectedHabitIcon = '⭐';
  var nameInput = document.getElementById('newHabitName2');
  if (nameInput) nameInput.value = '';
  var picker = document.getElementById('habitIconPicker2');
  if (picker) {
    picker.innerHTML = '';
    _habitIconList.forEach(function(icon) {
      var btn = document.createElement('div');
      btn.style.cssText = 'font-size:24px;text-align:center;padding:6px;cursor:pointer;border-radius:8px;' + 
        (icon === _selectedHabitIcon ? 'background:#ffeaa7;' : '');
      btn.textContent = icon;
      btn.onclick = function() {
        _selectedHabitIcon = icon;
        var children = picker.children;
        for (var i = 0; i < children.length; i++) {
          children[i].style.background = '';
        }
        btn.style.background = '#ffeaa7';
      };
      picker.appendChild(btn);
    });
  }
  var popup = document.getElementById('addHabitPopup2');
  if (popup) popup.style.display = 'flex';
}

function closeAddHabitPopup2() {
  var popup = document.getElementById('addHabitPopup2');
  if (popup) popup.style.display = 'none';
}

function saveNewHabit2() {
  var nameInput = document.getElementById('newHabitName2');
  var name = nameInput ? nameInput.value.trim() : '';
  if (!name) {
    alert('请输入习惯名字');
    return;
  }
  var list = getHabitList();
  var newHabit = {
    id: 'h_' + Date.now(),
    name: name,
    icon: _selectedHabitIcon
  };
  list.push(newHabit);
  saveHabitList(list);
  closeAddHabitPopup2();
  initCheckin();
}

function toggleHabit(id) {
  var today = getTodayStr();
  var data = getCheckinData();
  if (!data[today]) data[today] = { habits: {}, hongen: data.hongen || 0 };
  data[today].habits[id] = !data[today].habits[id];
  
  if (data[today].habits[id]) {
    addStars(1);
  }
  
  saveCheckinData(data);
  initCheckin();
}

function changeHongenCount(delta) {
  var today = getTodayStr();
  var data = getCheckinData();
  if (!data.hongen) data.hongen = 0;
  data.hongen = Math.max(0, data.hongen + delta);
  if (!data[today]) data[today] = { habits: {}, hongen: data.hongen };
  data[today].hongen = data.hongen;
  saveCheckinData(data);
  var hc = document.getElementById('hongenCount2');
  if (hc) hc.textContent = data.hongen;
}

function calcStreak(data) {
  var streak = 0;
  var d = new Date();
  while (true) {
    var key = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
    if (data[key] && Object.values(data[key].habits).some(function(v) { return v; })) {
      streak++;
      d.setDate(d.getDate() - 1);
    } else {
      break;
    }
  }
  return streak;
}

