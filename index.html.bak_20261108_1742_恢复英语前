    var n2Label = cfg.n2Range.min + '~' + cfg.n2Range.max;
    var ansLabel = cfg.ansRange ? (cfg.ansRange.min + '~' + cfg.ansRange.max) : '不限';
    typeLabel = cfg.types.map(function(t) {
      if (t === '+') return '加法';
      if (t === '-') return '减法';
      return '混合';
    }).join('·');
    subLabel = (cfg.numCount === 3 ? '三数' : '两数') + ' · 数1:' + n1Label + ' · 数2:' + n2Label + ' · 结果:' + ansLabel + ' · ' + typeLabel + ' · 共' + problems.length + '题';
