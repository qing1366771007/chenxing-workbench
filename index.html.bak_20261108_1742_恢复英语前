var bioCurrentCat = '全部';
var bioCurrentIdx = -1;
var bioFilteredIdx = [];

function initBio() {
  bioCurrentIdx = -1;
  document.getElementById('bioDetail').style.display = 'none';
  document.getElementById('bioList').style.display = 'grid';
  renderBioCatBar();
  renderBioList();
}

function renderBioCatBar() {
  var bar = document.getElementById('bioCatBar');
  if (!bar) return;
  var cats = ['全部'];
  bioData.forEach(function(item) {
    if (item.cat && cats.indexOf(item.cat) === -1) cats.push(item.cat);
  });
  var html = '';
  cats.forEach(function(cat) {
    html += '<div class="bio-cat-btn ' + (bioCurrentCat === cat ? 'active' : '') + '" onclick="setBioCat(\'' + cat + '\')">' + cat + '</div>';
  });
  bar.innerHTML = html;
}

function setBioCat(cat) {
  bioCurrentCat = cat;
  bioCurrentIdx = -1;
  document.getElementById('bioDetail').style.display = 'none';
  document.getElementById('bioList').style.display = 'grid';
  renderBioCatBar();
  renderBioList();
}

function renderBioList() {
  var list = document.getElementById('bioList');
  if (!list) return;
  bioFilteredIdx = [];
  var html = '';
  bioData.forEach(function(item, idx) {
    if (bioCurrentCat !== '全部' && item.cat !== bioCurrentCat) return;
    bioFilteredIdx.push(idx);
    html += '<div class="bio-card" onclick="showBio(' + idx + ')">' +
      '<div class="bio-icon">' + item.icon + '</div>' +
      '<div class="bio-name">' + item.name + '</div>' +
      '<div class="bio-title">' + item.title + '</div>' +
      '<div class="bio-hint">点击查看 👆</div>' +
      '</div>';
  });
  list.innerHTML = html;
}

function showBio(idx) {
  bioCurrentIdx = idx;
  var item = bioData[idx];
  document.getElementById('bioList').style.display = 'none';
  document.getElementById('bioDetail').style.display = 'block';
  document.getElementById('bioIcon').textContent = item.icon;
  document.getElementById('bioName').textContent = item.name;
  document.getElementById('bioTitle').textContent = item.title;
  document.getElementById('bioIntro').textContent = item.intro;
  document.getElementById('bioAchieve').textContent = item.achieve;
  document.getElementById('bioQuote').textContent = item.quote;
  document.getElementById('mainArea').scrollTop = 0;
}

function bioBack() {
  bioCurrentIdx = -1;
  document.getElementById('bioDetail').style.display = 'none';
  document.getElementById('bioList').style.display = 'grid';
}

function readBio() {
  if (bioCurrentIdx < 0) return;
  var item = bioData[bioCurrentIdx];
  var text = item.name + '。' + item.title + '。' +
    '人物简介。' + item.intro +
    '主要成就。' + item.achieve +
    '名言。' + item.quote;
  speakZh(text);
}

function bioPrev() {
  if (bioFilteredIdx.length === 0) return;
  var pos = bioFilteredIdx.indexOf(bioCurrentIdx);
  if (pos <= 0) pos = bioFilteredIdx.length;
  showBio(bioFilteredIdx[pos - 1]);
}

function bioNext() {
  if (bioFilteredIdx.length === 0) return;
  var pos = bioFilteredIdx.indexOf(bioCurrentIdx);
  if (pos >= bioFilteredIdx.length - 1) pos = -1;
  showBio(bioFilteredIdx[pos + 1]);
}

