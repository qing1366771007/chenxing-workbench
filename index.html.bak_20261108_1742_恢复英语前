// 分类题库（正确项 + 干扰项）
const CATEGORY_BANK = [
  { cat: '水果', correct: EMOJI_FRUITS, distractors: [...EMOJI_ANIMALS, ...EMOJI_TRANSPORT, ...EMOJI_TOOLS] },
  { cat: '动物', correct: EMOJI_ANIMALS, distractors: [...EMOJI_FRUITS, ...EMOJI_TRANSPORT, ...EMOJI_TOOLS] },
