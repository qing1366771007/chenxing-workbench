// 听音选字模块
// ============================================================
let quizPool = [];
let quizCurrent = null;
let quizOptions = [];
let quizAnswered = false;
let quizScore = 0;
let quizRound = 0;
let quizMode = 'listen'; // 'listen' = 听音选字, 'pinyin' = 看拼音选字
let quizCurrentGroup = 0; // 当前第几组（0-9）
const QUIZ_TOTAL_GROUPS = 10;
const QUIZ_GROUP_SIZE = 20;
const QUIZ_ROUND_SIZE = QUIZ_GROUP_SIZE;
let quizGroups = []; // 10组，每组20字

function buildQuizGroups() {
  // 收集所有字
  var allChars = [];
  Object.values(hanzhiCategories).forEach(cat => {
    cat.forEach(item => allChars.push(item));
  });
  // 去重
  var seen = {};
  var unique = [];
  allChars.forEach(function(item) {
    if (!seen[item.c]) { seen[item.c] = true; unique.push(item); }
  });
  // 打乱顺序
  unique.sort(function() { return Math.random() - 0.5; });
  // 取前200个，分成10组每组20个
  quizGroups = [];
  for (var g = 0; g < QUIZ_TOTAL_GROUPS; g++) {
    quizGroups.push(unique.slice(g * QUIZ_GROUP_SIZE, (g + 1) * QUIZ_GROUP_SIZE));
  }
}

function initQuiz() {
  buildQuizGroups();
  quizCurrentGroup = 0;
  quizScore = 0;
  quizRound = -1;
  quizPool = quizGroups[0].slice();
  quizPool.sort(() => Math.random() - 0.5);
  renderQuizMode();
  nextQuiz();
}

function renderQuizMode() {
  const container = document.getElementById('quizContainer');
  // 分组进度条
  var groupBar = '<div class="quiz-group-bar">';
  for (var g = 0; g < QUIZ_TOTAL_GROUPS; g++) {
    groupBar += '<div class="quiz-group-dot ' + (g === quizCurrentGroup ? 'active' : '') +
      '" onclick="jumpQuizGroup(' + g + ')">' + (g + 1) + '</div>';
  }
  groupBar += '</div>';

  container.innerHTML = `
    <div class="quiz-mode-bar">
      <div class="quiz-mode-btn ${quizMode === 'listen' ? 'active' : ''}" onclick="setQuizMode('listen')">🔊 听音选字</div>
      <div class="quiz-mode-btn ${quizMode === 'pinyin' ? 'active' : ''}" onclick="setQuizMode('pinyin')">📖 看拼音选字</div>
    </div>
    ${groupBar}
    <div class="quiz-score-bar">
      <span>第 <span class="score-num" id="quizRoundNum">${quizRound + 1}</span> / ${QUIZ_ROUND_SIZE} 题</span>
      <span>⭐ 得分：<span class="score-num" id="quizScoreNum">${quizScore}</span></span>
    </div>
    <div class="quiz-card" id="quizCard"></div>
  `;
}

function setQuizMode(mode) {
  quizMode = mode;
  quizScore = 0;
  quizRound = -1;
  quizPool.sort(() => Math.random() - 0.5);
  renderQuizMode();
  nextQuiz();
}

function jumpQuizGroup(g) {
  quizCurrentGroup = g;
  quizScore = 0;
  quizRound = -1;
  quizPool = quizGroups[g].slice();
  quizPool.sort(() => Math.random() - 0.5);
  renderQuizMode();
  nextQuiz();
}

function nextQuiz() {
  quizRound++;
  if (quizRound >= QUIZ_ROUND_SIZE) {
    showQuizResult();
    return;
  }
  document.getElementById('quizRoundNum').textContent = quizRound + 1;
  document.getElementById('quizScoreNum').textContent = quizScore;
  quizAnswered = false;

  // Pick current character
  quizCurrent = quizPool[quizRound % quizPool.length];

  // Pick 3 wrong options (from all characters, not just current group)
  var allChars = [];
  Object.values(hanzhiCategories).forEach(cat => {
    cat.forEach(item => allChars.push(item));
  });
  var wrongs = allChars.filter(c => c.c !== quizCurrent.c);
  wrongs.sort(() => Math.random() - 0.5);
  quizOptions = [quizCurrent, wrongs[0], wrongs[1], wrongs[2]];
  quizOptions.sort(() => Math.random() - 0.5);

  const card = document.getElementById('quizCard');
  let promptText, hintHTML, playBtnHTML;

  if (quizMode === 'listen') {
    promptText = '🔊 听一听，选出正确的字';
    hintHTML = '<div class="quiz-hint">👂</div>';
    playBtnHTML = '<div class="quiz-play-btn" onclick="playQuizSound()">🔊</div>';
  } else {
    promptText = '📖 看拼音，选出正确的字';
    hintHTML = '<div class="quiz-hint">' + quizCurrent.p + '</div>';
    playBtnHTML = '<div class="quiz-play-btn" onclick="playQuizSound()" style="width:52px;height:52px;font-size:24px;">🔊</div>';
  }

  let optsHTML = '<div class="quiz-options">';
  quizOptions.forEach((opt, i) => {
    optsHTML += `<div class="quiz-opt" onclick="checkQuiz(${i})"><div>${opt.c}</div><div class="opt-pinyin">${opt.p}</div></div>`;
  });
  optsHTML += '</div>';

  card.innerHTML = `
    <div class="quiz-prompt">${promptText}</div>
    ${hintHTML}
    ${playBtnHTML}
    ${optsHTML}
    <div class="quiz-feedback" id="quizFeedback"></div>
    <button class="quiz-next-btn" id="quizNextBtn" onclick="nextQuiz()" style="display:none;">下一题 ➡️</button>
  `;

  // Auto play sound for listen mode
  if (quizMode === 'listen') {
    speakQuestion(quizCurrent.c);
  } else {
    speakQuestion('看拼音，选出正确的字');
  }
}

function playQuizSound() {
  if (quizCurrent) speakZh(quizCurrent.c);
}

function checkQuiz(idx) {
  if (quizAnswered) return;
  quizAnswered = true;
  const opts = document.querySelectorAll('#quizCard .quiz-opt');
  const correctIdx = quizOptions.indexOf(quizCurrent);
  opts.forEach((o, i) => {
    if (i === correctIdx) o.classList.add('correct');
    else if (i === idx) o.classList.add('wrong');
  });
  const fb = document.getElementById('quizFeedback');
  if (idx === correctIdx) {
    fb.textContent = '🎉 答对了！' + quizCurrent.c + ' = ' + quizCurrent.p;
    fb.className = 'quiz-feedback ok';
    quizScore++;
    document.getElementById('quizScoreNum').textContent = quizScore;
    addStars(1);
    onCorrect('答对了！');
  } else {
    fb.textContent = '💪 正确答案是「' + quizCurrent.c + '」(' + quizCurrent.p + ')';
    fb.className = 'quiz-feedback no';
    onWrong();
    setTimeout(function() { speakZh(quizCurrent.c); }, 600);
  }
  document.getElementById('quizNextBtn').style.display = 'block';
}

function showQuizResult() {
  const container = document.getElementById('quizContainer');
  var rate = quizScore / QUIZ_ROUND_SIZE;
  let emoji, title;
  if (rate >= 0.95) { emoji = '🏆'; title = '太棒了！你是汉字小达人！'; }
  else if (rate >= 0.8) { emoji = '🌟'; title = '很厉害！继续加油！'; }
  else if (rate >= 0.6) { emoji = '😊'; title = '不错哦，再练练吧！'; }
  else { emoji = '💪'; title = '没关系，多练习会更好！'; }

  var isLastGroup = quizCurrentGroup >= QUIZ_TOTAL_GROUPS - 1;
  var nextBtn = isLastGroup
    ? '<button class="restart-btn" onclick="initQuiz()">🔄 重新开始全部</button>'
    : '<button class="restart-btn" onclick="nextQuizGroup()">➡️ 下一组（第' + (quizCurrentGroup + 2) + '组）</button>';

  // 分组进度条
  var groupBar = '<div class="quiz-group-bar">';
  for (var g = 0; g < QUIZ_TOTAL_GROUPS; g++) {
    groupBar += '<div class="quiz-group-dot ' + (g === quizCurrentGroup ? 'active' : '') +
      '" onclick="jumpQuizGroup(' + g + ')">' + (g + 1) + '</div>';
  }
  groupBar += '</div>';

  container.innerHTML = `
    ${groupBar}
    <div class="quiz-result">
      <div class="big-emoji">${emoji}</div>
      <div class="result-title">${title}</div>
      <div class="result-score">第 ${quizCurrentGroup + 1} 组 · 得分：${quizScore} / ${QUIZ_ROUND_SIZE} ⭐</div>
      ${nextBtn}
      <button class="restart-btn" style="margin-top:8px;background:var(--star-orange);" onclick="jumpQuizGroup(${quizCurrentGroup})">🔄 重练本组</button>
    </div>
  `;
  if (rate >= 0.8) {
    showReward('第' + (quizCurrentGroup + 1) + '组闯关成功！', '获得' + quizScore + '颗星星');
  }
}

function nextQuizGroup() {
  if (quizCurrentGroup >= QUIZ_TOTAL_GROUPS - 1) {
    initQuiz();
    return;
  }
  quizCurrentGroup++;
  quizScore = 0;
  quizRound = -1;
  quizPool = quizGroups[quizCurrentGroup].slice();
  quizPool.sort(() => Math.random() - 0.5);
  renderQuizMode();
  nextQuiz();
}

