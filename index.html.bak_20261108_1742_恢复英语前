.draw-tpl-card .tpl-emoji { font-size:28px; }
.draw-tpl-card .tpl-label { font-size:11px; color:var(--text-light); }
.draw-tpl-card .tpl-num { font-size:20px; font-weight:700; color:var(--star-pink); }
.draw-guide-box {
