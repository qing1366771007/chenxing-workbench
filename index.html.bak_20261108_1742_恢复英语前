  saveGoal();
}

function saveGoal() {
  try { localStorage.setItem('chenxing_goals', JSON.stringify(goalData)); } catch(e) {}
}

function initGoal() {
  loadGoal();
  renderGoal();
}

function renderGoal() {
  var list = document.getElementById('goalList');
  if (!list) return;
  var html = '';
  goalData.forEach(function(g, idx) {
    html += '<div class="goal-card ' + (g.done ? 'done' : '') + '">' +
      '<div class="goal-check" onclick="toggleGoal(' + idx + ')">' + (g.done ? '✓' : '') + '</div>' +
      '<div class="goal-content">' +
      '<span class="goal-icon">' + (g.icon || '🎯') + '</span>' +
      '<span class="goal-text">' + (g.text || '') + '</span>' +
      (g.desc ? '<div class="goal-desc">' + g.desc + '</div>' : '') +
      '</div>' +
      '<button class="goal-del-btn" onclick="delGoal(' + idx + ')" title="删除">✕</button>' +
      '</div>';
  });
  list.innerHTML = html;

  var done = goalData.filter(function(g) { return g.done; }).length;
  var total = goalData.length;
  var pct = total > 0 ? Math.round(done / total * 100) : 0;
  var fill = document.getElementById('goalProgressFill');
  var txt = document.getElementById('goalProgressText');
  var celeb = document.getElementById('goalCelebrate');
  if (fill) fill.style.width = pct + '%';
  if (txt) txt.textContent = done + '/' + total;
  if (celeb) {
    if (total > 0 && done === total) celeb.classList.add('show');
    else celeb.classList.remove('show');
  }
}

function toggleGoal(idx) {
  if (goalData[idx]) {
    goalData[idx].done = !goalData[idx].done;
    saveGoal();
    renderGoal();
  }
}

function addGoal() {
  var input = document.getElementById('goalAddInput');
  if (!input) return;
  var text = input.value.trim();
  if (!text) return;
  goalData.push({
    id: 'g' + Date.now(),
    icon: '🎯',
    text: text,
    desc: '',
    done: false
  });
  input.value = '';
  saveGoal();
  renderGoal();
}

function delGoal(idx) {
  goalData.splice(idx, 1);
  saveGoal();
  renderGoal();
}

