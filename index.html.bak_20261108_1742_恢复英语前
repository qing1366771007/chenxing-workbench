    var pageProblems = problems.slice(pageStart, pageEnd);
    var half = Math.ceil(pageProblems.length / 2);
    var topHalf = pageProblems.slice(0, half);
    var bottomHalf = pageProblems.slice(half);

    if (p > 0) {
      html += '<div class="page-wrap" style="page-break-before:always;">';
    } else {
      html += '<div class="page-wrap">';
    }
    html += buildHalf(topHalf, false, p + 1, 1);
    html += '<div class="cut-line"></div>';
    html += buildHalf(bottomHalf, false, p + 1, 2);
