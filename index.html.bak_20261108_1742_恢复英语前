}
.draw-guide-hint { font-size:13px; color:var(--text-light); margin-top:8px; font-style:italic; }

/* ========== 汉字模块 ========== */
#module-hanzi .module-header { background:rgba(108,92,231,0.9); color:#fff; }
.hz-card {
  aspect-ratio:1; border-radius:var(--radius-sm); background:#fff;
