var shpCurrentCat = 'all';
var shpCurrentIdx = -1;

function initShapes() {
  renderShpCatBar();
  renderShpList();
}

function renderShpCatBar() {
  var cats = [
    { id: 'all', name: '全部' },
    { id: 'shape', name: '认识图形' },
    { id: 'concept', name: '边长·周长·面积' }
  ];
  var html = '';
  cats.forEach(function(c) {
    var cls = c.id === shpCurrentCat ? 'shp-cat-btn active' : 'shp-cat-btn';
    html += '<button class="' + cls + '" onclick="setShpCat(\'' + c.id + '\')">' + c.name + '</button>';
  });
  document.getElementById('shpCatBar').innerHTML = html;
}

function setShpCat(cat) {
  shpCurrentCat = cat;
  shpCurrentIdx = -1;
  renderShpCatBar();
  renderShpList();
  document.getElementById('shpDetail').style.display = 'none';
  document.getElementById('shpList').style.display = 'grid';
}

function renderShpList() {
  var list = shpCurrentCat === 'all' ? shapeData : shapeData.filter(function(s) { return s.cat === shpCurrentCat; });
  var html = '';
  list.forEach(function(s, i) {
    var realIdx = shapeData.indexOf(s);
    html += '<div class="shp-card" onclick="showShp(' + realIdx + ')" style="border-top-color:' + s.color + '">';
    html += '<div class="shp-svg">' + s.svg + '</div>';
    html += '<div class="shp-name">' + s.name + '</div>';
    html += '<div class="shp-hint">' + (s.cat === 'shape' ? '点击查看' : '点击学习') + '</div>';
    html += '</div>';
  });
  document.getElementById('shpList').innerHTML = html;
}

function showShp(idx) {
  if (idx < 0 || idx >= shapeData.length) return;
  shpCurrentIdx = idx;
  var s = shapeData[idx];
  document.getElementById('shpSvg').innerHTML = s.svg;
  document.getElementById('shpName').textContent = s.name;
  document.getElementById('shpName').style.color = s.color;
  document.getElementById('shpDesc').textContent = s.desc;

  var partsBar = document.getElementById('shpPartsBar');
  if (s.parts && s.parts.length > 0) {
    var pHtml = '';
    s.parts.forEach(function(p, i) {
      pHtml += '<button class="shp-part-btn" onclick="shpSelectPart(' + i + ')">' + p.label + '</button>';
    });
    partsBar.innerHTML = pHtml;
    partsBar.style.display = 'flex';
  } else {
    partsBar.innerHTML = '';
    partsBar.style.display = 'none';
  }

  var featHtml = '';
  s.features.forEach(function(f, i) {
    featHtml += '<li class="shp-feature-item" onclick="readShpFeature(' + i + ')">' + f + '</li>';
  });
  document.getElementById('shpFeatures').innerHTML = featHtml;

  var formulaSection = document.getElementById('shpFormulaSection');
  if (s.formula) {
    formulaSection.style.display = 'block';
    var fHtml = '';
    if (s.formula.perimeter) fHtml += '<div class="shp-formula-title">周长公式</div><div>' + s.formula.perimeter + '</div>';
    if (s.formula.area) fHtml += '<div class="shp-formula-title" style="margin-top:8px;">面积公式</div><div>' + s.formula.area + '</div>';
    document.getElementById('shpFormula').innerHTML = fHtml;
  } else {
    formulaSection.style.display = 'none';
  }

  document.getElementById('shpExamples').textContent = s.examples;

  document.getElementById('shpList').style.display = 'none';
  document.getElementById('shpDetail').style.display = 'block';
  document.getElementById('mainArea').scrollTop = 0;
}

function shpSelectPart(i) {
  if (shpCurrentIdx < 0) return;
  var s = shapeData[shpCurrentIdx];
  if (!s.parts || !s.parts[i]) return;
  var p = s.parts[i];
  var svgEl = document.getElementById('shpSvg');
  svgEl.innerHTML = p.svg;
  svgEl.classList.remove('pulse');
  void svgEl.offsetWidth;
  svgEl.classList.add('pulse');
  var btns = document.querySelectorAll('#shpPartsBar .shp-part-btn');
  btns.forEach(function(b, j) { b.classList.toggle('active', j === i); });
  speakZh(p.audio);
}

function readShpFeature(i) {
  if (shpCurrentIdx < 0) return;
  var s = shapeData[shpCurrentIdx];
  if (!s.features[i]) return;
  speakZh(s.features[i]);
}

function shpBack() {
  shpCurrentIdx = -1;
  document.getElementById('shpDetail').style.display = 'none';
  document.getElementById('shpList').style.display = 'grid';
}

function shpPrev() {
  var list = shpCurrentCat === 'all' ? shapeData : shapeData.filter(function(s) { return s.cat === shpCurrentCat; });
  var currentPos = list.indexOf(shapeData[shpCurrentIdx]);
  if (currentPos <= 0) currentPos = list.length;
  var prevItem = list[currentPos - 1];
  showShp(shapeData.indexOf(prevItem));
}

function shpNext() {
  var list = shpCurrentCat === 'all' ? shapeData : shapeData.filter(function(s) { return s.cat === shpCurrentCat; });
  var currentPos = list.indexOf(shapeData[shpCurrentIdx]);
  if (currentPos >= list.length - 1) currentPos = -1;
  var nextItem = list[currentPos + 1];
  showShp(shapeData.indexOf(nextItem));
}

function readShp() {
  if (shpCurrentIdx < 0) return;
  var s = shapeData[shpCurrentIdx];
  var text = s.name + '。' + s.desc + '。特点：' + s.features.join('，') + '。';
  if (s.formula) {
    if (s.formula.perimeter) text += s.formula.perimeter + '。';
    if (s.formula.area) text += s.formula.area + '。';
  }
  text += '生活中的例子：' + s.examples + '。';
  speakZh(text);
}

