    probs.forEach(function(p, i) {
      h += '<div class="problem">';
      h += '<span class="prob-num">' + (i + 1) + '</span>';
      h += '<span class="eq">' + _formatProblem(p, showAns) + '</span>';
      h += '</div>';
    });
    h += '</div>';
    h += '</div>';
    return h;
  }

  var html = '<!DOCTYPE html><html><head><meta charset="utf-8">';
  html += '<title>数学练习题册 - ' + typeLabel + '</title>';
  html += '<style>';
  html += '@page { size:A4 landscape; margin:0.5cm; }';
  html += '* { box-sizing:border-box; }';
  html += 'html, body { width:100%; margin:0; padding:0; }';
  html += 'body { font-family:"Microsoft YaHei","PingFang SC","Noto Sans CJK SC",sans-serif; color:#333; }';
  html += '.page-wrap { display:flex; flex-direction:row; height:100vh; }';
  html += '.half { flex:1; display:flex; flex-direction:column; overflow:hidden; }';
  html += '.half.half-left { padding-right:1cm; }';
  html += '.half.half-right { padding-left:1cm; }';
  html += '.cut-line { flex:none; width:0; border-left:2px dashed #aaa; position:relative; }';
  html += '.cut-line::after { content:"✂ 裁剪线"; position:absolute; bottom:0; left:-20px; background:#fff; padding:2px 4px; font-size:9px; color:#999; writing-mode:vertical-rl; }';
  html += '.print-header { text-align:center; margin-bottom:4px; padding-bottom:3px; border-bottom:1px solid #333; }';
  html += '.print-header h1 { font-size:14px; margin:0; }';
  html += '.print-header .sub { font-size:9px; color:#666; margin-top:2px; }';
  if (cfg.showName) {
    html += '.print-name-row { display:flex; justify-content:space-between; margin-bottom:5px; font-size:10px; }';
    html += '.print-name-row span { flex:1; text-align:center; }';
  }
  html += '.problems { display:grid; grid-template-columns:repeat(' + cfg.cols + ',1fr); gap:' + gap + '; flex:1; align-content:start; }';
  html += '.problem { font-size:' + fontSize + '; padding:' + pad + '; display:flex; align-items:baseline; line-height:' + lineHeight + '; }';
  html += '.problem .num { color:#999; font-size:8px; margin-right:2px; min-width:14px; }';
  html += '.problem .prob-num { display:inline-flex; align-items:center; justify-content:center; width:16px; height:16px; border:1.2px solid #888; border-radius:50%; font-size:10px; color:#666; margin-right:3px; flex-shrink:0; line-height:1; font-weight:600; }';
  html += '.problem .eq { flex:1; font-weight:700; }';
  html += '.problem .blank { display:inline-block; min-width:22px; border-bottom:1px solid #333; }';
  html += '.problem .blank-op { display:inline-block; min-width:20px; text-align:center; }';
  html += '.answer-page .problem { color:#e74c3c; }';
  html += '@media print { .no-print { display:none; } body { -webkit-print-color-adjust:exact; print-color-adjust:exact; } .page-wrap { height:100vh; overflow:hidden; } }';
  html += '</style></head><body>';

  // 题目页：每页上下两半
  for (var p = 0; p < totalPages; p++) {
    var pageStart = p * perPage;
    var pageEnd = Math.min(pageStart + perPage, problems.length);
    var pageProblems = problems.slice(pageStart, pageEnd);
    var half = Math.ceil(pageProblems.length / 2);
    var topHalf = pageProblems.slice(0, half);
    var bottomHalf = pageProblems.slice(half);

    if (p > 0) {
      html += '<div class="page-wrap" style="page-break-before:always;">';
    } else {
      html += '<div class="page-wrap">';
    }
    html += buildHalf(topHalf, false, p + 1, 1);
    html += '<div class="cut-line"></div>';
    html += buildHalf(bottomHalf, false, p + 1, 2);
    html += '</div>';
  }

  // 答案页
  if (cfg.showAnswer) {
    for (var ap = 0; ap < totalPages; ap++) {
      var aStart = ap * perPage;
      var aEnd = Math.min(aStart + perPage, problems.length);
      var aProblems = problems.slice(aStart, aEnd);
      var aHalf = Math.ceil(aProblems.length / 2);
      var aTop = aProblems.slice(0, aHalf);
      var aBottom = aProblems.slice(aHalf);

      html += '<div class="page-wrap answer-page" style="page-break-before:always;">';
      html += buildHalf(aTop, true, ap + 1, 1);
      html += '<div class="cut-line"></div>';
      html += buildHalf(aBottom, true, ap + 1, 2);
      html += '</div>';
    }
  }

  html += '</body></html>';
  return html;
}
function _printViaIframe(html, autoPrint) {
  // Remove old iframe if exists
  var old = document.getElementById('_mathPrintFrame');
  if (old) old.parentNode.removeChild(old);

  var iframe = document.createElement('iframe');
  iframe.id = '_mathPrintFrame';
  iframe.style.cssText = 'position:fixed;left:-9999px;top:0;width:0;height:0;border:none;';
  document.body.appendChild(iframe);

  var doc = iframe.contentWindow.document;
  doc.open();
  doc.write(html);
  doc.close();

  // Wait for content to load, then print
  iframe.onload = function() {
    if (autoPrint) {
      try {
        iframe.contentWindow.focus();
        iframe.contentWindow.print();
      } catch(e) {
        console.log('Iframe print error:', e);
        // Fallback: try window.open
        _printViaWindowOpen(html, autoPrint);
      }
    }
  };

  // Also try after 500ms in case onload doesn't fire
  if (autoPrint) {
    setTimeout(function() {
      try {
        if (iframe.contentWindow) {
          iframe.contentWindow.focus();
          iframe.contentWindow.print();
        }
      } catch(e) {}
    }, 500);
  }
}

function _printViaWindowOpen(html, autoPrint) {
  var w = window.open('', '_blank');
  if (!w) {
    alert('请允许弹出窗口以打印题册');
    return;
  }
  w.document.write(html);
  w.document.close();
  try { w.focus(); } catch(e) {}
  if (autoPrint) {
    setTimeout(function() {
      try { w.print(); } catch(e) {}
    }, 500);
  }
}

