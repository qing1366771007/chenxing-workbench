// ============================================================
// 移动端 AudioContext 解锁（首次用户交互时激活）
// 手机浏览器要求用户交互后才能播放音效，这里统一处理
// ============================================================
function _unlockAudio() {
  var ctx = _getSoundCtx();
  if (ctx && ctx.state === 'suspended') {
    ctx.resume();
  }
  // 同时尝试播放一个静音音符来彻底解锁
  if (ctx) {
    try {
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      gain.gain.value = 0; // 静音
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.001);
    } catch(e) {}
  }
}
// 监听首次交互（touch/click），只需一次
var _audioUnlocked = false;
function _onFirstInteraction(e) {
  if (_audioUnlocked) return;
  _audioUnlocked = true;
  _unlockAudio();
  document.removeEventListener('touchstart', _onFirstInteraction);
  document.removeEventListener('click', _onFirstInteraction);
}
document.addEventListener('touchstart', _onFirstInteraction, { passive: true });
document.addEventListener('click', _onFirstInteraction);

