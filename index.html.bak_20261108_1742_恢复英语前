  var o = bones[idx];
  document.querySelectorAll('.body-hotspot').forEach(function(b){
    b.style.background = 'rgba(255,255,255,0.7)';
    b.style.color = '#0984e3';
    b.style.border = 'none';
  });
  document.querySelectorAll('.body-hotspot[data-idx="' + idx + '"]').forEach(function(b){
    b.style.background = 'rgba(255,118,117,0.5)';
    b.style.color = '#fff';
    b.style.borderRadius = '4px';
  });
  var text = o.name + '。' + o.func;
  speakZh(text);
