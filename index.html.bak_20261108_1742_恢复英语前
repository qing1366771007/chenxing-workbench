<script type="text/legacy">
// ============================================================
// 云端同步配置
// ============================================================
var CLOUD_ENABLED = true; // 是否启用云端
var CLOUD_API = 'https://chenxing-workbench.onrender.com/api';    // API地址（云端部署）
var currentUser = null;    // 当前用户
var selectedAvatar = '👦'; // 注册时选择的头像

// ============================================================
// PWA 注册（添加到主屏幕 + 离线缓存）
// ============================================================
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('sw.js').then(function(reg) {
      console.log('✅ PWA Service Worker 已注册:', reg.scope);
    }).catch(function(err) {
      console.warn('⚠️ PWA 注册失败:', err);
    });
  });
}

// 检测是否在服务器上运行（支持云端）
function checkCloudAvailable() {
  return window.location.protocol === 'http:' || window.location.protocol === 'https:';
}

// ============================================================
// 云端 API 封装
// ============================================================
function api(url, options) {
  options = options || {};
  var token = localStorage.getItem('cx_token');
  var headers = options.headers || {};
  headers['Content-Type'] = 'application/json';
  if (token) headers['Authorization'] = 'Bearer ' + token;
  
  return fetch(CLOUD_API + url, {
    method: options.method || 'GET',
    headers: headers,
    body: options.body ? JSON.stringify(options.body) : undefined
  }).then(function(res) {
    return res.json().then(function(data) {
      if (res.status === 401) {
        // token过期，退出登录
        doLogout(true);
        throw new Error(data.error || '登录已过期');
      }
      if (!res.ok) throw new Error(data.error || '请求失败');
      return data;
    });
  });
}

// 保存数据到云端（异步，不阻塞）
function saveToCloud(key, value) {
  if (!CLOUD_ENABLED || !currentUser) return;
  api('/data/' + key, { method: 'POST', body: value }).catch(function(e) {
    console.warn('云端保存失败:', key, e.message);
  });
}

// 记录学习日志
function logStudy(module, action, detail, score) {
  if (!CLOUD_ENABLED || !currentUser) return;
  api('/log', {
    method: 'POST',
    body: { module: module, action: action, detail: detail || '', score: score || 0 }
  }).catch(function(e) {});
}

