function _genMathProblems(cfg) {
  var problems = [];
  var n1Min = cfg.n1Range.min, n1Max = cfg.n1Range.max;
  var n2Min = cfg.n2Range.min, n2Max = cfg.n2Range.max;
  var aMin = cfg.ansRange ? cfg.ansRange.min : null;
  var aMax = cfg.ansRange ? cfg.ansRange.max : null;
  var numCount = cfg.numCount || 2;

  for (var i = 0; i < cfg.count; i++) {
    var type;
    if (cfg.types.length === 1 && cfg.types[0] === 'mix') {
      type = Math.random() > 0.5 ? '+' : '-';
    } else if (cfg.types.length === 1) {
      type = cfg.types[0];
    } else {
      type = cfg.types[Math.floor(Math.random() * cfg.types.length)];
      if (type === 'mix') type = Math.random() > 0.5 ? '+' : '-';
    }

    var attempts = 0;
    var valid = false;

    if (numCount === 3) {
      // Three-number problems: a op1 b op2 c = ans
      var n3Min = cfg.n3Range ? cfg.n3Range.min : n2Min;
      var n3Max = cfg.n3Range ? cfg.n3Range.max : n2Max;
      var a, b, c, ans, op1, op2;
      while (attempts < 50 && !valid) {
        attempts++;
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;
        c = Math.floor(Math.random() * (n3Max - n3Min + 1)) + n3Min;
        op1 = type === '+' ? '+' : (type === '-' ? '-' : (Math.random() > 0.5 ? '+' : '-'));
        op2 = type === '+' ? '+' : (type === '-' ? '-' : (Math.random() > 0.5 ? '+' : '-'));

        var step1 = op1 === '+' ? a + b : a - b;
        if (step1 < 0) continue;
        ans = op2 === '+' ? step1 + c : step1 - c;
        if (ans < 0) continue;

        if (aMin !== null && ans < aMin) continue;
        if (aMax !== null && ans > aMax) continue;
        valid = true;
      }
      if (!valid) {
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;
        c = Math.floor(Math.random() * (n3Max - n3Min + 1)) + n3Min;
        op1 = '+'; op2 = '-';
        ans = a + b - c;
        if (ans < 0) { ans = a - b + c; op1 = '-'; op2 = '+'; }
        if (ans < 0) { ans = a + b + c; op1 = '+'; op2 = '+'; }
      }
      var blank = cfg.blanks[Math.floor(Math.random() * cfg.blanks.length)];
      problems.push({ a: a, b: b, c: c, op1: op1, op2: op2, ans: ans, blank: blank, numCount: 3 });
    } else {
      // Two-number problems (original)
      var a, b, ans;
      while (attempts < 50 && !valid) {
        attempts++;
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;

        if (type === '+') {
          ans = a + b;
        } else {
          if (a < b) { var tmp = a; a = b; b = tmp; }
          ans = a - b;
        }
        if (aMin !== null && ans < aMin) continue;
        if (aMax !== null && ans > aMax) continue;
        valid = true;
      }
      if (!valid) {
        a = Math.floor(Math.random() * (n1Max - n1Min + 1)) + n1Min;
        b = Math.floor(Math.random() * (n2Max - n2Min + 1)) + n2Min;
        if (type === '-') { if (a < b) { var t2 = a; a = b; b = t2; } }
        ans = type === '+' ? a + b : a - b;
      }
      var blank = cfg.blanks[Math.floor(Math.random() * cfg.blanks.length)];
      problems.push({ a: a, b: b, op: type, ans: ans, blank: blank, numCount: 2 });
    }
  }
  return problems;
}
function _formatProblem(p, showAnswer) {
  // 乘法/除法题目
  if (p.isMulDiv) {
    var aStr, bStr, ansStr;
    if (showAnswer) {
      return p.a + ' ' + p.op + ' ' + p.b + ' = ' + p.ans;
    }
    if (p.blank === 'a') {
      aStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>';
      bStr = p.b;
      ansStr = p.ans;
    } else if (p.blank === 'b') {
      aStr = p.a;
      bStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>';
      ansStr = p.ans;
    } else {
      aStr = p.a;
      bStr = p.b;
      ansStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>';
    }
    return aStr + ' ' + p.op + ' ' + bStr + ' = ' + ansStr;
  }

  // Three-number problems
  if (p.numCount === 3) {
    if (showAnswer) {
      return p.a + ' ' + p.op1 + ' ' + p.b + ' ' + p.op2 + ' ' + p.c + ' = ' + p.ans;
    }
    var aStr, bStr, cStr, op1Str, op2Str, ansStr;
    aStr = p.blank === 'n1' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.a;
    op1Str = p.blank === 'op' ? '<span class="blank-op">○</span>' : p.op1;
    bStr = p.blank === 'n2' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.b;
    op2Str = p.blank === 'op' ? '<span class="blank-op">○</span>' : p.op2;
    cStr = p.blank === 'n3' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.c;
    ansStr = p.blank === 'ans' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.ans;
    return aStr + ' ' + op1Str + ' ' + bStr + ' ' + op2Str + ' ' + cStr + ' = ' + ansStr;
  }

  // Two-number problems (original)
  var blank = showAnswer ? null : p.blank;
  var aStr, bStr, opStr, ansStr;
  if (blank === 'n1') { aStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>'; } else { aStr = p.a; }
  if (blank === 'op') { opStr = '<span class="blank-op">○</span>'; } else { opStr = p.op; }
  if (blank === 'n2') { bStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>'; } else { bStr = p.b; }
  if (blank === 'ans') { ansStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>'; } else { ansStr = p.ans; }
  if (showAnswer) { return p.a + ' ' + p.op + ' ' + p.b + ' = ' + p.ans; }
  return aStr + ' ' + opStr + ' ' + bStr + ' = ' + ansStr;
}
function _genMulProblems(cfg) {
  var problems = [];
  var range = cfg.mulRange || 9;
  var op = cfg.opMode === 'div' ? '÷' : '×';

  // 生成所有口诀
  var allFormulas = [];
  for (var a = 1; a <= range; a++) {
    for (var b = a; b <= range; b++) {
      allFormulas.push({ a: a, b: b, ans: a * b });
    }
  }

  // 按顺序出题
  if (cfg.mulOrder && !cfg.mulRandom) {
    for (var i = 0; i < cfg.count; i++) {
      var idx = i % allFormulas.length;
      var f = allFormulas[idx];
      var blank = cfg.mulReverse && Math.random() > 0.6 ? (Math.random() > 0.5 ? 'a' : 'b') : 'ans';
      if (cfg.opMode === 'div') {
        // 除法：ans ÷ a = b
        problems.push({ a: f.ans, b: f.a, ans: f.b, op: '÷', blank: blank === 'ans' ? 'ans' : (blank === 'a' ? 'a' : 'b'), isMulDiv: true });
      } else {
        problems.push({ a: f.a, b: f.b, ans: f.ans, op: op, blank: blank, isMulDiv: true });
      }
    }
    return problems;
  }

  // 随机打乱出题
  for (var j = 0; j < cfg.count; j++) {
    var randIdx = Math.floor(Math.random() * allFormulas.length);
    var rf = allFormulas[randIdx];
    var rblank = 'ans';

    if (cfg.mulReverse) {
      var rType = Math.random();
      if (rType < 0.4) rblank = 'ans';      // 40% 正向填空（结果）
      else if (rType < 0.7) rblank = 'a';   // 30% 填空第一个数
      else rblank = 'b';                    // 30% 填空第二个数
    }

    if (cfg.opMode === 'div') {
      // 除法：ans ÷ a = b，需要调整blank
      if (rblank === 'ans') {
