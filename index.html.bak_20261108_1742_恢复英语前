      bStr = p.b;
      ansStr = p.ans;
    } else if (p.blank === 'b') {
      aStr = p.a;
      bStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>';
      ansStr = p.ans;
    } else {
      aStr = p.a;
      bStr = p.b;
      ansStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>';
    }
    return aStr + ' ' + p.op + ' ' + bStr + ' = ' + ansStr;
  }

  // Three-number problems
  if (p.numCount === 3) {
    if (showAnswer) {
      return p.a + ' ' + p.op1 + ' ' + p.b + ' ' + p.op2 + ' ' + p.c + ' = ' + p.ans;
    }
    var aStr, bStr, cStr, op1Str, op2Str, ansStr;
    aStr = p.blank === 'n1' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.a;
    op1Str = p.blank === 'op' ? '<span class="blank-op">○</span>' : p.op1;
    bStr = p.blank === 'n2' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.b;
    op2Str = p.blank === 'op' ? '<span class="blank-op">○</span>' : p.op2;
    cStr = p.blank === 'n3' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.c;
    ansStr = p.blank === 'ans' ? '<span class="blank">&nbsp;&nbsp;&nbsp;</span>' : p.ans;
    return aStr + ' ' + op1Str + ' ' + bStr + ' ' + op2Str + ' ' + cStr + ' = ' + ansStr;
  }

  // Two-number problems (original)
  var blank = showAnswer ? null : p.blank;
  var aStr, bStr, opStr, ansStr;
  if (blank === 'n1') { aStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>'; } else { aStr = p.a; }
  if (blank === 'op') { opStr = '<span class="blank-op">○</span>'; } else { opStr = p.op; }
  if (blank === 'n2') { bStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>'; } else { bStr = p.b; }
  if (blank === 'ans') { ansStr = '<span class="blank">&nbsp;&nbsp;&nbsp;</span>'; } else { ansStr = p.ans; }
  if (showAnswer) { return p.a + ' ' + p.op + ' ' + p.b + ' = ' + p.ans; }
  return aStr + ' ' + opStr + ' ' + bStr + ' = ' + ansStr;
}
function _genMulProblems(cfg) {
  var problems = [];
  var range = cfg.mulRange || 9;
  var op = cfg.opMode === 'div' ? '÷' : '×';

  // 生成所有口诀
  var allFormulas = [];
  for (var a = 1; a <= range; a++) {
    for (var b = a; b <= range; b++) {
      allFormulas.push({ a: a, b: b, ans: a * b });
    }
  }

  // 按顺序出题
  if (cfg.mulOrder && !cfg.mulRandom) {
    for (var i = 0; i < cfg.count; i++) {
      var idx = i % allFormulas.length;
      var f = allFormulas[idx];
      var blank = cfg.mulReverse && Math.random() > 0.6 ? (Math.random() > 0.5 ? 'a' : 'b') : 'ans';
      if (cfg.opMode === 'div') {
        // 除法：ans ÷ a = b
        problems.push({ a: f.ans, b: f.a, ans: f.b, op: '÷', blank: blank === 'ans' ? 'ans' : (blank === 'a' ? 'a' : 'b'), isMulDiv: true });
