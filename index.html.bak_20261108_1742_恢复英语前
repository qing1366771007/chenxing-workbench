// 画板模块（扩充内容）
// ============================================================
let drawCtx = null, drawColor = '#333333', drawSize = 6;
let drawDrawing = false, drawLastX = 0, drawLastY = 0;
let isEraser = false;
const drawColorsList = ['#333333', '#e74c3c', '#e67e22', '#f1c40f', '#2ecc71', '#3498db', '#9b59b6', '#fd79a8', '#ffffff', '#95a5a6'];
// 画画模板数据（简单几何图形）
const drawShapes = [
  { name: '正方形', icon: '⬜', type: 'rect' },
  { name: '长方形', icon: '▭', type: 'rectTall' },
  { name: '圆形', icon: '⭕', type: 'circle' },
  { name: '椭圆', icon: '⬭', type: 'oval' },
  { name: '三角形', icon: '🔺', type: 'triangle' },
  { name: '五角星', icon: '⭐', type: 'star' },
  { name: '菱形', icon: '🔷', type: 'diamond' },
  { name: '心形', icon: '❤️', type: 'heart' },
  { name: '箭头', icon: '➡️', type: 'arrow' },
  { name: '十字', icon: '✚', type: 'cross' },
  { name: '波浪线', icon: '〰️', type: 'wave' },
  { name: '螺旋', icon: '🌀', type: 'spiral' },
];

function initDrawing() {
  const canvas = document.getElementById('drawCanvas');
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  if (rect.width === 0) return;
  canvas.width = rect.width * dpr;
  canvas.height = 300 * dpr;
  canvas.style.height = '300px';
  drawCtx = canvas.getContext('2d');
  drawCtx.scale(dpr, dpr);
  drawCtx.lineCap = 'round'; drawCtx.lineJoin = 'round';
  drawCtx.fillStyle = '#ffffff';
  drawCtx.fillRect(0, 0, rect.width, 300);

  function pos(e) {
    const r = canvas.getBoundingClientRect();
    if (e.touches && e.touches[0]) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }
  function start(e) {
    e.preventDefault(); drawDrawing = true;
    const p = pos(e); drawLastX = p.x; drawLastY = p.y;
    drawCtx.beginPath(); drawCtx.arc(p.x, p.y, drawSize / 2, 0, Math.PI * 2);
    drawCtx.fillStyle = isEraser ? '#ffffff' : drawColor; drawCtx.fill();
  }
  function move(e) {
    if (!drawDrawing) return; e.preventDefault();
    const p = pos(e);
    drawCtx.strokeStyle = isEraser ? '#ffffff' : drawColor;
    drawCtx.lineWidth = isEraser ? drawSize * 3 : drawSize;
    drawCtx.beginPath(); drawCtx.moveTo(drawLastX, drawLastY); drawCtx.lineTo(p.x, p.y); drawCtx.stroke();
    drawLastX = p.x; drawLastY = p.y;
  }
  function end(e) { e.preventDefault(); drawDrawing = false; }
  canvas.addEventListener('touchstart', start, { passive: false });
  canvas.addEventListener('touchmove', move, { passive: false });
  canvas.addEventListener('touchend', end, { passive: false });
  canvas.addEventListener('mousedown', start);
  canvas.addEventListener('mousemove', move);
  canvas.addEventListener('mouseup', end);
  canvas.addEventListener('mouseleave', end);

  const colorsDiv = document.getElementById('drawColors');
  colorsDiv.innerHTML = '';
  drawColorsList.forEach((c, i) => {
    const d = document.createElement('div');
    d.className = 'draw-color' + (i === 0 ? ' active' : '');
    d.style.background = c;
    d.onclick = () => {
      drawColor = c; isEraser = false;
      document.querySelectorAll('.draw-color').forEach(x => x.classList.remove('active'));
      d.classList.add('active');
    };
    colorsDiv.appendChild(d);
  });
  // 模板
  renderDrawTemplates();
}

function renderDrawTemplates() {
  const grid = document.getElementById('drawTplGrid');
  if (!grid) return;
  grid.innerHTML = '';
  drawShapes.forEach((item, idx) => {
    const card = document.createElement('div');
    card.className = 'draw-tpl-card';
    card.innerHTML = '<div class="tpl-emoji">' + item.icon + '</div><div class="tpl-label">' + item.name + '</div>';
    card.setAttribute('onclick', 'drawShapeTemplate(' + idx + ')');
    grid.appendChild(card);
  });
}

// 在画布上绘制虚线形状轮廓供孩子描画
function drawShapeTemplate(idx) {
  clearDraw();
  var canvas = document.getElementById('drawCanvas');
  var rect = canvas.getBoundingClientRect();
  var cx = rect.width / 2;
  var cy = 150;
  var size = 100;
  var item = drawShapes[idx];

  drawCtx.save();
  drawCtx.strokeStyle = 'rgba(253,121,168,0.35)';
  drawCtx.lineWidth = 3;
  drawCtx.setLineDash([8, 6]);
  drawCtx.lineCap = 'round';

  switch (item.type) {
    case 'rect':
      drawCtx.strokeRect(cx - size, cy - size, size * 2, size * 2);
      break;
    case 'rectTall':
      drawCtx.strokeRect(cx - size * 0.7, cy - size, size * 1.4, size * 2);
      break;
    case 'circle':
      drawCtx.beginPath();
      drawCtx.arc(cx, cy, size, 0, Math.PI * 2);
      drawCtx.stroke();
      break;
    case 'oval':
      drawCtx.beginPath();
      drawCtx.ellipse(cx, cy, size * 1.3, size * 0.75, 0, 0, Math.PI * 2);
      drawCtx.stroke();
      break;
    case 'triangle':
      drawCtx.beginPath();
      drawCtx.moveTo(cx, cy - size);
      drawCtx.lineTo(cx - size * 0.9, cy + size * 0.7);
      drawCtx.lineTo(cx + size * 0.9, cy + size * 0.7);
      drawCtx.closePath();
      drawCtx.stroke();
      break;
    case 'star':
      drawStarPath(cx, cy, 5, size, size * 0.45);
      drawCtx.stroke();
      break;
    case 'diamond':
      drawCtx.beginPath();
      drawCtx.moveTo(cx, cy - size);
      drawCtx.lineTo(cx + size * 0.7, cy);
      drawCtx.lineTo(cx, cy + size);
      drawCtx.lineTo(cx - size * 0.7, cy);
      drawCtx.closePath();
      drawCtx.stroke();
      break;
    case 'heart':
      drawHeartPath(cx, cy, size);
      drawCtx.stroke();
      break;
    case 'arrow':
      drawCtx.beginPath();
      drawCtx.moveTo(cx - size, cy);
      drawCtx.lineTo(cx + size * 0.6, cy);
      drawCtx.moveTo(cx + size * 0.6, cy);
      drawCtx.lineTo(cx + size * 0.2, cy - size * 0.35);
      drawCtx.moveTo(cx + size * 0.6, cy);
      drawCtx.lineTo(cx + size * 0.2, cy + size * 0.35);
      drawCtx.stroke();
      break;
    case 'cross':
      drawCtx.beginPath();
      drawCtx.moveTo(cx, cy - size);
      drawCtx.lineTo(cx, cy + size);
      drawCtx.moveTo(cx - size, cy);
      drawCtx.lineTo(cx + size, cy);
      drawCtx.stroke();
      break;
    case 'wave':
      drawCtx.beginPath();
      for (var i = 0; i <= 40; i++) {
        var x = cx - size + (i / 40) * size * 2;
        var y = cy + Math.sin((i / 40) * Math.PI * 3) * size * 0.35;
        if (i === 0) drawCtx.moveTo(x, y); else drawCtx.lineTo(x, y);
      }
      drawCtx.stroke();
      break;
    case 'spiral':
      drawCtx.beginPath();
      for (var a = 0; a < Math.PI * 6; a += 0.1) {
        var r = (a / (Math.PI * 6)) * size;
        var x = cx + Math.cos(a) * r;
        var y = cy + Math.sin(a) * r;
        if (a === 0) drawCtx.moveTo(x, y); else drawCtx.lineTo(x, y);
      }
      drawCtx.stroke();
      break;
  }

  // 提示文字
  drawCtx.setLineDash([]);
  drawCtx.font = '15px sans-serif';
  drawCtx.fillStyle = '#bbb';
  drawCtx.textAlign = 'center';
  drawCtx.fillText('沿着虚线描一描～', cx, cy + size + 40);
  drawCtx.restore();

  document.getElementById('drawGuideBox').classList.remove('show');
}

// 辅助：画五角星路径
function drawStarPath(cx, cy, points, outer, inner) {
  drawCtx.beginPath();
  for (var i = 0; i < points * 2; i++) {
    var r = i % 2 === 0 ? outer : inner;
    var a = (i / (points * 2)) * Math.PI * 2 - Math.PI / 2;
    var x = cx + Math.cos(a) * r;
    var y = cy + Math.sin(a) * r;
    if (i === 0) drawCtx.moveTo(x, y); else drawCtx.lineTo(x, y);
  }
  drawCtx.closePath();
}

// 辅助：画心形路径
function drawHeartPath(cx, cy, size) {
  drawCtx.beginPath();
  var s = size / 100;
  for (var t = 0; t <= Math.PI * 2; t += 0.02) {
    var x = cx + s * 16 * Math.pow(Math.sin(t), 3) * 5.5;
    var y = cy - s * (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t)) * 5.5;
    if (t === 0) drawCtx.moveTo(x, y); else drawCtx.lineTo(x, y);
  }
  drawCtx.closePath();
}
function setBrushSize(size, el) {
  drawSize = size; isEraser = false;
  document.querySelectorAll('.draw-size').forEach(x => x.classList.remove('active'));
  if (el) el.classList.add('active');
}
function setEraser() { isEraser = true; document.querySelectorAll('.draw-color').forEach(x => x.classList.remove('active')); }
function clearDraw() {
  const canvas = document.getElementById('drawCanvas');
  const rect = canvas.getBoundingClientRect();
  drawCtx.fillStyle = '#ffffff';
  drawCtx.fillRect(0, 0, rect.width, 300);
}
function saveDraw() {
  const canvas = document.getElementById('drawCanvas');
  const link = document.createElement('a');
  link.download = '我的画.png';
  link.href = canvas.toDataURL();
  link.click();
}

