// 英语句子模块
let engSentCurrentCat = null;
let engSentMode = 'card'; // 'card' or 'conv'
let engSentConvCat = null;

function setEngSentMode(mode, btn) {
  engSentMode = mode;
  document.getElementById('engSentModeCard').classList.toggle('active', mode === 'card');
  document.getElementById('engSentModeConv').classList.toggle('active', mode === 'conv');
  document.getElementById('engSentCardMode').style.display = mode === 'card' ? '' : 'none';
  document.getElementById('engSentConvMode').style.display = mode === 'conv' ? '' : 'none';
  if (mode === 'conv') { renderEngSentConv(); }
}

function initEngSentence() {
  const cats = Object.keys(engSentenceData);
  if (!engSentCurrentCat) engSentCurrentCat = cats[0];
  const bar = document.getElementById('engSentCatBar');
  bar.innerHTML = '';
  cats.forEach(cat => {
    const btn = document.createElement('div');
    btn.className = 'eng-sent-cat-btn' + (cat === engSentCurrentCat ? ' active' : '');
    btn.textContent = cat;
    btn.onclick = () => { engSentCurrentCat = cat; initEngSentence(); };
    bar.appendChild(btn);
  });
  const list = document.getElementById('engSentList');
  list.innerHTML = '';
  const items = engSentenceData[engSentCurrentCat] || [];
  items.forEach(item => {
    const card = document.createElement('div');
    card.className = 'eng-sent-card';
    card.onclick = () => speakEnWithZh(item.en, item.zh);
    card.innerHTML =
      '<div class="eng-sent-emoji">' + item.emoji + '</div>' +
      '<div class="eng-sent-body">' +
        '<div class="eng-sent-en">' + item.en + '</div>' +
        '<div class="eng-sent-zh">' + item.zh + '</div>' +
      '</div>' +
      '<div class="eng-sent-play">🔊</div>';
    list.appendChild(card);
  });
}

// 渲染场景对话
function renderEngSentConv() {
  const catBar = document.getElementById('engSentConvCatBar');
  const scenesEl = document.getElementById('engSentConvScenes');
  if (!catBar || !scenesEl) return;
  
  if (!engSentConvCat) engSentConvCat = engConversations[0].cat;
  catBar.innerHTML = '';
  engConversations.forEach(cat => {
    const btn = document.createElement('button');
    btn.className = 'tab-item' + (cat.cat === engSentConvCat ? ' active' : '');
    btn.textContent = cat.icon + ' ' + cat.cat;
    btn.onclick = () => { engSentConvCat = cat.cat; renderEngSentConv(); };
    catBar.appendChild(btn);
  });
  
  const catData = engConversations.find(c => c.cat === engSentConvCat);
  if (!catData) return;
  
  scenesEl.innerHTML = '';
  catData.scenes.forEach(scene => {
    const sceneCard = document.createElement('div');
    sceneCard.className = 'content-card';
    sceneCard.style.marginBottom = '12px';
    
    const title = document.createElement('div');
    title.style.fontWeight = '700';
    title.style.fontSize = '16px';
    title.style.marginBottom = '10px';
    title.style.color = 'var(--text-dark)';
    title.textContent = '🎭 ' + scene.title;
    sceneCard.appendChild(title);
    
    scene.lines.forEach(line => {
      const lineEl = document.createElement('div');
      lineEl.style.padding = '8px 12px';
      lineEl.style.marginBottom = '6px';
      lineEl.style.borderRadius = '10px';
      lineEl.style.background = line.role === 'Kid' || line.role === 'B' 
        ? 'rgba(116,185,255,0.15)' 
        : 'rgba(253,121,168,0.1)';
      lineEl.style.cursor = 'pointer';
      lineEl.innerHTML = 
        '<div style="font-size:12px;color:var(--text-light);margin-bottom:2px;">' + line.role + '</div>' +
        '<div style="font-size:15px;font-weight:600;color:var(--text-dark);">' + line.en + '</div>' +
        '<div style="font-size:13px;color:var(--text-light);margin-top:2px;">' + line.zh + '</div>';
      lineEl.onclick = () => speakEnWithZh(line.en, line.zh);
      sceneCard.appendChild(lineEl);
    });
    
    // 播放全部按钮
    const playAllBtn = document.createElement('button');
    playAllBtn.className = 'tab-item';
    playAllBtn.style.marginTop = '8px';
    playAllBtn.style.background = 'var(--star-blue)';
    playAllBtn.style.color = '#fff';
    playAllBtn.style.border = 'none';
    playAllBtn.textContent = '🔊 播放全部';
    playAllBtn.onclick = () => playConvSceneAll(scene);
    sceneCard.appendChild(playAllBtn);
    
    scenesEl.appendChild(sceneCard);
  });
}

// 播放整个场景对话
let _convPlayTimeout = null;
function playConvSceneAll(scene) {
  if (_convPlayTimeout) { clearTimeout(_convPlayTimeout); _convPlayTimeout = null; }
  let idx = 0;
  function playNext() {
    if (idx >= scene.lines.length) return;
    speakEn(scene.lines[idx].en);
    idx++;
    _convPlayTimeout = setTimeout(playNext, 2500);
  }
  playNext();
}

