    if (testArea) testArea.style.display = 'none';
    if (dialogTitle) dialogTitle.style.display = 'none';
    if (dialogsEl) dialogsEl.style.display = 'none';
    songTitle.style.display = 'none';
    songArea.style.display = 'none';
    // 显示日常对话
    convArea.style.display = '';
    renderEngConv();
    return;
  }

  // 正常模式：隐藏歌曲、日常对话
  songTitle.style.display = 'none';
  songArea.style.display = 'none';
  if (convArea) convArea.style.display = 'none';
  cardsEl.style.display = '';
  if (testTitle) testTitle.style.display = '';
  if (testArea) testArea.style.display = '';
  if (dialogTitle) dialogTitle.style.display = '';
  if (dialogsEl) dialogsEl.style.display = '';

  const cards = document.getElementById('engCards');
  cards.innerHTML = '';
  englishData[engCurrentCat].forEach(item => {
    const c = document.createElement('div');
    c.className = 'eng-card';
    c.innerHTML = `<div class="emoji">${item.emoji}</div><div class="en-word">${item.en}</div><div class="zh-word">${item.zh}</div><button class="speak-btn">🔊</button>`;
    c.querySelector('.speak-btn').onclick = (e) => { e.stopPropagation(); speakEnWithZh(item.en, item.zh); };
    c.onclick = () => speakEnWithZh(item.en, item.zh);
    cards.appendChild(c);
  });
  // 对话（如果有的话）
  const dc = document.getElementById('engDialogs');
  if (dc) {
    dc.innerHTML = '';
    engDialogs.forEach(d => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f0f0f0;';
      row.innerHTML = `<div><div style="font-size:15px;font-weight:600;">${d.en}</div><div style="font-size:13px;color:var(--text-light);">${d.zh}</div></div>`;
      const btn = document.createElement('button');
      btn.className = 'speak-btn';
      btn.textContent = '🔊';
      btn.onclick = () => speakEnWithZh(d.en, d.zh);
      row.appendChild(btn);
      dc.appendChild(row);
    });
  }
  // 初始化听力测试（每次切换分类都重新出题）
  initEngTest();
}

