/* ========== 重置 & 基础 ========== */
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html { -webkit-text-size-adjust:100%; height:100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  background:var(--bg-main);
  color:var(--text-dark);
  height:100vh;
  overflow:hidden;
  user-select:none;
  -webkit-user-select:none;
}
button { font-family:inherit; cursor:pointer; border:none; outline:none; }
canvas { touch-action:none; }
input { font-family:inherit; }

/* ========== 整体布局 ========== */
.app-layout { display:flex; height:100vh; }

/* ========== 左侧栏 ========== */
.sidebar {
  width:var(--sidebar-w);
  background:var(--bg-sidebar);
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:12px 0;
  box-shadow:var(--shadow-sidebar);
  z-index:100;
  overflow-y:auto;
  flex-shrink:0;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.sidebar::-webkit-scrollbar { display:none; }

.sidebar-logo {
  font-size:28px;
  margin-bottom:4px;
  animation:starSpin 8s linear infinite;
}
@keyframes starSpin { from{transform:rotate(0deg);} to{transform:rotate(360deg);} }

.sidebar-title {
  font-size:11px;
  color:var(--text-white);
  font-weight:700;
  letter-spacing:1px;
  margin-bottom:16px;
  text-align:center;
  line-height:1.3;
}

.nav-divider {
  width:60%;
  height:1px;
  background:rgba(255,255,255,0.1);
  margin:4px 0 8px;
  flex-shrink:0;
}

.nav-cat {
  width:100%;
  padding:6px 8px 4px;
  font-size:9px;
  font-weight:600;
  color:rgba(255,255,255,0.4);
  letter-spacing:1px;
  text-align:center;
  flex-shrink:0;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.nav-btn {
  width:var(--sidebar-w);
  max-width:var(--sidebar-w);
  padding:10px 4px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:3px;
  background:transparent;
  color:var(--text-dim);
  transition:all .2s;
  flex-shrink:0;
  border-left:3px solid transparent;
  cursor:pointer;
}
.nav-btn:hover { background:rgba(255,255,255,0.06); }
.nav-btn.active {
  background:rgba(108,92,231,0.2);
  color:var(--text-white);
  border-left-color:var(--star-purple);
}
.nav-btn .nav-icon { font-size:22px; }
.nav-btn .nav-label { font-size:10px; text-align:center; line-height:1.2; }

.nav-stars {
  margin-top:auto;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:2px;
  padding:10px 4px;
  background:rgba(255,255,255,0.08);
  border-radius:12px;
  margin:8px 6px;
  flex-shrink:0;
}
.nav-stars .star-icon { font-size:18px; }
.nav-stars .star-count { font-size:16px; font-weight:700; color:var(--star-gold); }

/* 桌面端侧栏加宽 */
@media (min-width:768px) {
  .sidebar { width:var(--sidebar-w-desktop); align-items:stretch; padding:16px 0; }
  .sidebar-title { font-size:18px; margin-bottom:20px; }
  .nav-cat { font-size:11px; text-align:left; padding:12px 20px 6px; letter-spacing:2px; }
  .nav-btn {
    width:100%; max-width:100%;
    flex-direction:row; justify-content:flex-start;
    padding:14px 20px; gap:12px;
    border-left:4px solid transparent;
  }
  .nav-btn .nav-icon { font-size:24px; }
  .nav-btn .nav-label { font-size:15px; }
  .nav-stars { flex-direction:row; margin:8px 16px; padding:12px 16px; justify-content:center; gap:8px; }
  .nav-stars .star-count { font-size:20px; }
}

/* ========== 右侧主区域 ========== */
.main-area {
  flex:1;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
  position:relative;
}

.module-header {
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 20px;
  position:sticky;
  top:0;
  z-index:50;
  backdrop-filter:blur(10px);
}
.module-header .mh-icon { font-size:24px; }
.module-header .mh-title { font-size:20px; font-weight:700; }

.module-body { padding:8px 16px 40px; }

/* ========== 首页(概览) ========== */
#home-screen {
  min-height:100%;
  background:linear-gradient(160deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);
  color:#fff;
  padding:32px 24px;
}
.home-hero { text-align:center; margin-bottom:32px; }
.home-hero .logo { font-size:56px; animation:starSpin 8s linear infinite; display:inline-block; }
.home-hero h1 {
  font-size:32px; margin-top:8px;
  text-shadow:0 0 20px rgba(108,92,231,.6);
}
.home-hero p { font-size:14px; color:var(--text-dim); margin-top:6px; }
.home-stats {
  display:flex; justify-content:center; gap:24px; margin-top:20px; flex-wrap:wrap;
}
.home-stat {
  background:rgba(255,255,255,0.1);
  border-radius:14px;
  padding:12px 24px;
  text-align:center;
}
.home-stat .stat-val { font-size:28px; font-weight:700; color:var(--star-gold); }
.home-stat .stat-label { font-size:12px; color:var(--text-dim); }

.overview-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));
  gap:14px;
}
.overview-card {
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:var(--radius-md);
  padding:20px 12px;
  text-align:center;
  cursor:pointer;
  transition:all .2s;
}
.overview-card:hover { background:rgba(255,255,255,0.15); transform:translateY(-2px); }
.overview-card .icon { font-size:36px; }
.overview-card .name { font-size:15px; margin-top:8px; font-weight:600; }
.overview-card .desc { font-size:11px; color:var(--text-dim); margin-top:4px; }

/* ========== 通用组件 ========== */
.tab-bar {
  display:flex;
  gap:6px;
  overflow-x:auto;
  padding:8px 0 14px;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.tab-bar::-webkit-scrollbar { display:none; }
.tab-item {
  padding:8px 16px;
  border-radius:30px;
  white-space:nowrap;
  font-size:14px;
  background:rgba(0,0,0,0.05);
  color:var(--text-light);
  cursor:pointer;
  transition:all .2s;
  flex-shrink:0;
}
.tab-item.active { background:#fff; box-shadow:var(--shadow-btn); color:var(--text-dark); font-weight:600; }

.content-card {
  background:var(--bg-card);
  border-radius:var(--radius-md);
  padding:16px;
  box-shadow:var(--shadow-card);
}

.section-title {
  font-size:16px;
  font-weight:700;
  margin:16px 0 10px;
  padding-left:8px;
  border-left:4px solid var(--star-purple);
}

/* 通用网格 */
.card-grid-2 { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
.card-grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.card-grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
@media (min-width:600px) {
  .card-grid-2 { grid-template-columns:repeat(3,1fr); }
  .card-grid-3 { grid-template-columns:repeat(4,1fr); }
  .card-grid-4 { grid-template-columns:repeat(6,1fr); }
}

/* ========== 英语模块 ========== */
#module-english .module-header { background:rgba(116,185,255,0.9); color:#fff; }
.eng-card {
  background:#fff;
  border-radius:var(--radius-sm);
  padding:14px 8px;
  text-align:center;
  box-shadow:var(--shadow-card);
  cursor:pointer;
  transition:transform .15s;
}
.eng-card:active { transform:scale(.95); }
.eng-card .emoji { font-size:32px; }
.eng-card .en-word { font-size:18px; font-weight:600; color:var(--text-dark); margin-top:4px; }
.eng-card .zh-word { font-size:13px; color:var(--text-light); margin-top:2px; }
.eng-card .speak-btn {
  margin-top:6px;
  width:32px; height:32px; border-radius:50%;
  background:var(--star-blue); color:#fff; font-size:14px;
  display:inline-flex; align-items:center; justify-content:center;
}

/* 听力测试 */
.eng-test-card { padding:16px; text-align:center; }
.eng-test-score-row {
  display:flex; justify-content:center; gap:24px; margin-bottom:16px;
}
.eng-test-score-item { text-align:center; }
.eng-test-score-item .label { font-size:12px; color:var(--text-light); }
.eng-test-score-item .value { font-size:24px; font-weight:700; color:var(--text-dark); }
.eng-test-prompt {
  font-size:15px; color:var(--text-light); margin-bottom:12px;
}
.eng-test-audio-btn-wrap { margin-bottom:16px; }
.eng-test-play-btn {
  font-size:20px; padding:14px 36px; border:none; border-radius:30px;
  background:var(--star-blue); color:#fff; cursor:pointer;
  box-shadow:0 3px 8px rgba(116,185,255,0.4);
  transition:transform .15s, box-shadow .15s;
}
.eng-test-play-btn:active { transform:scale(.95); }
.eng-test-play-btn.playing {
  background:var(--star-orange);
  box-shadow:0 3px 8px rgba(255,165,2,0.4);
  animation:engTestPulse 1s ease-in-out infinite;
}
@keyframes engTestPulse {
  0%,100% { transform:scale(1); }
  50% { transform:scale(1.05); }
}
.eng-test-options {
  display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;
}
.eng-test-option {
  background:#fff; border:2px solid #e0e0e0; border-radius:var(--radius-sm);
  padding:18px 8px; text-align:center; cursor:pointer;
  font-size:18px; font-weight:600; color:var(--text-dark);
  transition:all .2s; user-select:none;
}
.eng-test-option:active { transform:scale(.95); }
.eng-test-option.correct {
  background:#d4edda; border-color:var(--star-green); color:#155724;
}
.eng-test-option.wrong {
  background:#f8d7da; border-color:#dc3545; color:#721c24;
}
.eng-test-option.disabled { pointer-events:none; opacity:0.7; }
.eng-test-feedback {
  font-size:16px; font-weight:600; min-height:24px; margin-bottom:10px;
}
.eng-test-feedback.correct { color:var(--star-green); }
.eng-test-feedback.wrong { color:#dc3545; }
.eng-test-next-btn {
  font-size:16px; padding:10px 28px; border:none; border-radius:20px;
  background:var(--star-blue); color:#fff; cursor:pointer;
  transition:transform .15s;
}
.eng-test-next-btn:active { transform:scale(.95); }

/* 英语歌曲 */
.eng-song-card {
  padding:16px; text-align:center;
}
.eng-song-title {
  font-size:18px; font-weight:700; color:var(--text-dark); margin-bottom:14px;
}
.eng-song-subtitle {
  font-size:13px; color:var(--text-light); margin-bottom:16px;
}
.eng-song-play-btn {
  font-size:22px; padding:14px 40px; border:none; border-radius:30px;
  background:var(--star-orange); color:#fff; cursor:pointer;
  box-shadow:0 3px 8px rgba(255,165,2,0.4);
  transition:transform .15s; margin-bottom:20px;
}
.eng-song-play-btn:active { transform:scale(.95); }
.eng-song-play-btn.playing {
  background:var(--star-blue);
  box-shadow:0 3px 8px rgba(116,185,255,0.4);
  animation:engSongPulse 1s ease-in-out infinite;
}
@keyframes engSongPulse {
  0%,100% { transform:scale(1); }
  50% { transform:scale(1.05); }
}
.eng-song-grid {
  display:grid; grid-template-columns:repeat(5,1fr); gap:10px;
}
.eng-song-num {
  background:#fff; border:2px solid #e8e8e8; border-radius:var(--radius-sm);
  padding:12px 4px; text-align:center; transition:all .3s;
  cursor:pointer; position:relative;
}
.eng-song-num .digit {
  font-size:28px; font-weight:800; color:var(--text-dark); line-height:1;
}
.eng-song-num .en-spell {
  font-size:13px; font-weight:600; color:var(--star-blue); margin-top:4px;
}
.eng-song-num .zh-num {
  font-size:12px; color:var(--text-light); margin-top:2px;
}
.eng-song-num .emoji-icon {
  font-size:22px; margin-bottom:4px;
}
.eng-song-num.singing {
  background:linear-gradient(135deg,#fff9e6,#fff3cd);
  border-color:var(--star-orange);
  transform:scale(1.15);
  box-shadow:0 4px 12px rgba(255,165,2,0.35);
}
.eng-song-num.singing .digit {
  color:var(--star-orange);
}
.eng-song-num:active { transform:scale(.93); }
@media(max-width:480px) {
  .eng-song-grid { grid-template-columns:repeat(5,1fr); gap:6px; }
  .eng-song-num { padding:8px 2px; }
  .eng-song-num .digit { font-size:22px; }
  .eng-song-num .en-spell { font-size:11px; }
  .eng-song-num .zh-num { font-size:10px; }
  .eng-song-num .emoji-icon { font-size:18px; }
}

/* ========== 拼音模块 ========== */
#module-pinyin .module-header { background:rgba(85,239,196,0.9); color:#1a1a2e; }
.py-item {
  aspect-ratio:1; border-radius:var(--radius-sm);
  background:#fff; display:flex; flex-direction:column;
  align-items:center; justify-content:center; box-shadow:var(--shadow-card);
  cursor:pointer; transition:transform .15s;
}
.py-item:active { transform:scale(.92); }
.py-item .py-char { font-size:24px; color:var(--star-purple); font-weight:700; }
.py-item .py-eg { font-size:11px; color:var(--text-light); margin-top:2px; }
.py-item.selected { box-shadow:0 0 0 3px var(--star-green); }

.write-area {
  background:#fff; border-radius:var(--radius-md);
  padding:14px; box-shadow:var(--shadow-card); margin-top:14px;
}
.write-label { font-size:14px; color:var(--text-dark); margin-bottom:8px; text-align:center; }
.write-canvas {
  width:100%; height:180px; border:2px dashed var(--star-green);
  border-radius:var(--radius-sm); background:#fafafa; display:block;
}
.write-controls { display:flex; gap:8px; justify-content:center; margin-top:10px; flex-wrap:wrap; }
.write-btn {
  padding:8px 18px; border-radius:30px; font-size:14px;
  color:#fff; box-shadow:var(--shadow-btn);
}

/* ========== 数学模块 ========== */
#module-math .module-header { background:rgba(255,165,2,0.9); color:#fff; }

/* 数学分类卡片网格 */
.math-category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 16px;
}
.math-cat-card {
  background: linear-gradient(135deg, #ffeaa7, #fdcb6e);
  border-radius: 16px;
  padding: 20px 12px;
  text-align: center;
  cursor: pointer;
  transition: all .2s;
  box-shadow: 0 3px 10px rgba(253, 203, 110, 0.3);
}
.math-cat-card:hover { transform: translateY(-2px); box-shadow: 0 5px 16px rgba(253, 203, 110, 0.5); }
.math-cat-card:active { transform: scale(0.95); }
.math-cat-icon { font-size: 40px; margin-bottom: 8px; }
.math-cat-title { font-size: 18px; font-weight: 700; color: #d68910; margin-bottom: 4px; }
.math-cat-desc { font-size: 12px; color: #b7950b; }
.math-cat-card.mul-card {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  box-shadow: 0 3px 10px rgba(108, 92, 231, 0.3);
}
.math-cat-card.mul-card:hover { box-shadow: 0 5px 16px rgba(108, 92, 231, 0.5); }
.math-cat-card.mul-card .math-cat-title { color: #fff; }
.math-cat-card.mul-card .math-cat-desc { color: rgba(255,255,255,0.85); }
.math-cat-card.print-card {
  background: linear-gradient(135deg, #81ecec, #00cec9);
  box-shadow: 0 3px 10px rgba(0, 206, 201, 0.3);
}
.math-cat-card.print-card:hover { box-shadow: 0 5px 16px rgba(0, 206, 201, 0.5); }
.math-cat-card.print-card .math-cat-title { color: #fff; }
.math-cat-card.print-card .math-cat-desc { color: rgba(255,255,255,0.85); }

.math-back-row {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}
.math-back-row .tab-item {
  font-size: 14px;
  padding: 6px 14px;
  background: #f1f2f6;
  color: #636e72;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

.math-card {
  background:#fff; border-radius:var(--radius-md); padding:20px 16px;
  text-align:center; box-shadow:var(--shadow-card);
}
.math-problem { font-size:40px; font-weight:700; color:var(--text-dark); margin-bottom:12px; }
.math-answer-box {
  width:100px; height:50px; border:3px solid var(--star-orange);
  border-radius:var(--radius-sm); font-size:30px; font-weight:700;
  color:var(--star-purple); margin:0 auto 12px;
  display:flex; align-items:center; justify-content:center;
}
.math-feedback { min-height:32px; font-size:18px; margin:8px 0; }
.math-feedback.correct { color:var(--star-green); }
.math-feedback.wrong { color:var(--star-pink); }
.math-score-row { display:flex; justify-content:space-around; margin-bottom:14px; }
.math-score-item { text-align:center; }
.math-score-item .label { font-size:12px; color:var(--text-light); }
.math-score-item .value { font-size:22px; font-weight:700; color:var(--star-orange); }
.num-pad { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; max-width:260px; margin:0 auto; }
.num-btn {
  padding:14px 0; border-radius:var(--radius-sm); font-size:22px;
  background:#fff5e8; color:var(--text-dark); box-shadow:var(--shadow-btn);
  transition:transform .1s;
}
.num-btn:active { transform:scale(.9); }
.num-btn.del { background:#ffe0e0; }
.num-btn.ok { background:var(--star-green); color:#fff; }
.num-btn.next { background:var(--star-orange); color:#fff; grid-column:span 3; font-size:16px; }

@keyframes pop { 0%{transform:scale(.5);} 50%{transform:scale(1.2);} 100%{transform:scale(1);} }
@keyframes shake { 0%,100%{transform:translateX(0);} 25%{transform:translateX(-8px);} 75%{transform:translateX(8px);} }
.pop-anim { animation:pop .4s; }
.shake-anim { animation:shake .4s; }

.math-compare-card {
  background:#fff; border-radius:var(--radius-md); padding:16px;
  box-shadow:var(--shadow-card); text-align:center;
}
.math-compare-visual { display:flex; justify-content:center; align-items:center; gap:16px; margin:12px 0; }
.math-compare-group { display:flex; flex-direction:column; align-items:center; gap:4px; }
.math-compare-group .items { font-size:28px; }
.math-compare-group .count { font-size:20px; font-weight:700; color:var(--star-purple); }
.compare-btns { display:flex; gap:8px; justify-content:center; margin-top:12px; }
.compare-btn {
  padding:10px 20px; border-radius:30px; font-size:16px;
  background:#fff5e8; color:var(--text-dark); box-shadow:var(--shadow-btn);
}
.compare-btn:active { transform:scale(.9); }
.compare-btn.correct { background:var(--star-green); color:#fff; }
.compare-btn.wrong { background:#ff7675; color:#fff; }

/* 填空题样式 */
.math-blank {
  display:inline-block; min-width:50px; padding:2px 10px;
  border-bottom:3px solid var(--star-pink); color:var(--star-pink);
  font-size:36px; font-weight:700; text-align:center; vertical-align:middle;
}
.op-btns { display:flex; gap:12px; justify-content:center; margin-top:16px; }
.op-btn {
  width:80px; height:80px; border-radius:16px; font-size:40px; font-weight:700;
  background:#fff5e8; color:var(--text-dark); box-shadow:var(--shadow-btn);
  border:2px solid transparent; display:flex; align-items:center; justify-content:center;
}
.op-btn:active { transform:scale(.9); }
.op-btn.correct { background:var(--star-green); color:#fff; }
.op-btn.wrong { background:#ff7675; color:#fff; }

/* ========== 画板模块 ========== */
#module-drawing .module-header { background:rgba(253,121,168,0.9); color:#fff; }
.draw-canvas-wrap { background:#fff; border-radius:var(--radius-md); padding:6px; box-shadow:var(--shadow-card); }
#drawCanvas { width:100%; height:300px; border-radius:var(--radius-sm); background:#fff; display:block; cursor:crosshair; }
.draw-tools { margin-top:12px; }
.draw-colors { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-bottom:10px; }
.draw-color {
  width:34px; height:34px; border-radius:50%; border:3px solid #fff;
  box-shadow:0 2px 6px rgba(0,0,0,.15); transition:transform .15s; cursor:pointer;
}
.draw-color:active, .draw-color.active { transform:scale(1.2); border-color:var(--star-purple); }
.draw-sizes { display:flex; gap:6px; justify-content:center; align-items:center; margin-bottom:10px; }
.draw-size {
  width:40px; height:40px; border-radius:50%; background:#fff;
  display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-btn);
  cursor:pointer;
}
.draw-size.active { box-shadow:0 0 0 3px var(--star-pink); }
.draw-size .dot { background:var(--text-dark); border-radius:50%; }
.draw-actions { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; }
.draw-action-btn { padding:10px 20px; border-radius:30px; font-size:14px; color:#fff; box-shadow:var(--shadow-btn); }
.draw-templates { margin-top:14px; }
.draw-tpl-tabs { display:flex; gap:6px; margin-bottom:10px; flex-wrap:wrap; }
.draw-tpl-tab {
