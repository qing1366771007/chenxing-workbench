var phyCurrentCat = '全部';
var phyCurrentIdx = -1;
var phyFilteredIdx = [];

function initPhysics() {
  phyCurrentIdx = -1;
  document.getElementById('phyDetail').style.display = 'none';
  document.getElementById('phyList').style.display = 'grid';
  renderPhyCatBar();
  renderPhyList();
}

function renderPhyCatBar() {
  var bar = document.getElementById('phyCatBar');
  if (!bar) return;
  var cats = ['全部'];
  phyData.forEach(function(item) {
    if (item.cat && cats.indexOf(item.cat) === -1) cats.push(item.cat);
  });
  var html = '';
  cats.forEach(function(cat) {
    html += '<div class="phy-cat-btn ' + (phyCurrentCat === cat ? 'active' : '') + '" onclick="setPhyCat(\'' + cat + '\')">' + cat + '</div>';
  });
  bar.innerHTML = html;
}

function setPhyCat(cat) {
  phyCurrentCat = cat;
  phyCurrentIdx = -1;
  document.getElementById('phyDetail').style.display = 'none';
  document.getElementById('phyList').style.display = 'grid';
  renderPhyCatBar();
  renderPhyList();
}

function renderPhyList() {
  var list = document.getElementById('phyList');
  if (!list) return;
  phyFilteredIdx = [];
  var html = '';
  phyData.forEach(function(item, idx) {
    if (phyCurrentCat !== '全部' && item.cat !== phyCurrentCat) return;
    phyFilteredIdx.push(idx);
    html += '<div class="phy-card" onclick="showPhy(' + idx + ')">' +
      '<div class="phy-icon">' + item.icon + '</div>' +
      '<div class="phy-name">' + item.name + '</div>' +
      '<div class="phy-age">' + item.age + ' · ' + item.cat + '</div>' +
      '<div class="phy-hint">点击探索 👆</div>' +
      '</div>';
  });
  list.innerHTML = html;
}

function showPhy(idx) {
  phyCurrentIdx = idx;
  var item = phyData[idx];
  document.getElementById('phyList').style.display = 'none';
  document.getElementById('phyDetail').style.display = 'block';
  document.getElementById('phyIcon').textContent = item.icon;
  document.getElementById('phyName').textContent = item.name;
  document.getElementById('phyAge').textContent = item.age + ' · ' + item.cat;
  document.getElementById('phyQuestion').textContent = item.question;
  document.getElementById('phyAnswer').textContent = item.answer;
  // 实验
  var expHtml = '';
  if (item.experiments && item.experiments.length > 0) {
    item.experiments.forEach(function(exp) {
      expHtml += '<div class="phy-experiment-box">' +
        '<div class="phy-exp-title">🧪 ' + exp.name + '（材料：' + exp.material + '）</div>' +
        '<div>' + exp.desc + '</div>' +
        '</div>';
    });
  }
  document.getElementById('phyExperiments').innerHTML = expHtml;
  // 生活例子
  var realHtml = '';
  if (item.realLife && item.realLife.length > 0) {
    item.realLife.forEach(function(r) {
      realHtml += '<li>' + r + '</li>';
    });
  }
  document.getElementById('phyRealList').innerHTML = realHtml;
  // 安全提醒
  var safetyBox = document.getElementById('phySafetyBox');
  if (item.safety) {
    safetyBox.style.display = 'block';
    document.getElementById('phySafetyText').textContent = item.safety;
  } else {
    safetyBox.style.display = 'none';
  }
  document.getElementById('mainArea').scrollTop = 0;
}

function phyBack() {
  phyCurrentIdx = -1;
  document.getElementById('phyDetail').style.display = 'none';
  document.getElementById('phyList').style.display = 'grid';
}

function readPhy() {
  if (phyCurrentIdx < 0) return;
  var item = phyData[phyCurrentIdx];
  var text = item.name + '。' +
    '问题。' + item.question +
    '科学原理。' + item.answer;
  if (item.experiments && item.experiments.length > 0) {
    text += '小实验。';
    item.experiments.forEach(function(exp) {
      text += exp.name + '。' + exp.desc + '。';
    });
  }
  if (item.realLife && item.realLife.length > 0) {
    text += '生活中的例子。' + item.realLife.join('。') + '。';
  }
  if (item.safety) {
    text += '安全提醒。' + item.safety;
  }
  speakZh(text);
}

function phyPrev() {
  if (phyFilteredIdx.length === 0) return;
  var pos = phyFilteredIdx.indexOf(phyCurrentIdx);
  if (pos <= 0) pos = phyFilteredIdx.length;
  showPhy(phyFilteredIdx[pos - 1]);
}

function phyNext() {
  if (phyFilteredIdx.length === 0) return;
  var pos = phyFilteredIdx.indexOf(phyCurrentIdx);
  if (pos >= phyFilteredIdx.length - 1) pos = -1;
  showPhy(phyFilteredIdx[pos + 1]);
}

