}

// ============================================================
// 移动端 AudioContext 解锁（首次用户交互时激活）
// 手机浏览器要求用户交互后才能播放音效，这里统一处理
// ============================================================
function _unlockAudio() {
  var ctx = _getSoundCtx();
  if (ctx && ctx.state === 'suspended') {
    ctx.resume();
  }
  // 同时尝试播放一个静音音符来彻底解锁
  if (ctx) {
    try {
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      gain.gain.value = 0; // 静音
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.001);
    } catch(e) {}
  }
}
// 监听首次交互（touch/click），只需一次
var _audioUnlocked = false;
function _onFirstInteraction(e) {
  if (_audioUnlocked) return;
  _audioUnlocked = true;
  _unlockAudio();
  document.removeEventListener('touchstart', _onFirstInteraction);
  document.removeEventListener('click', _onFirstInteraction);
}
document.addEventListener('touchstart', _onFirstInteraction, { passive: true });
document.addEventListener('click', _onFirstInteraction);

function speakEn(text) { speak(text, 'en-US'); }
function speakZh(text) { speak(text, 'zh-CN'); }

// 英语朗读：先读英文，再读中文翻译
function speakEnWithZh(en, zh) {
  if (!en) return;
  var player = _getTTSPlayer();
  var bar = _getTTSBar();
  var label = _getTTSLabel();
  if (!player || !bar) {
    // 回退到 Web Speech API
    _speakSynthesisEnZh(en, zh);
    return;
  }

  // 清除之前的监听和超时
  player.onended = null;
  player.onerror = null;
  if (window._enZhTimer) { clearTimeout(window._enZhTimer); window._enZhTimer = null; }

  var zhPlayed = false;
  function playZh() {
    if (zhPlayed) return;
    zhPlayed = true;
    if (window._enZhTimer) { clearTimeout(window._enZhTimer); window._enZhTimer = null; }
    if (!zh) { setTimeout(function() { bar.classList.remove('show'); }, 500); return; }

    // 尝试百度TTS播放中文
    var zhUrl = 'https://fanyi.baidu.com/gettts?lan=zh' +
      '&text=' + encodeURIComponent(zh) + '&spd=3&source=web';
    if (label) label.textContent = zh.length > 12 ? zh.substring(0, 12) + '...' : zh;
    player.onended = null;
    player.onerror = null;
    player.src = zhUrl;
    player.load();
    var p = player.play();
    if (p && p.catch) p.catch(function() {
      // 百度TTS中文播放失败，回退到 Web Speech API
      bar.classList.remove('show');
      _speakSynthesis(zh, 'zh-CN');
    });
    // 中文播完后隐藏播放器
    player.onended = function() {
      player.onended = null;
      setTimeout(function() { bar.classList.remove('show'); }, 500);
    };
    player.onerror = function() {
      player.onerror = null;
      bar.classList.remove('show');
      _speakSynthesis(zh, 'zh-CN');
    };
  }

  // 第一步：播放英文（走服务器代理，绕过百度防盗链）
  var baiduLan = 'en';
  var url = '/api/tts?lang=' + baiduLan + '&text=' + encodeURIComponent(en) + '&spd=3';
  if (label) label.textContent = en.length > 12 ? en.substring(0, 12) + '...' : en;
  bar.classList.add('show');
  player.src = url;
  player.load();

  // 英文播放完后，自动播放中文
  player.onended = function() {
    player.onended = null;
    playZh();
  };
  // 英文播放出错，回退到 Web Speech API 读英文，然后读中文
  player.onerror = function() {
    player.onerror = null;
    bar.classList.remove('show');
    _speakSynthesisEnZh(en, zh);
  };

  // 超时保护：如果5秒后 onended/onerror 都没触发，直接回退到 Web Speech API
  window._enZhTimer = setTimeout(function() {
    if (!zhPlayed) {
      console.log('TTS timeout, falling back to Web Speech');
      bar.classList.remove('show');
      _speakSynthesisEnZh(en, zh);
    }
  }, 5000);

  var playPromise = player.play();
  if (playPromise && playPromise.catch) {
    playPromise.catch(function() {
      // 自动播放被拦截或失败，回退到 Web Speech API
      bar.classList.remove('show');
      _speakSynthesisEnZh(en, zh);
    });
  }
}

// Web Speech API 回退：先读英文再读中文
function _speakSynthesisEnZh(en, zh) {
  if (!('speechSynthesis' in window)) {
    console.log('No speech synthesis available');
    return;
  }
  try {
    window.speechSynthesis.cancel();
    var uEn = new SpeechSynthesisUtterance(en);
    uEn.lang = 'en-US';
    uEn.rate = 0.8;
    uEn.pitch = 1.0;

    // 选择英文声音
    var enVoice = _pickVoice('en-US');
    if (enVoice) { uEn.voice = enVoice; uEn.lang = enVoice.lang; }

    if (zh) {
      uEn.onend = function() {
        var uZh = new SpeechSynthesisUtterance(zh);
        uZh.lang = 'zh-CN';
        uZh.rate = 0.9;
        uZh.pitch = 1.0;
        // 选择中文声音
        var zhVoice = _pickVoice('zh-CN');
        if (zhVoice) { uZh.voice = zhVoice; uZh.lang = zhVoice.lang; }
        window.speechSynthesis.speak(uZh);
      };
      uEn.onerror = function() {
        var uZh = new SpeechSynthesisUtterance(zh);
        uZh.lang = 'zh-CN';
        uZh.rate = 0.9;
        var zhVoice = _pickVoice('zh-CN');
        if (zhVoice) { uZh.voice = zhVoice; uZh.lang = zhVoice.lang; }
        window.speechSynthesis.speak(uZh);
      };
    }
    window.speechSynthesis.speak(uEn);
  } catch(e) {
    console.log('Speech synthesis error:', e);
  }
}

// 缓存语音列表
var _cachedVoices = null;
function _getVoices() {
  if (_cachedVoices && _cachedVoices.length > 0) return _cachedVoices;
  if ('speechSynthesis' in window) {
    _cachedVoices = window.speechSynthesis.getVoices();
    // 部分浏览器异步加载语音列表
    if (!_cachedVoices || _cachedVoices.length === 0) {
      window.speechSynthesis.onvoiceschanged = function() {
        _cachedVoices = window.speechSynthesis.getVoices();
      };
    }
  }
  return _cachedVoices || [];
}

// 根据语言选择最合适的语音
function _pickVoice(lang) {
  var voices = _getVoices();
  if (!voices || voices.length === 0) return null;

  var langCode = lang || 'zh-CN';
  var isEn = langCode.startsWith('en');
  var targetLang = isEn ? 'en' : 'zh';

  // 优先精确匹配
  var exact = voices.filter(function(v) {
    return v.lang && v.lang.toLowerCase().startsWith(targetLang);
  });
  if (exact.length > 0) {
    // 英文优先选 en-US，中文优先选 zh-CN
    var preferred = isEn ? 'en-us' : 'zh-cn';
    var pref = exact.filter(function(v) {
      return v.lang.toLowerCase() === preferred;
    });
    if (pref.length > 0) return pref[0];
    return exact[0];
  }

  return null;
}

// Web Speech API 单句朗读
function _speakSynthesis(text, lang) {
  if (!('speechSynthesis' in window)) return;
  try {
    window.speechSynthesis.cancel();
    var u = new SpeechSynthesisUtterance(text);
    u.lang = lang || 'zh-CN';
    u.rate = lang && lang.startsWith('en') ? 0.8 : 0.9;
    u.pitch = 1.0;

    // 选择对应语言的声音
    var voice = _pickVoice(lang);
    if (voice) {
      u.voice = voice;
      u.lang = voice.lang;
    }

    window.speechSynthesis.speak(u);
  } catch(e) {
    console.log('Speech synthesis error:', e);
  }
}

