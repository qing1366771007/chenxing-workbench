// —— 根据题型生成题目 ——
function smartGenQuestion(type, diff) {
  switch(type) {
    case '找规律': return smartGenPattern(diff);
    case '数一数': return smartGenCount(diff);
    case '找不同': return smartGenFindDiff(diff);
    case '比大小': return smartGenCompare(diff);
    case '分类': return smartGenCategory(diff);
    case '数字推理': return smartGenNumberReasoning(diff);
    case '乘法口诀': return smartGenMultiplication(diff);
    case '数独': return smartGenSudoku(diff);
    case '十字数独': return smartGenCrossSudoku(diff);
    case '单位换算': return smartGenUnitConvert(diff);
    case '数学思维': return smartGenMathThinking(diff);
    case '空间思维': return smartGenSpatial(diff);
    case '逻辑排序': return smartGenLogicSort(diff);
    default: return smartGenPattern(diff);
  }
}

// —— 生成下一道智能题目（换题型） ——
function smartNextQuestion() {
  // 切换到下一个题型
  var curIdx = SMART_TYPES.indexOf(thinkCurrentType);
  curIdx = (curIdx + 1) % SMART_TYPES.length;
  thinkCurrentType = SMART_TYPES[curIdx];
  thinkCurrentQ = smartGenQuestion(thinkCurrentType, thinkDifficulty);
  thinkQStreak = 0;
}

// —— 智能模式：检查答案并更新进度 ——
function smartCheckAnswer(isCorrect) {
  thinkSessionTotal++;
  if (isCorrect) {
    thinkSessionCorrect++;
    thinkQStreak++;
    if (thinkQStreak >= SMART_MASTER_THRESHOLD) {
      // 连续做对2次，掌握本题，换下一题
      thinkMastered++;
      smartSaveState();
      // 检查是否需要调整难度
      if (thinkSessionTotal >= SMART_SESSION_SIZE) {
        var acc = thinkSessionCorrect / thinkSessionTotal;
        if (acc >= SMART_UP_ACCURACY && thinkDifficulty < 10) {
          thinkDifficulty++;
          thinkSessionCorrect = 0;
          thinkSessionTotal = 0;
          smartSaveState();
          return 'levelup'; // 升级
        }
        thinkSessionCorrect = 0;
        thinkSessionTotal = 0;
      }
      return 'mastered'; // 掌握，换下一题
    }
    return 'correct'; // 答对但未掌握
  } else {
    thinkQStreak = 0; // 答错归零
    return 'wrong';
  }
}

// —— 切换智能/分组模式 ——
function toggleThinkMode() {
  thinkSmartMode = !thinkSmartMode;
  localStorage.setItem('cx_thinkSmartMode', thinkSmartMode ? '1' : '0');
  thinkAnswered = false;
  document.getElementById('thinkCard').style.display = '';
  document.getElementById('thinkGroupComplete').style.display = 'none';

  var smartBtn = document.getElementById('thinkModeSmart');
  var groupBtn = document.getElementById('thinkModeGroup');
  var groupBar = document.getElementById('thinkGroupBar');
  var smartInfo = document.getElementById('thinkSmartInfo');

  if (thinkSmartMode) {
    smartBtn.classList.add('active');
    groupBtn.classList.remove('active');
    groupBar.style.display = 'none';
    smartInfo.style.display = 'flex';
    smartLoadState();
    thinkCurrentType = SMART_TYPES[0];
    thinkCurrentQ = smartGenQuestion(thinkCurrentType, thinkDifficulty);
    thinkQStreak = 0;
    thinkSessionCorrect = 0;
    thinkSessionTotal = 0;
  } else {
    smartBtn.classList.remove('active');
    groupBtn.classList.add('active');
    groupBar.style.display = '';
    smartInfo.style.display = 'none';
    if (thinkIndex >= thinkExercises.length) thinkIndex = 0;
    renderThinkGroupBar();
  }
  renderThink();
}

function thinkGetCurrentGroup() {
  return Math.floor(thinkIndex / THINK_GROUP_SIZE);
}
function thinkGetGroupStart(group) {
  return group * THINK_GROUP_SIZE;
}
function thinkGetGroupEnd(group) {
  return Math.min((group + 1) * THINK_GROUP_SIZE, thinkExercises.length);
}
function thinkSaveIndex() {
  localStorage.setItem('cx_thinkIdx', String(thinkIndex));
}

// 记录已完成的组
function thinkGetDoneGroups() {
  try {
    return JSON.parse(localStorage.getItem('cx_thinkDoneGroups') || '[]');
  } catch(e) { return []; }
}
function thinkMarkGroupDone(group) {
  var done = thinkGetDoneGroups();
  if (done.indexOf(group) < 0) {
    done.push(group);
    localStorage.setItem('cx_thinkDoneGroups', JSON.stringify(done));
  }
}
function thinkIsGroupDone(group) {
  return thinkGetDoneGroups().indexOf(group) >= 0;
}

