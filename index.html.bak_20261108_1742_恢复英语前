  var h = '';
  list.forEach(function(item, idx) {
    var rankClass = 'rank-' + (idx + 1);
    var rankEmoji = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : (idx + 1);
    h += '<div class="parent-rank-item ' + rankClass + '">';
