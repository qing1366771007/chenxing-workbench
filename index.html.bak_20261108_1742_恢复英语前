  const fb = document.getElementById('engQuizFeedback');
  if (idx === correctIdx) {
    fb.textContent = '🎉 Correct! ' + engQuizCurrent.en + ' = ' + engQuizCurrent.zh;
    fb.className = 'quiz-feedback ok';
    engQuizScore++;
    document.getElementById('engQuizScoreNum').textContent = engQuizScore;
