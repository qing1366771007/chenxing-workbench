// ========== 连词填空练习 ==========
var conjMode = 'list';
var conjQuizQuestions = [];
var conjQuizCurrent = 0;
var conjQuizScore = 0;

function setConjMode(mode) {
  conjMode = mode;
  document.getElementById('conjModeList').className = 'anti-game-mode-btn' + (mode === 'list' ? ' active' : '');
  document.getElementById('conjModeQuiz').className = 'anti-game-mode-btn' + (mode === 'quiz' ? ' active' : '');
  document.getElementById('conjCatBar').style.display = mode === 'list' ? 'flex' : 'none';
  document.getElementById('conjList').style.display = mode === 'list' ? 'grid' : 'none';
  document.getElementById('conjQuizArea').style.display = mode === 'quiz' ? 'block' : 'none';
  document.getElementById('conjQuizInfo').style.display = mode === 'quiz' ? 'flex' : 'none';
  if (mode === 'quiz') {
    startConjQuiz();
  }
}

function startConjQuiz() {
  // 收集当前分类的连词
  var items = [];
  var showAll = (conjCurrentCat === '全部');
  conjData.forEach(function(item, idx) {
    if (!showAll && item.cat !== conjCurrentCat) return;
    items.push(item);
  });

  // 随机选5道
  var count = Math.min(5, items.length);
  var shuffled = items.slice().sort(function() { return Math.random() - 0.5; });
  var selected = shuffled.slice(0, count);

  conjQuizQuestions = [];
  var allWords = items.map(function(it) { return it.words; });

  selected.forEach(function(item) {
    // 把例句中的连词替换成 ______
    var sentence = item.example;
    var wordsToReplace = item.words;

    // 处理成对连词（如"因为...所以..."）
    var blanks = '';
    var parts = wordsToReplace.split(/…|.../);
    if (parts.length === 2) {
      // 成对的：把两部分都替换
      var part1 = parts[0];
      var part2 = parts[1].replace(/[。，]/g, '');
      sentence = sentence.replace(part1, '______');
      sentence = sentence.replace(part2, '______');
      blanks = wordsToReplace;
    } else {
      // 单个词
      sentence = sentence.replace(item.words, '______');
      blanks = item.words;
    }

    // 选3个干扰项
    var distractors = allWords.filter(function(w) { return w !== item.words; });
    distractors.sort(function() { return Math.random() - 0.5; });
    distractors = distractors.slice(0, 3);

    var options = [item.words].concat(distractors).sort(function() { return Math.random() - 0.5; });

    conjQuizQuestions.push({
      sentence: sentence,
      correct: item.words,
      options: options,
      cat: item.cat
    });
  });

  conjQuizCurrent = 0;
  conjQuizScore = 0;
  document.getElementById('conjQuizScore').textContent = '0';
  document.getElementById('conjQuizTotal').textContent = count;
  renderConjQuiz();
}

function renderConjQuiz() {
  var area = document.getElementById('conjQuizArea');
  if (!area) return;

  if (conjQuizCurrent >= conjQuizQuestions.length) {
    area.innerHTML = '<div class="anti-game-result">' +
      '🎉 练习完成！<br>' +
      '答对了 ' + conjQuizScore + ' / ' + conjQuizQuestions.length + ' 题<br>' +
      '<button onclick="startConjQuiz()">🔄 再来一组</button>' +
      '</div>';
    speakZh('练习完成！你答对了' + conjQuizScore + '道题。');
    return;
  }

  var q = conjQuizQuestions[conjQuizCurrent];
  var html = '';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">';
  html += '<div style="font-size:13px;color:#999;">第 ' + (conjQuizCurrent + 1) + ' 题 / 共 ' + conjQuizQuestions.length + ' 题</div>';
  html += '<button onclick="startConjQuiz()" style="padding:5px 12px;border:none;border-radius:12px;background:#f0edfc;color:#6C5CE7;font-size:12px;font-weight:600;cursor:pointer;">🔄 换一组</button>';
  html += '</div>';
  html += '<div style="background:#fff;border-radius:14px;padding:18px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,0.06);border:1px solid #e8e0ff;">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">';
  html += '<span style="font-size:11px;padding:3px 8px;border-radius:8px;background:#f0edfc;color:#6C5CE7;font-weight:600;">' + q.cat + '关系</span>';
  html += '</div>';
  html += '<div style="font-size:17px;font-weight:600;color:#2d3436;line-height:1.7;margin-bottom:16px;">' + q.sentence + '</div>';
  html += '<div style="font-size:13px;color:#999;margin-bottom:10px;">请选择合适的词填入横线：</div>';
  html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">';
  q.options.forEach(function(opt, idx) {
    html += '<div class="conj-quiz-opt" onclick="checkConjAnswer(\'' + opt.replace(/'/g, "\\'") + '\', this)" style="padding:12px;border-radius:10px;background:#f5f0ff;border:2px solid #d6cbff;font-size:15px;font-weight:600;color:#6C5CE7;text-align:center;cursor:pointer;transition:all .15s;">' + opt + '</div>';
  });
  html += '</div>';
  html += '<div id="conjQuizFeedback" style="margin-top:14px;font-size:14px;font-weight:600;text-align:center;min-height:20px;"></div>';
  html += '<button id="conjQuizNextBtn" style="display:none;margin-top:12px;width:100%;padding:10px;border:none;border-radius:10px;background:#a29bfe;color:#fff;font-size:15px;font-weight:700;cursor:pointer;" onclick="nextConjQuiz()">下一题 ➡️</button>';
  html += '</div>';

  area.innerHTML = html;
}

var conjQuizAnswered = false;
function checkConjAnswer(answer, el) {
  if (conjQuizAnswered) return;
  conjQuizAnswered = true;

  var q = conjQuizQuestions[conjQuizCurrent];
  var fb = document.getElementById('conjQuizFeedback');
  var opts = document.querySelectorAll('.conj-quiz-opt');

  if (answer === q.correct) {
    conjQuizScore++;
    document.getElementById('conjQuizScore').textContent = conjQuizScore;
    el.style.background = '#55efc4';
    el.style.borderColor = '#00b894';
    el.style.color = '#00875a';
    fb.textContent = '✅ 答对了！';
    fb.style.color = '#00b894';
    speakZh('答对了！' + q.correct);
  } else {
    el.style.background = '#fab1a0';
    el.style.borderColor = '#e17055';
    el.style.color = '#d63031';
    for (var i = 0; i < opts.length; i++) {
      if (opts[i].textContent === q.correct) {
        opts[i].style.background = '#55efc4';
        opts[i].style.borderColor = '#00b894';
        opts[i].style.color = '#00875a';
      }
    }
    fb.textContent = '❌ 不对哦，正确答案是：' + q.correct;
    fb.style.color = '#e17055';
    speakZh('不对哦，正确答案是' + q.correct);
  }

  document.getElementById('conjQuizNextBtn').style.display = 'block';
}

function nextConjQuiz() {
  conjQuizAnswered = false;
  conjQuizCurrent++;
  renderConjQuiz();
}

