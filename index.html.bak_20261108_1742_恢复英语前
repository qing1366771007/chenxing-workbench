var dynQuizScore = { correct:0, wrong:0, stars:0 };
var dynQuizCurrent = null;

function startDynQuiz() {
  dynQuizScore = { correct:0, wrong:0, stars:0 };
  document.getElementById('dynQuizCorrect').textContent = '0';
  document.getElementById('dynQuizWrong').textContent = '0';
  document.getElementById('dynQuizStars').textContent = '0';
  nextDynQuiz();
}

function nextDynQuiz() {
  var box = document.getElementById('dynQuizBox');
  if (!box) return;
  // 随机选一道题
  var idx = Math.floor(Math.random() * dynQuizData.length);
  dynQuizCurrent = dynQuizData[idx];
  var d = dynQuizCurrent;
  // 打乱选项
  var opts = d.options.slice();
  var correctText = opts[d.answer];
  // Fisher-Yates 洗牌
  for (var i = opts.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = opts[i]; opts[i] = opts[j]; opts[j] = t;
  }
  var newCorrectIdx = opts.indexOf(correctText);
  
  var h = '';
  h += '<div class="dyn-quiz-question">' + d.q + '</div>';
  h += '<div class="dyn-quiz-options">';
  for (var i = 0; i < opts.length; i++) {
    h += '<div class="dyn-quiz-option" onclick="checkDynQuizAnswer(' + i + ',' + newCorrectIdx + ',this)">' + opts[i] + '</div>';
  }
  h += '</div>';
  box.innerHTML = h;
}

function checkDynQuizAnswer(selected, correct, el) {
  var opts = el.parentElement.querySelectorAll('.dyn-quiz-option');
  // 先禁用所有选项
  for (var i = 0; i < opts.length; i++) {
    opts[i].style.pointerEvents = 'none';
    if (i === correct) {
      opts[i].style.background = '#55efc4';
      opts[i].style.borderColor = '#00b894';
      opts[i].style.color = '#00875a';
    }
  }
  if (selected === correct) {
    dynQuizScore.correct++;
    dynQuizScore.stars++;
    document.getElementById('dynQuizCorrect').textContent = dynQuizScore.correct;
    document.getElementById('dynQuizStars').textContent = dynQuizScore.stars;
    speakZh('答对了！');
  } else {
    dynQuizScore.wrong++;
    el.style.background = '#ff7675';
    el.style.borderColor = '#d63031';
    el.style.color = '#fff';
    document.getElementById('dynQuizWrong').textContent = dynQuizScore.wrong;
    speakZh('答错了，正确答案是' + dynQuizCurrent.options[dynQuizCurrent.answer]);
  }
  // 1.5秒后下一题
  setTimeout(function() { nextDynQuiz(); }, 1800);
}

