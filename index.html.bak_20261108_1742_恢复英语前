    fb.style.color = '#e17055';
    speakZh('不对哦，正确答案是' + q.correct);
  }

  document.getElementById('emoQuizNextBtn').style.display = 'block';
}

function nextEmoQuiz() {
  emoQuizAnswered = false;
  emoQuizCurrent++;
  renderEmoQuiz();
}

