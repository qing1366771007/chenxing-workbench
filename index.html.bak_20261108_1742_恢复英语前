}
.draw-guide-box.show { display:block; animation:pop .3s; }
.draw-guide-title { font-size:16px; font-weight:700; color:var(--star-pink); margin-bottom:8px; display:flex; align-items:center; gap:6px; }
.draw-guide-steps { font-size:14px; color:var(--text-dark); line-height:1.8; }
.draw-guide-steps .step-num {
  display:inline-block; width:20px; height:20px; border-radius:50%;
