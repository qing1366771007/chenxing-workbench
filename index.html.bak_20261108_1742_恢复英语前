function dynBack() {
  dynCurrentIdx = -1;
  document.getElementById('dynDetail').style.display = 'none';
  document.getElementById('dynTimeline').style.display = 'flex';
}

function readDyn() {
  if (dynCurrentIdx < 0) return;
  var d = dynData[dynCurrentIdx];
  var text = d.name + '。' + d.years + '。' +
    '朝代概况。' + d.desc +
    '朝代故事。' + d.story +
    '趣味知识。' + d.fact;
  speakZh(text);
}

function dynPrev() {
  if (dynCurrentIdx <= 0) dynCurrentIdx = dynData.length;
  showDyn(dynCurrentIdx - 1);
}

function dynNext() {
  if (dynCurrentIdx >= dynData.length - 1) dynCurrentIdx = -1;
  showDyn(dynCurrentIdx + 1);
}


