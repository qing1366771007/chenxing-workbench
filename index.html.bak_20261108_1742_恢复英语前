// 乘法练习
let mathMulLevel = 5;          // 5 = 1~5口诀, 9 = 1~9口诀, 'reverse' = 逆向填空
let mathMulMode = 'normal';    // 'normal' | 'reverse'
let mathMulCurrent = null;
let mathMulAnswer = '';
let mathMulCorrectCount = 0, mathMulWrongCount = 0, mathMulStarCount = 0;

function setMathMulLevel(level, el) {
  mathMulLevel = level;
  if (level === 'reverse') {
    mathMulMode = 'reverse';
  } else {
    mathMulMode = 'normal';
  }
  if (el) {
    el.parentElement.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }
  newMathMulProblem();
}

function newMathMulProblem() {
  let a, b, ans, question, blankPos;
  let max = mathMulMode === 'reverse' ? 9 : mathMulLevel;

  if (mathMulMode === 'reverse') {
    // 逆向填空：? × b = ans 或 a × ? = ans
    a = Math.floor(Math.random() * max) + 1;
    b = Math.floor(Math.random() * max) + 1;
    ans = a * b;
    blankPos = Math.random() > 0.5 ? 'a' : 'b';
    if (blankPos === 'a') {
      question = '□ × ' + b + ' = ' + ans;
      mathMulCurrent = { a: a, b: b, ans: a, question: question, blankType: 'a' };
      speakQuestion('几乘' + b + '等于' + ans);
    } else {
      question = a + ' × □ = ' + ans;
      mathMulCurrent = { a: a, b: b, ans: b, question: question, blankType: 'b' };
      speakQuestion(a + '乘几等于' + ans);
    }
  } else {
    // 正向乘法：a × b = ?
    a = Math.floor(Math.random() * max) + 1;
    b = Math.floor(Math.random() * max) + 1;
    // 保证小的数在前（符合口诀习惯）
    if (a > b) { var t = a; a = b; b = t; }
    ans = a * b;
    question = a + ' × ' + b + ' =';
    mathMulCurrent = { a: a, b: b, ans: ans, question: question, blankType: 'ans' };
    speakQuestion(a + '乘' + b + '等于几');
  }

  mathMulAnswer = '';
  document.getElementById('mathMulProblem').textContent = question;
  document.getElementById('mathMulAnswer').textContent = '';
  document.getElementById('mathMulFeedback').textContent = '';
  document.getElementById('mathMulFeedback').className = 'math-feedback';
}

function mathMulInput(val) {
  if (val === 'del') { mathMulAnswer = mathMulAnswer.slice(0, -1); }
  else if (val === 'ok') { checkMathMul(); return; }
  else { if (mathMulAnswer.length < 3) mathMulAnswer += val; }
  document.getElementById('mathMulAnswer').textContent = mathMulAnswer;
}

function checkMathMul() {
  if (!mathMulCurrent || mathMulAnswer === '') return;
  const fb = document.getElementById('mathMulFeedback');
