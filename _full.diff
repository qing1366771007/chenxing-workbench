+// 慢速朗读（给小朋友听的，语速更慢）
+function speakSlow(text, lang) {
+  if (!text) return;
+  text = String(text).trim();
+  if (!text) return;
+  if (text.length > 200) text = text.substring(0, 200);
+
+  // 在 Android App 里用原生TTS慢速
+  if (window.AndroidTTS && window.AndroidTTS.speak) {
+    if (!lang.startsWith('en')) {
+      try {
+        window.AndroidTTS.speak(text, 'zh');
+        return;
+      } catch(e) {}
+    }
+  }
+
+  var baiduLan = lang.startsWith('en') ? 'en' : 'zh';
+  // 慢速：spd=5 比默认的3更慢（百度TTS值越大越慢）
+  if (lang.startsWith('en')) {
+    var url = '/api/tts?lang=' + baiduLan + '&text=' + encodeURIComponent(text) + '&spd=5';
+  } else {
+    var url = 'https://fanyi.baidu.com/gettts?lan=' + baiduLan +
+      '&text=' + encodeURIComponent(text) + '&spd=5&source=web';
+  }
+
+  var player = _getTTSPlayer();
+  var bar = _getTTSBar();
+  var label = _getTTSLabel();
+  if (!player || !bar) return;
+
+  if (label) label.textContent = text.length > 12 ? text.substring(0, 12) + '...' : text;
+  bar.classList.add('show');
+  player.src = url;
+  player.load();
+  var playPromise = player.play();
+  if (playPromise && playPromise.catch) {
+    playPromise.catch(function(e) {
+      bar.classList.remove('show');
+      _speakSynthesisSlow(text, lang);
+    });
+  }
+  if (window._baiduTTSTimer) { clearTimeout(window._baiduTTSTimer); }
+  window._baiduTTSTimer = setTimeout(function() {
+    var p = _getTTSPlayer();
+    if (p && (p.readyState < 2 || p.paused)) {
+      bar.classList.remove('show');
+      _speakSynthesisSlow(text, lang);
+    }
+  }, 5000);
+  player.onerror = function() {
+    if (window._baiduTTSTimer) { clearTimeout(window._baiduTTSTimer); }
+    bar.classList.remove('show');
+    _speakSynthesisSlow(text, lang);
+  };
+}
+
+function _speakSynthesisSlow(text, lang) {
