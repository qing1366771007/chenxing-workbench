    list.appendChild(addCard);
  } else {
    // 正常模式：打卡
    habitList.forEach(h => {
      var done = data[today].habits[h.id];
      var card = document.createElement('div');
      card.className = 'content-card';
      card.style.cssText = 'padding:16px 12px;text-align:center;cursor:pointer;transition:all .2s;' + 
