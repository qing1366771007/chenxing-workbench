function buildStoryPrintHtml(stories, showAll) {
  var html = '<!DOCTYPE html><html><head><meta charset="utf-8">';
  html += '<title>识字故事' + (showAll ? '合集' : '') + '</title>';
  html += '<style>';
  html += '@page { size:A4 landscape; margin:0.8cm; }';
  html += '* { box-sizing:border-box; }';
  html += 'html, body { width:100%; margin:0; padding:0; }';
  html += 'body { font-family:"Microsoft YaHei","PingFang SC","Noto Sans CJK SC",sans-serif; color:#333; }';
  html += '.page-wrap { display:flex; flex-direction:row; height:100vh; }';
  html += '.half { flex:1; display:flex; flex-direction:column; overflow:hidden; }';
  html += '.half.half-left { padding-right:1cm; }';
  html += '.half.half-right { padding-left:1cm; }';
  html += '.cut-line { flex:none; width:0; border-left:2px dashed #aaa; position:relative; }';
  html += '.cut-line::after { content:"✂ 裁剪线"; position:absolute; bottom:0; left:-20px; background:#fff; padding:2px 4px; font-size:9px; color:#999; writing-mode:vertical-rl; }';
  html += '.story-title { text-align:center; font-size:17px; font-weight:700; margin-bottom:4px; color:#e67e22; }';
  html += '.story-num { text-align:center; font-size:10px; color:#999; margin-bottom:3px; }';
  html += '.story-text { font-size:13px; line-height:2.6; text-indent:2em; flex:1; }';
  html += '.story-text p { margin:0 0 6px 0; }';
  html += '.story-text rt { font-size:8px; color:#aaa; font-weight:400; }';
  html += '.story-footer { text-align:center; font-size:9px; color:#bbb; margin-top:4px; }';
  html += '@media print { .no-print { display:none; } body { -webkit-print-color-adjust:exact; print-color-adjust:exact; } .page-wrap { height:100vh; overflow:hidden; } }';
  html += '</style></head><body>';

  // 每篇故事占半页（A5），每页放2篇（左右各1篇）
  var perPage = 2;
  var totalPages = Math.ceil(stories.length / perPage);

  for (var p = 0; p < totalPages; p++) {
    var start = p * perPage;
    var end = Math.min(start + perPage, stories.length);
    var pageStories = stories.slice(start, end);

    if (p > 0) {
      html += '<div class="page-wrap" style="page-break-before:always;">';
    } else {
      html += '<div class="page-wrap">';
    }

    // 左半部分
    html += '<div class="half half-left">';
    if (pageStories[0]) {
      html += '<div class="story-num">' + pageStories[0].num + '</div>';
      html += '<div class="story-title">' + pageStories[0].title + '</div>';
      html += '<div class="story-text">';
      pageStories[0].content.forEach(function(para) { html += '<p>' + _textWithPinyin(para) + '</p>'; });
      html += '</div>';
      html += '<div class="story-footer">辰星工作台 · 识字故事</div>';
    }
    html += '</div>';

    // 裁剪线
    html += '<div class="cut-line"></div>';

    // 右半部分
    html += '<div class="half half-right">';
    if (pageStories[1]) {
      html += '<div class="story-num">' + pageStories[1].num + '</div>';
      html += '<div class="story-title">' + pageStories[1].title + '</div>';
      html += '<div class="story-text">';
      pageStories[1].content.forEach(function(para) { html += '<p>' + _textWithPinyin(para) + '</p>'; });
      html += '</div>';
      html += '<div class="story-footer">辰星工作台 · 识字故事</div>';
    }
    html += '</div>';

    html += '</div>';
  }

  html += '</body></html>';
  return html;
}
