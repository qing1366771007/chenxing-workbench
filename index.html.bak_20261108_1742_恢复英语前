// 背诵单列
// mode: 'recite' = 连读一遍, 'follow' = 老师领读跟读
// 顺序：mulCol×mulCol, mulCol×(mulCol+1), ..., mulCol×9
let mulReciteMode = 'recite';
let mulReciteCur = 0; // 当前朗读的行号
function startMulRecite(mode) {
  if (mulReciting) return;
  mulReciting = true;
  mulReciteMode = mode || 'recite';
  mulReciteCur = mulCol - 1; // 从 mulCol 开始，先-1再+1
  var startBtn = document.getElementById('mulStartBtn');
  var followBtn = document.getElementById('mulFollowBtn');
  var stopBtn = document.getElementById('mulStopBtn');
  if (startBtn) { startBtn.classList.add('disabled'); startBtn.textContent = '⏳ 背诵中...'; }
  if (followBtn) { followBtn.classList.add('disabled'); }
  if (stopBtn) { stopBtn.classList.remove('disabled'); }
  reciteMulStep();
}

function reciteMulStep() {
  if (!mulReciting) return;
  if (mulReciteCur >= 9) {
    // 背诵完成
    mulReciting = false;
    var startBtn = document.getElementById('mulStartBtn');
    var followBtn = document.getElementById('mulFollowBtn');
    var stopBtn = document.getElementById('mulStopBtn');
    if (startBtn) { startBtn.classList.remove('disabled'); startBtn.textContent = '🔊 连读一遍'; }
    if (followBtn) { followBtn.classList.remove('disabled'); }
    if (stopBtn) { stopBtn.classList.add('disabled'); }
    // 清除高亮
    for (var i = mulCol; i <= 9; i++) {
      var cell = document.getElementById('mulcell_' + i);
      if (cell) cell.style.background = 'rgba(46,204,113,0.15)';
    }
    setTimeout(function() { onCorrect('全部背完了！太棒了！'); }, 300);
    return;
  }

  mulReciteCur++;
  var i = mulReciteCur;
  var j = mulCol;
  var formula = mulFormula(j, i);
  var speakText = mulSpeakText(j, i);

  // 更新显示
  var formulaEl = document.getElementById('mulFormula');
  var hintEl = document.getElementById('mulSpeakHint');
  if (formulaEl) formulaEl.innerHTML = '<span class="highlight">' + formula + '</span>';
  if (hintEl) {
    if (mulReciteMode === 'follow') {
      hintEl.textContent = '👨‍🏫 老师读：' + speakText + '（请跟读）';
    } else {
      hintEl.textContent = speakText;
    }
  }

  // 高亮当前格
  for (var k = mulCol; k <= 9; k++) {
    var cell = document.getElementById('mulcell_' + k);
    if (cell) {
      if (k < i) cell.style.background = 'rgba(46,204,113,0.15)';
      else if (k === i) {
        cell.style.background = 'var(--star-orange)';
        cell.style.color = '#fff';
      } else {
        cell.style.background = '#f8f8f8';
        cell.style.color = '';
      }
    }
  }

  // 朗读
  speakZh(speakText);

  // 下一步：跟读模式间隔更长（老师读完→停顿→孩子跟读时间）
  var delay = mulReciteMode === 'follow' ? 3500 : 2200;
  mulReciteTimer = setTimeout(reciteMulStep, delay);
}

// 全表连读 - 按列顺序
// mode: 'recite' = 连读一遍, 'follow' = 老师领读跟读
// 顺序：1×1 1×2...1×9; 2×2 2×3...2×9; ... 9×9
function startMulReciteAll(mode) {
  if (mulReciting) return;
  mulReciting = true;
  mulReciteMode = mode || 'recite';
  mulReciteIdx = 0;
  var startBtn = document.getElementById('mulStartBtn');
  var followBtn = document.getElementById('mulFollowBtn');
  var stopBtn = document.getElementById('mulStopBtn');
  if (startBtn) { startBtn.classList.add('disabled'); startBtn.textContent = '⏳ 连读中...'; }
  if (followBtn) { followBtn.classList.add('disabled'); }
  if (stopBtn) { stopBtn.classList.remove('disabled'); }
  reciteMulAllStep();
}

// 预生成口诀序列（按列，共45句）
// 第1列: 1×1, 1×2, 1×3, ..., 1×9
// 第2列: 2×2, 2×3, ..., 2×9
// 第N列: N×N, N×(N+1), ..., N×9
function _getMulSequence() {
  var seq = [];
  for (var col = 1; col <= 9; col++) {
    for (var row = col; row <= 9; row++) {
      seq.push({ i: row, j: col });
    }
  }
  return seq;
}

function reciteMulAllStep() {
  if (!mulReciting) return;
  var seq = _getMulSequence();
  if (mulReciteIdx >= seq.length) {
    // 完成
    mulReciting = false;
    var startBtn = document.getElementById('mulStartBtn');
    var followBtn = document.getElementById('mulFollowBtn');
    var stopBtn = document.getElementById('mulStopBtn');
    if (startBtn) { startBtn.classList.remove('disabled'); startBtn.textContent = '🔊 连读一遍'; }
    if (followBtn) { followBtn.classList.remove('disabled'); }
    if (stopBtn) { stopBtn.classList.add('disabled'); }
    // 标记所有完成
    for (var i = 0; i < seq.length; i++) {
      var item = seq[i];
      var cell = document.getElementById('mulcell_' + item.i + '_' + item.j);
      if (cell) { cell.classList.remove('current'); cell.classList.add('done'); cell.style.background = 'rgba(46,204,113,0.15)'; cell.style.color = ''; }
    }
    setTimeout(function() { onCorrect('全部背完了！太棒了！'); }, 300);
    return;
  }

  var item = seq[mulReciteIdx];
  var i = item.i, j = item.j;
  var formula = mulFormula(j, i);
  var speakText = mulSpeakText(j, i);

  // 更新提示文字
  var hintEl = document.getElementById('mulHintText');
  if (hintEl) {
    if (mulReciteMode === 'follow') {
      hintEl.textContent = '👨‍🏫 老师读：' + speakText + '（请跟读）';
    } else {
      hintEl.textContent = speakText;
    }
  }

  // 高亮当前格，之前的标记完成
  for (var k = 0; k < seq.length; k++) {
    var it = seq[k];
    var cell = document.getElementById('mulcell_' + it.i + '_' + it.j);
    if (cell) {
      cell.classList.remove('current');
      if (k < mulReciteIdx) {
        cell.style.background = 'rgba(46,204,113,0.15)';
        cell.style.color = '';
      } else if (k === mulReciteIdx) {
        cell.style.background = 'var(--star-orange)';
        cell.style.color = '#fff';
        cell.style.fontWeight = '700';
      } else {
        cell.style.background = '#f8f8f8';
        cell.style.color = '';
      }
    }
  }

  // 朗读
  speakZh(speakText);

  mulReciteIdx++;
  // 跟读模式：老师读完后停顿，让孩子跟读
  var delay = mulReciteMode === 'follow' ? 3500 : 2000;
  mulReciteTimer = setTimeout(reciteMulAllStep, delay);
}

function stopMulRecite() {
  mulReciting = false;
  if (mulReciteTimer) { clearTimeout(mulReciteTimer); clearInterval(mulReciteTimer); mulReciteTimer = null; }
  var startBtn = document.getElementById('mulStartBtn');
  var followBtn = document.getElementById('mulFollowBtn');
  var stopBtn = document.getElementById('mulStopBtn');
  if (startBtn) {
    startBtn.classList.remove('disabled');
    startBtn.textContent = '🔊 连读一遍';
  }
  if (followBtn) { followBtn.classList.remove('disabled'); }
  if (stopBtn) { stopBtn.classList.add('disabled'); }
}

// 测验模式
let mulTestQ = null;       // {i, j, ans}
let mulTestOpts = [];
let mulTestAnswered = false;
let mulTestScore = 0;
let mulTestRound = 0;
let mulTestMode = 'select'; // 'select' = 选答案, 'fill' = 填答案
let mulFillInput = '';      // 填空模式的输入内容
const MUL_TEST_SIZE = 100;

function renderMulTest(container) {
  mulTestScore = 0;
  mulTestRound = -1;
  mulFillInput = '';
  container.innerHTML =
    '<div class="mul-test-mode-bar">' +
      '<div class="mul-test-mode-btn ' + (mulTestMode === 'select' ? 'active' : '') + '" onclick="setMulTestMode(\'select\')">🎯 选答案</div>' +
      '<div class="mul-test-mode-btn ' + (mulTestMode === 'fill' ? 'active' : '') + '" onclick="setMulTestMode(\'fill\')">✏️ 填答案</div>' +
    '</div>' +
    '<div class="quiz-score-bar">' +
      '<span>第 <span class="score-num" id="mulTestRoundNum">1</span> / ' + MUL_TEST_SIZE + ' 题</span>' +
      '<span>⭐ 得分：<span class="score-num" id="mulTestScoreNum">0</span></span>' +
    '</div>' +
    '<div class="mul-test-box" id="mulTestBox"></div>';
  nextMulTest();
}

function setMulTestMode(mode) {
  mulTestMode = mode;
  mulTestScore = 0;
  mulTestRound = -1;
  mulFillInput = '';
  var container = document.getElementById('mulContent');
  renderMulTest(container);
}

function nextMulTest() {
  mulTestRound++;
  if (mulTestRound >= MUL_TEST_SIZE) {
    showMulTestResult();
    return;
  }
  document.getElementById('mulTestRoundNum').textContent = mulTestRound + 1;
  document.getElementById('mulTestScoreNum').textContent = mulTestScore;
  mulTestAnswered = false;

  // 生成题目（确保小的数在前，如1×2=2而不是2×1=2）
  if (mulCol === 0) {
    // 全部范围：i为较大数，j为较小数
    mulTestQ = { i: Math.floor(Math.random() * 9) + 1, j: Math.floor(Math.random() * 9) + 1 };
    if (mulTestQ.j > mulTestQ.i) { var tmp = mulTestQ.j; mulTestQ.j = mulTestQ.i; mulTestQ.i = tmp; }
  } else {
    // 指定列：j=列号（较小的数），i从列号到9
    mulTestQ = { i: Math.floor(Math.random() * (10 - mulCol)) + mulCol, j: mulCol };
  }
  mulTestQ.ans = mulTestQ.i * mulTestQ.j;

  // 生成选项
  var opts = [mulTestQ.ans];
  while (opts.length < 4) {
    var delta = (Math.floor(Math.random() * 6) - 3);
    if (delta === 0) continue;
    var wrong = mulTestQ.ans + delta;
    if (wrong < 1 || opts.indexOf(wrong) >= 0) continue;
    opts.push(wrong);
  }
  opts.sort(function() { return Math.random() - 0.5; });
  mulTestOpts = opts;

  var box = document.getElementById('mulTestBox');
  var questionText = mulTestQ.j + ' × ' + mulTestQ.i + ' = ?';

  if (mulTestMode === 'select') {
    // 选答案模式
    var optsHTML = '<div class="mul-test-options">';
    mulTestOpts.forEach(function(opt, i2) {
      optsHTML += '<div class="mul-test-opt" onclick="checkMulTest(' + i2 + ')">' + opt + '</div>';
    });
    optsHTML += '</div>';

    box.innerHTML =
      '<div class="mul-test-question">' + questionText + '</div>' +
      optsHTML +
      '<div class="quiz-feedback" id="mulTestFeedback"></div>' +
      '<button class="quiz-next-btn" id="mulTestNextBtn" onclick="nextMulTest()" style="display:none;background:var(--star-blue);">下一题 ➡️</button>';
  } else {
    // 填答案模式
    mulFillInput = '';
    box.innerHTML =
      '<div class="mul-test-question">' + questionText + '</div>' +
      '<div class="mul-fill-answer-box">' +
        '<div class="mul-fill-display" id="mulFillDisplay">&nbsp;</div>' +
      '</div>' +
      '<div class="mul-fill-keypad">' +
        '<div class="mul-key" onclick="mulKeyPress(\'1\')">1</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'2\')">2</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'3\')">3</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'4\')">4</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'5\')">5</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'6\')">6</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'7\')">7</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'8\')">8</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'9\')">9</div>' +
        '<div class="mul-key mul-key-del" onclick="mulKeyPress(\'del\')">⌫</div>' +
        '<div class="mul-key" onclick="mulKeyPress(\'0\')">0</div>' +
        '<div class="mul-key mul-key-ok" onclick="mulKeyPress(\'ok\')">✓</div>' +
      '</div>' +
      '<div class="quiz-feedback" id="mulTestFeedback"></div>' +
      '<button class="quiz-next-btn" id="mulTestNextBtn" onclick="nextMulTest()" style="display:none;background:var(--star-blue);">下一题 ➡️</button>';
  }

  // 朗读题目（只读题目，不读答案）
  speakQuestion(mulSpeakQuestion(mulTestQ.j, mulTestQ.i));
}

// 填空模式：数字键盘输入
function mulKeyPress(key) {
  if (mulTestAnswered) return;
  if (key === 'del') {
    mulFillInput = mulFillInput.slice(0, -1);
  } else if (key === 'ok') {
    if (mulFillInput === '') return;
    checkMulFill();
    return;
  } else {
    if (mulFillInput.length >= 2) return; // 最多2位数（9×9=81）
    mulFillInput += key;
  }
  var display = document.getElementById('mulFillDisplay');
  if (display) {
    display.textContent = mulFillInput || '\u00A0';
    display.classList.remove('correct-anim', 'wrong-anim');
  }
}

function checkMulFill() {
  if (mulTestAnswered) return;
  mulTestAnswered = true;
  var userAns = parseInt(mulFillInput);
  var display = document.getElementById('mulFillDisplay');
  var fb = document.getElementById('mulTestFeedback');
  if (userAns === mulTestQ.ans) {
    display.classList.add('correct-anim');
    fb.textContent = '🎉 答对了！' + mulTestQ.j + '×' + mulTestQ.i + '=' + mulTestQ.ans;
    fb.className = 'quiz-feedback ok';
    mulTestScore++;
    document.getElementById('mulTestScoreNum').textContent = mulTestScore;
    addStars(1);
    onCorrect('答对了！');
  } else {
    display.classList.add('wrong-anim');
    fb.textContent = '💪 正确答案是 ' + mulTestQ.ans + '（你填的是 ' + userAns + '）';
    fb.className = 'quiz-feedback no';
    onWrong();
    setTimeout(function() { speakZh(mulSpeakText(mulTestQ.j, mulTestQ.i)); }, 600);
  }
  document.getElementById('mulTestNextBtn').style.display = 'block';
}

function checkMulTest(idx) {
  if (mulTestAnswered) return;
  mulTestAnswered = true;
  var opts = document.querySelectorAll('#mulTestBox .mul-test-opt');
  var correctIdx = mulTestOpts.indexOf(mulTestQ.ans);
  opts.forEach(function(o, i2) {
    if (i2 === correctIdx) o.classList.add('correct');
    else if (i2 === idx) o.classList.add('wrong');
  });
  var fb = document.getElementById('mulTestFeedback');
  if (mulTestOpts[idx] === mulTestQ.ans) {
    fb.textContent = '🎉 答对了！' + mulTestQ.j + '×' + mulTestQ.i + '=' + mulTestQ.ans;
    fb.className = 'quiz-feedback ok';
    mulTestScore++;
    document.getElementById('mulTestScoreNum').textContent = mulTestScore;
    addStars(1);
    onCorrect('答对了！');
  } else {
    fb.textContent = '💪 正确答案是 ' + mulTestQ.ans;
    fb.className = 'quiz-feedback no';
    onWrong();
    setTimeout(function() { speakZh(mulSpeakText(mulTestQ.j, mulTestQ.i)); }, 600);
  }
  document.getElementById('mulTestNextBtn').style.display = 'block';
}

function showMulTestResult() {
  var box = document.getElementById('mulTestBox');
  var emoji, title;
  var rate = mulTestScore / MUL_TEST_SIZE;
  if (rate >= 0.95) { emoji = '🏆'; title = '乘法小达人！'; }
  else if (rate >= 0.8) { emoji = '🌟'; title = '很厉害！继续加油！'; }
  else if (rate >= 0.6) { emoji = '😊'; title = '不错哦，再练练！'; }
  else { emoji = '💪'; title = '没关系，多背多练！'; }

  box.innerHTML =
    '<div class="quiz-result">' +
      '<div class="big-emoji">' + emoji + '</div>' +
      '<div class="result-title">' + title + '</div>' +
      '<div class="result-score">得分：' + mulTestScore + ' / ' + MUL_TEST_SIZE + ' ⭐</div>' +
      '<button class="restart-btn" onclick="renderMulTest(document.getElementById(\'mulContent\'))" style="background:var(--star-blue);">🔄 再来一轮</button>' +
    '</div>';
  if (rate >= 0.8) {
    showReward('闯关成功！', '获得' + mulTestScore + '颗星星');
  }
}


