    speakZh(pyQuizCurrent.c);
    var fb = document.getElementById('pyQuizFeedback');
    if (fb) {
      fb.textContent = '这个字读 "' + pyQuizCurrent.c + '"，拼音是 ' + pyQuizCurrent.p;
      fb.className = 'pyquiz-feedback ok';
    }
    pyQuizScore++;
    document.getElementById('pyQuizScoreNum').textContent = pyQuizScore;
    addStars(1);
    onCorrect('读对了！真棒！');
  }
}

function checkPyQuiz(idx) {
  if (pyQuizAnswered) return;
  pyQuizAnswered = true;
  var opts = document.querySelectorAll('#pyQuizCard .pyquiz-opt');
  var correctIdx = pyQuizOptions.indexOf(pyQuizCurrent);
  opts.forEach(function(o, i) {
    if (i === correctIdx) o.classList.add('correct');
    else if (i === idx) o.classList.add('wrong');
  });
  var fb = document.getElementById('pyQuizFeedback');
  if (pyQuizOptions[idx] === pyQuizCurrent) {
    fb.textContent = '🎉 答对了！' + pyQuizCurrent.p + ' → ' + pyQuizCurrent.c;
    fb.className = 'pyquiz-feedback ok';
    pyQuizScore++;
    document.getElementById('pyQuizScoreNum').textContent = pyQuizScore;
    addStars(1);
    onCorrect('答对了！');
  } else {
    var correctOpt = pyQuizMode === 'pinyin2char' ? pyQuizCurrent.c : pyQuizCurrent.p;
    fb.textContent = '💪 正确答案是 "' + correctOpt + '"';
    fb.className = 'pyquiz-feedback no';
    onWrong();
    setTimeout(function() { speakZh(pyQuizCurrent.c); }, 600);
  }
  document.getElementById('pyQuizNextBtn').style.display = 'inline-block';
}

function showPyQuizResult() {
  var card = document.getElementById('pyQuizCard');
  var emoji, title;
  if (pyQuizScore >= 9) { emoji = '🏆'; title = '拼音小达人！'; }
  else if (pyQuizScore >= 7) { emoji = '🌟'; title = '很厉害！继续加油！'; }
  else if (pyQuizScore >= 5) { emoji = '😊'; title = '不错哦，再练练！'; }
  else { emoji = '💪'; title = '别灰心，多读多练！'; }
  card.innerHTML =
    '<div class="pyquiz-result">' +
      '<div class="pyquiz-result-emoji">' + emoji + '</div>' +
      '<div class="pyquiz-result-title">' + title + '</div>' +
      '<div class="pyquiz-result-score">得分：' + pyQuizScore + ' / ' + pyQuizRoundSize + ' ⭐</div>' +
