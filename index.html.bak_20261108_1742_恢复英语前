var origamiCurrentIdx = -1;
var origamiCurrentStep = 0;
var origamiFilter = 'all';

function setOrigamiFilter(filter, btn) {
  origamiFilter = filter;
  document.querySelectorAll('.origami-filter-btn').forEach(function(b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  renderOrigamiGrid();
}

function initOrigami() {
  origamiCurrentIdx = -1;
  origamiCurrentStep = 0;
  document.getElementById('origamiList').style.display = 'block';
  document.getElementById('origamiDetail').style.display = 'none';
  renderOrigamiGrid();
}

function renderOrigamiGrid() {
  var grid = document.getElementById('origamiGrid');
  var html = '';
  origamiData.forEach(function(item, idx) {
    if (origamiFilter !== 'all' && item.paperType !== origamiFilter) return;
    var diffText = item.difficulty === 'easy' ? '简单' : item.difficulty === 'medium' ? '中等' : '稍难';
    html += '<div class="origami-card" onclick="openOrigami(' + idx + ')">';
    html += '<div class="oc-icon">' + item.icon + '</div>';
    html += '<div class="oc-name">' + item.name + '</div>';
    html += '<div class="oc-meta">' + item.paper + ' · ' + item.steps + '步</div>';
    html += '<div class="oc-difficulty ' + item.difficulty + '">' + diffText + '</div>';
    html += '</div>';
  });
  grid.innerHTML = html;
}

function openOrigami(idx) {
  origamiCurrentIdx = idx;
  origamiCurrentStep = 0;
  document.getElementById('origamiList').style.display = 'none';
  document.getElementById('origamiDetail').style.display = 'block';
  renderOrigamiDetail();
}

function origamiBack() {
  document.getElementById('origamiList').style.display = 'block';
  document.getElementById('origamiDetail').style.display = 'none';
  speechSynthesis.cancel();
}

function renderOrigamiDetail() {
  var item = origamiData[origamiCurrentIdx];
  document.getElementById('origamiDetailTitle').textContent = item.icon + ' ' + item.name;
  document.getElementById('origamiDetailMeta').textContent = item.paper + ' · 共' + item.steps + '步';
  document.getElementById('origamiStepCounter').textContent = (origamiCurrentStep + 1) + ' / ' + item.steps;
  document.getElementById('origamiStepDesc').textContent = item.steps[origamiCurrentStep].desc;
  document.getElementById('origamiStepSvg').innerHTML = getOrigamiSvg(item.steps[origamiCurrentStep].svg);

  // 上一步/下一步按钮状态
  var prevBtn = document.querySelector('.origami-step-btn.prev');
  var nextBtn = document.querySelector('.origami-step-btn.next');
  if (prevBtn) prevBtn.disabled = origamiCurrentStep === 0;
  if (nextBtn) nextBtn.disabled = origamiCurrentStep >= item.steps - 1;

  // 步骤小圆点
  var dotsHtml = '';
  for (var i = 0; i < item.steps.length; i++) {
    dotsHtml += '<div class="origami-step-dot ' + (i === origamiCurrentStep ? 'active' : '') +
      '" onclick="jumpOrigamiStep(' + i + ')"></div>';
  }
  document.getElementById('origamiStepDots').innerHTML = dotsHtml;
}

function origamiNextStep() {
  var item = origamiData[origamiCurrentIdx];
  if (origamiCurrentStep < item.steps.length - 1) {
    origamiCurrentStep++;
    renderOrigamiDetail();
    speakOrigamiStep();
  }
}

function origamiPrevStep() {
  if (origamiCurrentStep > 0) {
    origamiCurrentStep--;
    renderOrigamiDetail();
    speakOrigamiStep();
  }
}

function jumpOrigamiStep(s) {
  origamiCurrentStep = s;
  renderOrigamiDetail();
  speakOrigamiStep();
}

function speakOrigamiStep() {
  var item = origamiData[origamiCurrentIdx];
  var step = item.steps[origamiCurrentStep];
  speakZh('第' + (origamiCurrentStep + 1) + '步，' + step.desc);
}

// 折纸SVG图（简化版示意图）
function getOrigamiSvg(key) {
  var paperColor = '#FF6B6B';
  var paperLight = '#FFE0E0';
  var foldLine = '#e74c3c';
  var arrowColor = '#3498db';
  var w = 200, h = 180;
  var cx = w / 2, cy = h / 2;

  var svgStart = '<svg viewBox="0 0 ' + w + ' ' + h + '" xmlns="http://www.w3.org/2000/svg">';
  var svgEnd = '</svg>';

  // 通用：正方形
  function square(size, color) {
    var s = size || 120;
    var c = color || paperColor;
    var x = cx - s/2, y = cy - s/2;
    return '<rect x="' + x + '" y="' + y + '" width="' + s + '" height="' + s + '" fill="' + c + '" stroke="#333" stroke-width="1.5"/>';
  }

  // 折痕虚线
  function vFold(x, y1, y2) {
    return '<line x1="' + x + '" y1="' + y1 + '" x2="' + x + '" y2="' + y2 + '" stroke="' + foldLine + '" stroke-width="1.5" stroke-dasharray="4,3"/>';
  }
  function hFold(y, x1, x2) {
    return '<line x1="' + x1 + '" y1="' + y + '" x2="' + x2 + '" y2="' + y + '" stroke="' + foldLine + '" stroke-width="1.5" stroke-dasharray="4,3"/>';
  }

  // 箭头
