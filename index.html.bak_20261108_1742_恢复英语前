  else if (cfg.cols === 3) { fontSize = is3 ? '13px' : '14px'; gap = '3px 6px'; pad = '2px 3px'; lineHeight = is3 ? '1.9' : '2.0'; }
  else { fontSize = is3 ? '12px' : '13px'; gap = '3px 8px'; pad = '2px 3px'; lineHeight = is3 ? '2.0' : '1.9'; }

  function buildHalf(probs, showAns, pageNum, halfNum) {
