let pyQuizMode = 'pinyin2char'; // 'pinyin2char' = 看拼音选字, 'sound2pinyin' = 听音选拼音, 'char2read' = 看字读音
let pyQuizScore = 0;
let pyQuizRound = 0;
let pyQuizRoundSize = 10;
let pyQuizCurrent = null;
let pyQuizOptions = [];
let pyQuizAnswered = false;
let pyQuizShuffled = [];

function initPyQuiz() {
  pyQuizScore = 0;
  pyQuizRound = -1;
  pyQuizShuffled = [...pyQuizPool].sort(() => Math.random() - 0.5);
  renderPyQuizMode();
  nextPyQuiz();
}

function setPyQuizMode(mode) {
  pyQuizMode = mode;
  pyQuizScore = 0;
  pyQuizRound = -1;
  pyQuizShuffled = [...pyQuizPool].sort(() => Math.random() - 0.5);
  renderPyQuizMode();
  nextPyQuiz();
}

function renderPyQuizMode() {
  var container = document.getElementById('pyQuizContainer');
  if (!container) return;
  container.innerHTML =
    '<div class="pyquiz-mode-bar">' +
      '<div class="pyquiz-mode-btn ' + (pyQuizMode === 'pinyin2char' ? 'active' : '') + '" onclick="setPyQuizMode(\'pinyin2char\')">📖 看拼音选字</div>' +
