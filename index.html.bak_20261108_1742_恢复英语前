// 生成口诀文本，如 2×3=6
function mulFormula(i, j) {
  return i + '×' + j + '=' + (i * j);
}

// 中文朗读文本，如 "二三得六"
function mulSpeakText(i, j) {
  var product = i * j;
  var cnNum = ['','一','二','三','四','五','六','七','八','九','十'];
  var prodText;
  if (product < 10) {
    prodText = '得' + cnNum[product];
  } else if (product === 10) {
    prodText = '一十';
  } else if (product < 20) {
    prodText = '十' + cnNum[product - 10];
  } else if (product < 100) {
    var tens = Math.floor(product / 10);
    var ones = product % 10;
    prodText = cnNum[tens] + '十' + (ones > 0 ? cnNum[ones] : '');
  } else {
    prodText = '一百';
  }
  return cnNum[i] + cnNum[j] + prodText;
}
// 只读题目（不读答案），用于测试模式
function mulSpeakQuestion(i, j) {
  var cnNum = ['','一','二','三','四','五','六','七','八','九','十'];
  return cnNum[i] + '乘' + cnNum[j] + '等于几';
}

