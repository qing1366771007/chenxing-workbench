+function calcStreak(data) {
+  var streak = 0;
+  var d = new Date();
+  while (true) {
+    var key = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
+    if (data[key] && Object.values(data[key].habits).some(v => v)) {
