  document.getElementById('conjQuizInfo').style.display = mode === 'quiz' ? 'flex' : 'none';
  if (mode === 'quiz') {
    startConjQuiz();
  }
}

function startConjQuiz() {
  // 收集当前分类的连词
  var items = [];
  var showAll = (conjCurrentCat === '全部');
  conjData.forEach(function(item, idx) {
    if (!showAll && item.cat !== conjCurrentCat) return;
    items.push(item);
  });

  // 随机选5道
  var count = Math.min(5, items.length);
  var shuffled = items.slice().sort(function() { return Math.random() - 0.5; });
  var selected = shuffled.slice(0, count);

  conjQuizQuestions = [];
  var allWords = items.map(function(it) { return it.words; });

  selected.forEach(function(item) {
    // 把例句中的连词替换成 ______
    var sentence = item.example;
    var wordsToReplace = item.words;

    // 处理成对连词（如"因为...所以..."）
    var blanks = '';
    var parts = wordsToReplace.split(/…|.../);
    if (parts.length === 2) {
      // 成对的：把两部分都替换
      var part1 = parts[0];
      var part2 = parts[1].replace(/[。，]/g, '');
      sentence = sentence.replace(part1, '______');
      sentence = sentence.replace(part2, '______');
      blanks = wordsToReplace;
    } else {
      // 单个词
      sentence = sentence.replace(item.words, '______');
      blanks = item.words;
    }

    // 选3个干扰项
    var distractors = allWords.filter(function(w) { return w !== item.words; });
    distractors.sort(function() { return Math.random() - 0.5; });
    distractors = distractors.slice(0, 3);

    var options = [item.words].concat(distractors).sort(function() { return Math.random() - 0.5; });

    conjQuizQuestions.push({
      sentence: sentence,
      correct: item.words,
      options: options,
      cat: item.cat
    });
  });

  conjQuizCurrent = 0;
  conjQuizScore = 0;
  document.getElementById('conjQuizScore').textContent = '0';
  document.getElementById('conjQuizTotal').textContent = count;
  renderConjQuiz();
}

