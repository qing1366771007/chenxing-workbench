// 百度翻译TTS语音合成 - 弹出可见播放器
// 百度翻译接口 fanyi.baidu.com/gettts 返回真实MP3音频
function speak(text, lang) {
  if (!text) return;

  // 清理文本
  text = String(text).trim();
  if (!text) return;
  if (text.length > 200) text = text.substring(0, 200);

  // 如果是在 Android App 里，中文用原生语音合成（英语回退到百度TTS，避免缺少英语语音包）
  if (window.AndroidTTS && window.AndroidTTS.speak && !lang.startsWith('en')) {
    try {
      window.AndroidTTS.speak(text, 'zh');
      return;
    } catch(e) {
      console.warn('Android TTS 调用失败，回退到百度TTS:', e);
    }
  }

  var baiduLan = lang.startsWith('en') ? 'en' : 'zh';
  // 全部走服务器代理，绕过百度防盗链
  var url = '/api/tts?lang=' + baiduLan + '&text=' + encodeURIComponent(text) + '&spd=3';

  var player = _getTTSPlayer();
  var bar = _getTTSBar();
  var label = _getTTSLabel();
  if (!player || !bar) return;

  // 显示播放器
  if (label) label.textContent = text.length > 12 ? text.substring(0, 12) + '...' : text;
  bar.classList.add('show');

  // 设置音频源
  player.src = url;
  player.load();

  // 尝试自动播放（部分浏览器允许）
  var playPromise = player.play();
  if (playPromise && playPromise.catch) {
    playPromise.catch(function(e) {
      // 百度TTS自动播放失败，回退到 Web Speech API
      bar.classList.remove('show');
      _speakSynthesis(text, lang);
    });
  }

  // 超时检测：如果5秒后音频仍未播放，回退到 Web Speech API
  if (window._baiduTTSTimer) { clearTimeout(window._baiduTTSTimer); }
  window._baiduTTSTimer = setTimeout(function() {
    var p = _getTTSPlayer();
    if (p && (p.readyState < 2 || p.paused)) {
      bar.classList.remove('show');
      _speakSynthesis(text, lang);
    }
  }, 5000);

  // 音频加载失败时回退
  player.onerror = function() {
    if (window._baiduTTSTimer) { clearTimeout(window._baiduTTSTimer); }
    bar.classList.remove('show');
    _speakSynthesis(text, lang);
  };
}

