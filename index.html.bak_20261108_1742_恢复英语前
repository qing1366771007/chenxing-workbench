    // 显示该列所有口诀（竖排）：mulCol×mulCol 到 mulCol×9
    html += '<div style="display:flex;flex-direction:column;gap:8px;margin-top:12px;max-width:200px;margin-left:auto;margin-right:auto;">';
    for (var r = mulCol; r <= 9; r++) {
