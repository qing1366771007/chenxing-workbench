// ============================================================
// 音效播放（Web Audio API，不依赖网络，所有浏览器兼容）
// ============================================================
let _soundCtx = null;
function _getSoundCtx() {
  if (!_soundCtx) {
    try { _soundCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
  }
  if (_soundCtx && _soundCtx.state === 'suspended') _soundCtx.resume();
  return _soundCtx;
}

// 播放一个音符
function _playNote(freq, duration, type, startTime, volume) {
  var ctx = _getSoundCtx();
  if (!ctx) return;
  var osc = ctx.createOscillator();
  var gain = ctx.createGain();
  osc.type = type || 'sine';
  osc.frequency.value = freq;
  gain.gain.setValueAtTime(0, startTime);
  gain.gain.linearRampToValueAtTime(volume || 0.3, startTime + 0.01);
  gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(startTime);
  osc.stop(startTime + duration);
}

// 答对音效：欢快的上行旋律 do-mi-sol-do
function playCorrectSound() {
  var ctx = _getSoundCtx();
  if (!ctx) return;
  var t = ctx.currentTime;
  // C5 E5 G5 C6 - 欢快上行
  _playNote(523, 0.15, 'sine', t, 0.3);
  _playNote(659, 0.15, 'sine', t + 0.12, 0.3);
  _playNote(784, 0.15, 'sine', t + 0.24, 0.3);
  _playNote(1047, 0.3, 'sine', t + 0.36, 0.35);
}

// 答错音效：低沉短促的提示
function playWrongSound() {
  var ctx = _getSoundCtx();
  if (!ctx) return;
  var t = ctx.currentTime;
  // 两个低音 - 错误提示
  _playNote(330, 0.15, 'square', t, 0.2);
  _playNote(247, 0.3, 'square', t + 0.15, 0.2);
}

