function renderNutrients() {
  var area = document.getElementById('nutritionArea');
  if (!area) return;
  var sections = [
    { title:'🧂 宏量矿物质', data: bodyNutrients.macros },
    { title:'🔬 微量元素', data: bodyNutrients.micros },
    { title:'💜 必需维生素', data: bodyNutrients.vitamins },
  ];
  var h = '';
  sections.forEach(function(s, si) {
    h += '<div class="nut-section-title">' + s.title + '</div><div class="nut-grid">';
    s.data.forEach(function(n, ni) {
      h += '<div class="nut-card" style="cursor:pointer" onclick="speakNutrient(' + si + ',' + ni + ')"><div class="n-i">' + n.i + '</div>' +
        '<div class="n-n">' + n.n + '</div>' +
        '<div class="n-a">' + n.a + '</div>' +
        '<div class="n-f">' + n.f + '</div>' +
        '<div class="n-s">来源：' + n.s + '</div></div>';
    });
    h += '</div>';
  });
  area.innerHTML = h;
}

function speakNutrient(si, ni) {
  var sections = [
    { title:'宏量矿物质', data: bodyNutrients.macros },
    { title:'微量元素', data: bodyNutrients.micros },
    { title:'必需维生素', data: bodyNutrients.vitamins },
  ];
  if (si < 0 || si >= sections.length) return;
  var s = sections[si];
  if (ni < 0 || ni >= s.data.length) return;
  var n = s.data[ni];
  speakZh(n.n + '。' + n.a + '。' + n.f);
}

