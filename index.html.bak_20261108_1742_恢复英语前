function renderEngConv() {
  // 渲染分类栏
  const catBar = document.getElementById('engConvCatBar');
  catBar.innerHTML = '';
  engConversations.forEach(cat => {
    const btn = document.createElement('div');
    btn.className = 'anti-cat-btn' + (engConvCat === cat.cat ? ' active' : '');
    btn.style.cssText = 'padding:6px 12px;border-radius:14px;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;background:#eef5ff;color:#74b9ff;border:1px solid transparent;';
    if (engConvCat === cat.cat) {
      btn.style.background = '#74b9ff';
      btn.style.color = '#fff';
    }
    btn.textContent = cat.icon + ' ' + cat.cat;
    btn.onclick = () => { engConvCat = cat.cat; renderEngConv(); };
    catBar.appendChild(btn);
  });

  // 找到当前分类
  const catData = engConversations.find(c => c.cat === engConvCat);
  if (!catData) return;

  // 渲染场景列表
  const scenesEl = document.getElementById('engConvScenes');
  scenesEl.innerHTML = '';

  catData.scenes.forEach((scene, sIdx) => {
    const card = document.createElement('div');
    card.style.cssText = 'background:#fff;border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,0.06);border:1px solid #e8f0f8;';

    // 标题 + 播放按钮
    const header = document.createElement('div');
    header.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;';
    header.innerHTML = '<div style="font-size:16px;font-weight:700;color:#74b9ff;">🎭 ' + scene.title + '</div>';
    const playAllBtn = document.createElement('button');
    playAllBtn.style.cssText = 'background:#74b9ff;color:#fff;border:none;border-radius:12px;padding:5px 12px;font-size:12px;font-weight:600;cursor:pointer;';
    playAllBtn.textContent = '▶️ 播放全部';
    playAllBtn.onclick = () => playConvAll(scene.lines);
    header.appendChild(playAllBtn);
    card.appendChild(header);

    // 对话行
    scene.lines.forEach((line, lIdx) => {
      const row = document.createElement('div');
      const isLeft = (lIdx % 2 === 0);
      const hideRole = (engConvRole === 'left' && !isLeft) || (engConvRole === 'right' && isLeft);

      row.style.cssText = 'display:flex;' + (isLeft ? 'justify-content:flex-start;' : 'justify-content:flex-end;') + 'margin-bottom:8px;';

      const bubble = document.createElement('div');
      bubble.style.cssText = 'max-width:78%;padding:10px 14px;border-radius:14px;cursor:pointer;transition:all .15s;';
      bubble.style.background = isLeft ? '#eaf4ff' : '#fff5e6';
      bubble.style.border = '1px solid ' + (isLeft ? '#c8e1ff' : '#ffd9a8');

      if (hideRole) {
        // 角色扮演模式：隐藏对应方的英文，显示问号
        bubble.innerHTML = '<div style="font-size:11px;color:#999;margin-bottom:3px;">' + line.role + '</div>' +
          '<div style="font-size:15px;font-weight:600;color:#bbb;text-align:center;">❓ 点击听</div>' +
          '<div style="font-size:12px;color:#999;margin-top:3px;">' + line.zh + '</div>';
        bubble.onclick = () => speakEn(line.en);
      } else {
        bubble.innerHTML = '<div style="font-size:11px;color:#999;margin-bottom:3px;">' + line.role + '</div>' +
          '<div style="font-size:15px;font-weight:600;color:#2d3436;">' + line.en + '</div>' +
          '<div style="font-size:12px;color:#888;margin-top:3px;">' + line.zh + '</div>';
        bubble.onclick = () => speakEnWithZh(line.en, line.zh);
      }

      row.appendChild(bubble);
      card.appendChild(row);
    });

    scenesEl.appendChild(card);
  });
}

function setEngConvRole(role, btn) {
  engConvRole = role;
  document.getElementById('engRoleBoth').classList.remove('active');
  document.getElementById('engRoleA').classList.remove('active');
  document.getElementById('engRoleB').classList.remove('active');
  btn.classList.add('active');
  renderEngConv();
}

let _convPlaying = false;
function playConvAll(lines) {
  if (_convPlaying) {
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    _convPlaying = false;
    return;
  }
  _convPlaying = true;
  let idx = 0;
  function playNext() {
    if (idx >= lines.length) { _convPlaying = false; return; }
    const line = lines[idx];
    if (window.speechSynthesis) {
      const u = new SpeechSynthesisUtterance(line.en);
      u.lang = 'en-US';
      u.rate = 0.9;
      u.onend = function() {
        idx++;
        setTimeout(playNext, 400);
      };
      window.speechSynthesis.speak(u);
    } else {
      idx++;
      playNext();
    }
  }
  playNext();
}

// 播放数字歌
function playEngSong() {
  _engSongPlaying = true;
  var playBtn = document.getElementById('engSongPlayBtn');
  if (playBtn) { playBtn.textContent = '⏹️ 停止播放'; playBtn.classList.add('playing'); }
  var grid = document.getElementById('engSongGrid');
  if (!grid) return;
  var cells = grid.querySelectorAll('.eng-song-num');

  // 先取消可能正在进行的语音
  if (window.speechSynthesis) window.speechSynthesis.cancel();

  var idx = 0;
  function clearHighlight() { cells.forEach(function(c){ c.classList.remove('singing'); }); }

  function finishSong() {
    clearHighlight();
    _engSongPlaying = false;
    if (playBtn) { playBtn.textContent = '▶️ 播放数字歌'; playBtn.classList.remove('playing'); }
  }

  function playNext() {
    if (!_engSongPlaying || idx >= engNumberSong.length) { finishSong(); return; }
    var item = engNumberSong[idx];
    clearHighlight();

    // 用 speechSynthesis 逐个朗读，onstart 时才高亮，onend 串联下一个
    if ('speechSynthesis' in window) {
      var u = new SpeechSynthesisUtterance(item.en);
      u.lang = 'en-US';
      u.rate = 1.0;
      u.pitch = 1.2;
      u.onstart = function() {
        if (_engSongPlaying && cells[idx]) { cells[idx].classList.add('singing'); }
      };
      u.onend = function() {
        if (!_engSongPlaying) return;
        idx++;
        // 短暂停顿后播下一个
        var t = setTimeout(playNext, 200);
        _engSongTimers.push(t);
      };
      u.onerror = function() {
        if (!_engSongPlaying) return;
        idx++;
        var t = setTimeout(playNext, 500);
        _engSongTimers.push(t);
      };
      window.speechSynthesis.speak(u);
      // 安全超时：如果 onend 没触发，2.5秒后强制跳到下一个
      var safety = setTimeout(function() {
        if (idx < engNumberSong.length && _engSongPlaying) {
          idx++;
          playNext();
        }
      }, 2500);
      _engSongTimers.push(safety);
    } else {
      // 不支持 speechSynthesis，用百度TTS
      var url = 'https://fanyi.baidu.com/gettts?lan=en&text=' + encodeURIComponent(item.en) + '&spd=4&source=web';
      var player = _getTTSPlayer();
      var bar = _getTTSBar();
      if (player && bar) {
        bar.classList.add('show');
        player.onended = null;
        player.onerror = null;
        player.onplaying = null;
        player.src = url;
        player.load();
        player.onplaying = function() {
          if (_engSongPlaying && cells[idx]) { cells[idx].classList.add('singing'); }
        };
        player.onended = function() {
          player.onended = null;
          player.onplaying = null;
          idx++;
          var t = setTimeout(playNext, 150);
          _engSongTimers.push(t);
        };
        player.onerror = function() {
          idx++;
          var t = setTimeout(playNext, 500);
          _engSongTimers.push(t);
        };
        player.play().catch(function() {
          idx++;
          var t = setTimeout(playNext, 500);
          _engSongTimers.push(t);
        });
      } else {
        idx++;
        var t = setTimeout(playNext, 800);
        _engSongTimers.push(t);
      }
    }
  }
  playNext();
}

// 停止数字歌
function stopEngSong() {
  _engSongPlaying = false;
  _engSongTimers.forEach(function(t){ clearTimeout(t); });
  _engSongTimers = [];
  if (window.speechSynthesis) window.speechSynthesis.cancel();
  var player = _getTTSPlayer();
  if (player) { player.onended = null; player.onerror = null; player.pause(); }
  var bar = _getTTSBar();
  if (bar) bar.classList.remove('show');
  var playBtn = document.getElementById('engSongPlayBtn');
  if (playBtn) { playBtn.textContent = '▶️ 播放数字歌'; playBtn.classList.remove('playing'); }
  var grid = document.getElementById('engSongGrid');
  if (grid) { grid.querySelectorAll('.eng-song-num').forEach(function(c){ c.classList.remove('singing'); }); }
}

